 717:  ! OFF: brak. ;
 718:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND F[7:TDrogiOK]) ;
 719:  ! F[8] - Odebrano rzeczywiste ;
 720:  ! zatrzymanie zadania ruchowego ;
 721:  ! przez reakcje ;
 722:  ! alarmowa. ON: opisany ;
 723:  ! warunek/zadanie, OFF: brak. ;
 724:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND F[8:TAlarmOdebr]) ;
 725:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND F[403:NativeWazne]) ;
 726:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND F[758:BGswieze]) ;
 727:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND F[745:SesjaWazna]) ;
 728:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND F[572:RxProdZlecON]) ;
 729:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND F[575:RxProdZRobot]) ;
 730:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND (R[65:RxProdProgram]=2)) ;
 731:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND (F[571:RxProdNoweZez] OR F[570:RxProdDo_czZez])) ;
 732:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND F[416:TrybAUTO]) ;
 733:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND !F[419:PendantON]) ;
 734:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND F[420:SystemGotow]) ;
 735:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND !F[421:EStopAkt]) ;
 736:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND !F[422:AlarmRobota]) ;
 737:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND !F[423:SymWejsc]) ;
 738:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND !F[424:SymWyjsc]) ;
 739:  ! F[16] - Zatrzask ;
 740:  ! niespojnego/przerwanego ;
 741:  ! procesu, blokuje ruch do ;
 742:  ! jawnego ;
 743:  ! uzgodnienia. ON: opisany ;
 744:  ! warunek/zadanie, OFF: brak. ;
