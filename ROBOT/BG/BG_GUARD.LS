 565:  IF (F[115:BUzbrojony] AND (((R[245:BAMaskG4] DIV 2) MOD 2)=1) AND !F[588:RxVac2Waz]),F[133:BBladBG]=(ON) ;
 566:  IF (F[115:BUzbrojony] AND (((R[245:BAMaskG4] DIV 4) MOD 2)=1) AND !F[594:RxVac3Waz]),F[133:BBladBG]=(ON) ;
 567:  IF (F[115:BUzbrojony] AND (((R[245:BAMaskG4] DIV 8) MOD 2)=1) AND !F[600:RxVac4Waz]),F[133:BBladBG]=(ON) ;
 568:  IF (F[115:BUzbrojony] AND (((R[245:BAMaskG4] DIV 16) MOD 2)=1) AND !F[606:RxVac5Waz]),F[133:BBladBG]=(ON) ;
 569:  ! R[246] - Aktywna kopia po ;
