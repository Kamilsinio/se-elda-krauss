 950:  ! kasowanie alarmu, sama nie ;
 951:  ! dopuszcza ruchu. ON: opisany ;
 952:  ! warunek/zadanie, OFF: brak. ;
 953:  IF (F[33:TBladBG] AND F[8:TAlarmOdebr] AND !F[422:AlarmRobota] AND !F[3:TZezRecovery]),UALM[1] ;
 954:  JMP LBL[949] ;
 955:  LBL[942] ;
 956:  R[146:CzasGuard_t]=($FAST_CLOCK) ;
 957:  F[757:ProcesDozw]=(OFF) ;
 958:  F[739:ProcesUzbr]=(OFF) ;
