 746:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND !F[759:BlokadaBG]) ;
 747:  ! F[31] - Krok jest w zakresie ;
 748:  ! 200..699, wskaznik trwajacej ;
 749:  ! operacji dla BG. ;
 750:  ! ON: opisany warunek/zadanie, ;
 751:  ! OFF: brak. ;
 752:  ! R[179] - Kontekst TRAY. Krok ;
 753:  ! technologii: 10 gotowosc, ;
 754:  ! 200..299 pusty ;
 755:  ! nosnik, 300..399 IMM, 400..499 ;
 756:  ! produkty, 500..699 pelny ;
 757:  ! ladunek/przekladki, ;
 758:  ! 700 powrot HOME, 710 postoj, ;
 759:  ! 900 recovery. ;
 760:  F[31:TOperacjaTrwa]=((R[179:TKrok]>=200) AND (R[179:TKrok]<700)) ;
 761:  ! F[33] - BG wykryl krytyczne ;
 762:  ! naruszenie dopuszczenia lub ;
 763:  ! spojnosc procesu. ;
 764:  ! ON: opisany warunek/zadanie, ;
 765:  ! OFF: brak. ;
 766:  F[33:TBladBG]=(OFF) ;
 767:  IF (F[408:KonfliktMain]),F[33:TBladBG]=(ON) ;
 768:  ! F[15] - Przyjeto nowy fizyczny ;
 769:  ! Start, Stop rozbraja po ;
 770:  ! rozliczeniu ;
 771:  ! rozpoczetych operacji. ON: ;
 772:  ! opisany warunek/zadanie, OFF: ;
 773:  ! brak. ;
 774:  IF (F[15:TUzbrojony] AND (!F[745:SesjaWazna])),F[33:TBladBG]=(ON) ;
 775:  IF (F[15:TUzbrojony] AND (F[568:RxProdKrytBlok])),F[33:TBladBG]=(ON) ;
 776:  IF (F[15:TUzbrojony] AND (F[573:RxProdRecovery])),F[33:TBladBG]=(ON) ;
 777:  IF (F[15:TUzbrojony] AND (!F[403:NativeWazne])),F[33:TBladBG]=(ON) ;
 778:  IF (F[15:TUzbrojony] AND (F[421:EStopAkt])),F[33:TBladBG]=(ON) ;
 779:  IF (F[15:TUzbrojony] AND (F[422:AlarmRobota])),F[33:TBladBG]=(ON) ;
 780:  IF (F[15:TUzbrojony] AND (F[419:PendantON])),F[33:TBladBG]=(ON) ;
 781:  IF (F[15:TUzbrojony] AND (!F[416:TrybAUTO])),F[33:TBladBG]=(ON) ;
 782:  IF (F[15:TUzbrojony] AND ($FAST_CLOCK-R[129:CzasTeraz_t]>R[138:SVCczasMax_t])),F[33:TBladBG]=(ON) ;
 783:  IF (F[15:TUzbrojony] AND ($FAST_CLOCK-R[142:CzasStatus_t]>R[138:SVCczasMax_t])),F[33:TBladBG]=(ON) ;
 784:  ! F[14] - Main pozostaje ;
 785:  ! wybrany, FALSE konczy petle. ;
 786:  ! Nie jest natywnym ;
 787:  ! statusem pracy. ON: opisany ;
 788:  ! warunek/zadanie, OFF: brak. ;
 789:  IF (F[14:TMainWybrany] AND F[403:NativeWazne] AND !F[426:MainPracuje] AND !F[427:MainPauza]),F[33:TBladBG]=(ON) ;
 790:  IF (F[15:TUzbrojony] AND (!F[575:RxProdZRobot])),F[33:TBladBG]=(ON) ;
 791:  IF (F[15:TUzbrojony] AND (!F[572:RxProdZlecON])),F[33:TBladBG]=(ON) ;
 792:  IF (F[15:TUzbrojony] AND (R[65:RxProdProgram]<>2)),F[33:TBladBG]=(ON) ;
 793:  IF (F[14:TMainWybrany] AND (!F[416:TrybAUTO])),F[33:TBladBG]=(ON) ;
 794:  IF (F[14:TMainWybrany] AND (F[419:PendantON])),F[33:TBladBG]=(ON) ;
 795:  IF (F[14:TMainWybrany] AND (!F[403:NativeWazne])),F[33:TBladBG]=(ON) ;
 796:  IF (F[31:TOperacjaTrwa] AND (F[614:CmdV501Home] OR F[615:CmdV501Work]) AND !F[515:RxV501Waz]),F[33:TBladBG]=(ON) ;
 797:  IF (F[31:TOperacjaTrwa] AND F[512:RxV501WHome] AND F[513:RxV501WWork]),F[33:TBladBG]=(ON) ;
 798:  IF (F[31:TOperacjaTrwa] AND (F[616:CmdV502Home] OR F[617:CmdV502Work]) AND !F[521:RxV502Waz]),F[33:TBladBG]=(ON) ;
 799:  IF (F[31:TOperacjaTrwa] AND F[518:RxV502WHome] AND F[519:RxV502WWork]),F[33:TBladBG]=(ON) ;
 800:  IF (F[31:TOperacjaTrwa] AND (F[618:CmdV503Home] OR F[619:CmdV503Work]) AND !F[527:RxV503Waz]),F[33:TBladBG]=(ON) ;
 801:  IF (F[31:TOperacjaTrwa] AND F[524:RxV503WHome] AND F[525:RxV503WWork]),F[33:TBladBG]=(ON) ;
 802:  IF (F[31:TOperacjaTrwa] AND (F[620:CmdV504Home] OR F[621:CmdV504Work]) AND !F[533:RxV504Waz]),F[33:TBladBG]=(ON) ;
 803:  IF (F[31:TOperacjaTrwa] AND F[530:RxV504WHome] AND F[531:RxV504WWork]),F[33:TBladBG]=(ON) ;
 804:  IF (F[31:TOperacjaTrwa] AND (F[622:CmdV505Home] OR F[623:CmdV505Work]) AND !F[539:RxV505Waz]),F[33:TBladBG]=(ON) ;
 805:  IF (F[31:TOperacjaTrwa] AND F[536:RxV505WHome] AND F[537:RxV505WWork]),F[33:TBladBG]=(ON) ;
 806:  ! F[43] - Roboczy wynik BG: ;
 807:  ! badany obwod nalezy do znanego ;
 808:  ! niesionego ladunku. ;
 809:  ! ON: opisany warunek/zadanie, ;
 810:  ! OFF: brak. ;
 811:  F[43:TPomLadBG]=(F[31:TOperacjaTrwa] AND F[645:CmdProdL_Znany] AND (((R[98:CmdProdMaskLad] DIV 1) MOD 2)=1)) ;
 812:  ! F[44] - Roboczy wynik BG: ;
 813:  ! badany obwod jest celowo ;
 814:  ! zwalniany. ON: opisany ;
 815:  ! warunek/zadanie, OFF: brak. ;
 816:  ! F[41] - Celowe zwalnianie ;
 817:  ! wybranej maski, inne niesione ;
 818:  ! obwody nadal ;
 819:  ! monitorowane. ON: opisany ;
 820:  ! warunek/zadanie, OFF: brak. ;
 821:  ! R[191] - Kontekst TRAY. Maska ;
 822:  ! biezacej operacji, bit 0..4 = ;
 823:  ! obwod prozni ;
 824:  ! 1..5. ;
 825:  F[44:TPomZwolBG]=(F[41:TZwalnianie] AND (((R[191:TMaskaOper] DIV 1) MOD 2)=1)) ;
 826:  IF (F[43:TPomLadBG] AND !F[582:RxVac1Waz]),F[33:TBladBG]=(ON) ;
 827:  IF (F[43:TPomLadBG] AND !F[581:RxVac1OK] AND !F[44:TPomZwolBG]),F[33:TBladBG]=(ON) ;
 828:  F[43:TPomLadBG]=(F[31:TOperacjaTrwa] AND F[645:CmdProdL_Znany] AND (((R[98:CmdProdMaskLad] DIV 2) MOD 2)=1)) ;
 829:  F[44:TPomZwolBG]=(F[41:TZwalnianie] AND (((R[191:TMaskaOper] DIV 2) MOD 2)=1)) ;
 830:  IF (F[43:TPomLadBG] AND !F[588:RxVac2Waz]),F[33:TBladBG]=(ON) ;
 831:  IF (F[43:TPomLadBG] AND !F[587:RxVac2OK] AND !F[44:TPomZwolBG]),F[33:TBladBG]=(ON) ;
 832:  F[43:TPomLadBG]=(F[31:TOperacjaTrwa] AND F[645:CmdProdL_Znany] AND (((R[98:CmdProdMaskLad] DIV 4) MOD 2)=1)) ;
 833:  F[44:TPomZwolBG]=(F[41:TZwalnianie] AND (((R[191:TMaskaOper] DIV 4) MOD 2)=1)) ;
 834:  IF (F[43:TPomLadBG] AND !F[594:RxVac3Waz]),F[33:TBladBG]=(ON) ;
 835:  IF (F[43:TPomLadBG] AND !F[593:RxVac3OK] AND !F[44:TPomZwolBG]),F[33:TBladBG]=(ON) ;
 836:  F[43:TPomLadBG]=(F[31:TOperacjaTrwa] AND F[645:CmdProdL_Znany] AND (((R[98:CmdProdMaskLad] DIV 8) MOD 2)=1)) ;
 837:  F[44:TPomZwolBG]=(F[41:TZwalnianie] AND (((R[191:TMaskaOper] DIV 8) MOD 2)=1)) ;
 838:  IF (F[43:TPomLadBG] AND !F[600:RxVac4Waz]),F[33:TBladBG]=(ON) ;
 839:  IF (F[43:TPomLadBG] AND !F[599:RxVac4OK] AND !F[44:TPomZwolBG]),F[33:TBladBG]=(ON) ;
 840:  F[43:TPomLadBG]=(F[31:TOperacjaTrwa] AND F[645:CmdProdL_Znany] AND (((R[98:CmdProdMaskLad] DIV 16) MOD 2)=1)) ;
 841:  F[44:TPomZwolBG]=(F[41:TZwalnianie] AND (((R[191:TMaskaOper] DIV 16) MOD 2)=1)) ;
 842:  IF (F[43:TPomLadBG] AND !F[606:RxVac5Waz]),F[33:TBladBG]=(ON) ;
 843:  IF (F[43:TPomLadBG] AND !F[605:RxVac5OK] AND !F[44:TPomZwolBG]),F[33:TBladBG]=(ON) ;
 844:  ! R[27] - Aktywna kopia po ;
 845:  ! APPLY, nie edytowac podczas ;
 846:  ! produkcji. Maska grupy ;
 847:  ! 1: bit 0..4 = obwod prozni ;
 848:  ! 1..5. ;
 849:  IF (F[15:TUzbrojony] AND (((R[27:TAMaskG1] DIV 1) MOD 2)=1) AND !F[582:RxVac1Waz]),F[33:TBladBG]=(ON) ;
 850:  IF (F[15:TUzbrojony] AND (((R[27:TAMaskG1] DIV 2) MOD 2)=1) AND !F[588:RxVac2Waz]),F[33:TBladBG]=(ON) ;
 851:  IF (F[15:TUzbrojony] AND (((R[27:TAMaskG1] DIV 4) MOD 2)=1) AND !F[594:RxVac3Waz]),F[33:TBladBG]=(ON) ;
 852:  IF (F[15:TUzbrojony] AND (((R[27:TAMaskG1] DIV 8) MOD 2)=1) AND !F[600:RxVac4Waz]),F[33:TBladBG]=(ON) ;
 853:  IF (F[15:TUzbrojony] AND (((R[27:TAMaskG1] DIV 16) MOD 2)=1) AND !F[606:RxVac5Waz]),F[33:TBladBG]=(ON) ;
 854:  ! R[28] - Aktywna kopia po ;
 855:  ! APPLY, nie edytowac podczas ;
 856:  ! produkcji. Maska grupy ;
 857:  ! 2: bit 0..4 = obwod prozni ;
 858:  ! 1..5. ;
 859:  IF (F[15:TUzbrojony] AND (((R[28:TAMaskG2] DIV 1) MOD 2)=1) AND !F[582:RxVac1Waz]),F[33:TBladBG]=(ON) ;
 860:  IF (F[15:TUzbrojony] AND (((R[28:TAMaskG2] DIV 2) MOD 2)=1) AND !F[588:RxVac2Waz]),F[33:TBladBG]=(ON) ;
 861:  IF (F[15:TUzbrojony] AND (((R[28:TAMaskG2] DIV 4) MOD 2)=1) AND !F[594:RxVac3Waz]),F[33:TBladBG]=(ON) ;
 862:  IF (F[15:TUzbrojony] AND (((R[28:TAMaskG2] DIV 8) MOD 2)=1) AND !F[600:RxVac4Waz]),F[33:TBladBG]=(ON) ;
 863:  IF (F[15:TUzbrojony] AND (((R[28:TAMaskG2] DIV 16) MOD 2)=1) AND !F[606:RxVac5Waz]),F[33:TBladBG]=(ON) ;
 864:  ! R[29] - Aktywna kopia po ;
 865:  ! APPLY, nie edytowac podczas ;
 866:  ! produkcji. Maska grupy ;
 867:  ! 3: bit 0..4 = obwod prozni ;
 868:  ! 1..5. ;
 869:  IF (F[15:TUzbrojony] AND (((R[29:TAMaskG3] DIV 1) MOD 2)=1) AND !F[582:RxVac1Waz]),F[33:TBladBG]=(ON) ;
 870:  IF (F[15:TUzbrojony] AND (((R[29:TAMaskG3] DIV 2) MOD 2)=1) AND !F[588:RxVac2Waz]),F[33:TBladBG]=(ON) ;
 871:  IF (F[15:TUzbrojony] AND (((R[29:TAMaskG3] DIV 4) MOD 2)=1) AND !F[594:RxVac3Waz]),F[33:TBladBG]=(ON) ;
 872:  IF (F[15:TUzbrojony] AND (((R[29:TAMaskG3] DIV 8) MOD 2)=1) AND !F[600:RxVac4Waz]),F[33:TBladBG]=(ON) ;
 873:  IF (F[15:TUzbrojony] AND (((R[29:TAMaskG3] DIV 16) MOD 2)=1) AND !F[606:RxVac5Waz]),F[33:TBladBG]=(ON) ;
 874:  ! R[30] - Aktywna kopia po ;
 875:  ! APPLY, nie edytowac podczas ;
 876:  ! produkcji. Maska grupy ;
 877:  ! 4: bit 0..4 = obwod prozni ;
 878:  ! 1..5. ;
 879:  IF (F[15:TUzbrojony] AND (((R[30:TAMaskG4] DIV 1) MOD 2)=1) AND !F[582:RxVac1Waz]),F[33:TBladBG]=(ON) ;
 880:  IF (F[15:TUzbrojony] AND (((R[30:TAMaskG4] DIV 2) MOD 2)=1) AND !F[588:RxVac2Waz]),F[33:TBladBG]=(ON) ;
 881:  IF (F[15:TUzbrojony] AND (((R[30:TAMaskG4] DIV 4) MOD 2)=1) AND !F[594:RxVac3Waz]),F[33:TBladBG]=(ON) ;
 882:  IF (F[15:TUzbrojony] AND (((R[30:TAMaskG4] DIV 8) MOD 2)=1) AND !F[600:RxVac4Waz]),F[33:TBladBG]=(ON) ;
 883:  IF (F[15:TUzbrojony] AND (((R[30:TAMaskG4] DIV 16) MOD 2)=1) AND !F[606:RxVac5Waz]),F[33:TBladBG]=(ON) ;
 884:  ! R[31] - Aktywna kopia po ;
 885:  ! APPLY, nie edytowac podczas ;
 886:  ! produkcji. Maska grupy ;
 887:  ! 5: bit 0..4 = obwod prozni ;
 888:  ! 1..5. ;
 889:  IF (F[15:TUzbrojony] AND (((R[31:TAMaskG5] DIV 1) MOD 2)=1) AND !F[582:RxVac1Waz]),F[33:TBladBG]=(ON) ;
 890:  IF (F[15:TUzbrojony] AND (((R[31:TAMaskG5] DIV 2) MOD 2)=1) AND !F[588:RxVac2Waz]),F[33:TBladBG]=(ON) ;
 891:  IF (F[15:TUzbrojony] AND (((R[31:TAMaskG5] DIV 4) MOD 2)=1) AND !F[594:RxVac3Waz]),F[33:TBladBG]=(ON) ;
 892:  IF (F[15:TUzbrojony] AND (((R[31:TAMaskG5] DIV 8) MOD 2)=1) AND !F[600:RxVac4Waz]),F[33:TBladBG]=(ON) ;
 893:  IF (F[15:TUzbrojony] AND (((R[31:TAMaskG5] DIV 16) MOD 2)=1) AND !F[606:RxVac5Waz]),F[33:TBladBG]=(ON) ;
 894:  ! R[178] - Aktywna kopia po ;
 895:  ! APPLY, nie edytowac podczas ;
 896:  ! produkcji. Obwody ;
 897:  ! pustej tacki TRAY / przekladki ;
 898:  ! BOX. Bit 0..4 = proznia 1..5, ;
 899:  ! maska rozlaczna ;
 900:  ! z produktami. ;
 901:  IF (F[15:TUzbrojony] AND (((R[178:TAMaskaPusta] DIV 1) MOD 2)=1) AND !F[582:RxVac1Waz]),F[33:TBladBG]=(ON) ;
 902:  IF (F[15:TUzbrojony] AND (((R[178:TAMaskaPusta] DIV 2) MOD 2)=1) AND !F[588:RxVac2Waz]),F[33:TBladBG]=(ON) ;
