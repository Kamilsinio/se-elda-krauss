 636:  IF (F[131:BOperacjaTrwa] AND F[608:CmdWindWejReq] AND F[140:BWWindzie] AND (!F[503:RxWindWaz] OR !F[501:RxWindZez])),F[133:BBladBG]=(ON) ;
 637:  ! R[97] - Lokalne zadanie lub ;
 638:  ! status aplikacji. 0 brak, kod ;
 639:  ! przyczyny, odrebny ;
 640:  ! od miejsca. Kierunek: Robot do ;
 641:  ! PLC. Kody: 1001 nastawy, 1100 ;
 642:  ! blokada, ;
 643:  ! 1101/2101 punkt lub granica, ;
 644:  ! 1102 nieznany krok, 1201 ;
 645:  ! przedmuch, 1301..1303 ;
 646:  ! przypisanie, 1401..1408 ;
 647:  ! recovery, 1501 szukanie, 1502 ;
 648:  ! zastana proznia, 1601 ;
 649:  ! brak miejsca, 1700+krok ;
