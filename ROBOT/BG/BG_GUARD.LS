 690:  ! nie dopuszcza ruchu. ON: ;
 691:  ! opisany warunek/zadanie, OFF: ;
 692:  ! brak. ;
 693:  ! UALM - Alarm procesu UALM[1], ;
 694:  ! reakcja zatrzymania wymaga ;
 695:  ! odbioru. ;
 696:  IF (F[133:BBladBG] AND F[108:BAlarmOdebr] AND !F[422:AlarmRobota] AND !F[103:BZezRecovery]),UALM[1] ;
 697:  JMP LBL[949] ;
 698:  LBL[941] ;
 699:  IF (R[331:WybranyMain]<>2),JMP LBL[942] ;
 700:  R[146:CzasGuard_t]=($FAST_CLOCK) ;
