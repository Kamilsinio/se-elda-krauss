/PROG BG_GUARD
/ATTR
OWNER = MNEDITOR;
COMMENT = "Blokady procesu";
PROTECT = READ_WRITE;
DEFAULT_GROUP = *,*,*,*,*;
CONTROL_CODE = 00000000 00000000;
/MN
   1:  ! Blokady i alarm procesu ;
   2:  ! Robot zada - PLC wykonuje ;
   3:  ! Festo i EUROMAP ;
   4:  ! R[331] - Jedyny pisarz ;
   5:  ! BG_STATUS: 0 brak, 1 MAIN_BOX, ;
   6:  ! 2 MAIN_TRAY. Nie ;
   7:  ! wpisywac recznie. ;
   8:  IF (R[331:WybranyMain]<>1),JMP LBL[941] ;
   9:  ! R[146] - LIVE: czas ostatniego ;
  10:  ! BG_GUARD [ticki]. TEST: 1 ;
  11:  ! PASS, 900 FAIL, 0 ;
  12:  ! niewykonany. ;
  13:  ! $FAST_CLOCK - Odczyt zegara ;
  14:  ! systemowego FANUC [surowe ;
  15:  ! ticki], czestotliwosc ;
  16:  ! i zawijanie do odbioru V9.40. ;
  17:  R[146:CzasGuard_t]=($FAST_CLOCK) ;
  18:  ! F[757] - BG potwierdza blokady ;
  19:  ! procesu, native, profil i ;
  20:  ! zlecenie, OFF ruch ;
  21:  ! i komendy zabronione. ON ;
  22:  ! opisany warunek/zadanie, OFF ;
  23:  ! brak. ;
  24:  ! F[112] - Przyjeto aktywna ;
  25:  ! kopie nastaw, staging nie jest ;
  26:  ! uzywany do ruchu. ;
  27:  ! ON: opisany warunek/zadanie, ;
  28:  ! OFF: brak. ;
  29:  F[757:ProcesDozw]=(F[112:BNastawyOK]) ;
  30:  ! F[106] - Odebrano fizyczny ;
  31:  ! profil chwytaka, maski i cele ;
  32:  ! HOME/WORK. ON: ;
  33:  ! opisany warunek/zadanie, OFF: ;
  34:  ! brak. ;
  35:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND F[106:BProfilOK]) ;
  36:  ! F[107] - Odebrano trajektorie ;
  37:  ! i geometrie tej produkcji na ;
  38:  ! wlasciwym ;
  39:  ! robocie. ON: opisany ;
  40:  ! warunek/zadanie, OFF: brak. ;
  41:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND F[107:BDrogiOK]) ;
  42:  ! F[108] - Odebrano rzeczywiste ;
  43:  ! zatrzymanie zadania ruchowego ;
  44:  ! przez reakcje ;
  45:  ! alarmowa. ON: opisany ;
  46:  ! warunek/zadanie, OFF: brak. ;
  47:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND F[108:BAlarmOdebr]) ;
  48:  ! F[403] - Komplet odebranych ;
  49:  ! native i zweryfikowane zasoby, ;
  50:  ! statusy moga byc ;
  51:  ! publikowane. ON tak/zadanie, ;
  52:  ! OFF nie. ;
  53:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND F[403:NativeWazne]) ;
  54:  ! F[758] - BG_STATUS i BG_GUARD ;
  55:  ! maja aktualne znaczniki czasu. ;
  56:  ! ON opisany ;
  57:  ! warunek/zadanie, OFF brak. ;
  58:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND F[758:BGswieze]) ;
  59:  ! F[745] - Obustronna ;
  60:  ! synchronizacja i gotowosc sa ;
  61:  ! aktualne, OFF brak waznych ;
  62:  ! komend. ON opisany ;
  63:  ! warunek/zadanie, OFF brak. ;
  64:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND F[745:SesjaWazna]) ;
  65:  ! F[572] - Snapshot odebrany ;
  66:  ! przez PLC_RX. 1: zlecenie ;
  67:  ! otwarte, 0: brak ;
  68:  ! aktywnego zlecenia. Kierunek: ;
  69:  ! PLC do robota. ;
  70:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND F[572:RxProdZlecON]) ;
  71:  ! F[575] - Snapshot odebrany ;
  72:  ! przez PLC_RX. 1: wspolpraca ;
  73:  ! wybrana, 0: ;
  74:  ! samodzielny Krauss po ;
  75:  ! wymaganym Stop i HOME. ;
  76:  ! Kierunek: PLC do robota. ;
  77:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND F[575:RxProdZRobot]) ;
  78:  ! R[65] - Snapshot odebrany ;
  79:  ! przez PLC_RX. 0: brak wyboru, ;
  80:  ! 1: Pojemniki, 2: ;
  81:  ! Blistry. Nie wybiera programu ;
  82:  ! na FANUC. Kierunek: PLC do ;
  83:  ! robota. ;
  84:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND (R[65:RxProdProgram]=1)) ;
  85:  ! F[571] - Snapshot odebrany ;
  86:  ! przez PLC_RX. 1: mozna ;
  87:  ! rozpoczac nowa operacje ;
  88:  ! produkcyjna, 0: nie ;
  89:  ! rozpoczynac kolejnej. ;
  90:  ! Kierunek: PLC do robota. ;
  91:  ! F[570] - Snapshot odebrany ;
  92:  ! przez PLC_RX. 1: dozwolone ;
  93:  ! dokonczenie ;
  94:  ! rozliczanych operacji przy ;
  95:  ! spelnionych blokadach, 0: brak ;
  96:  ! pozwolenia. ;
  97:  ! Kierunek: PLC do robota. ;
  98:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND (F[571:RxProdNoweZez] OR F[570:RxProdDo_czZez])) ;
  99:  ! F[416] - Rzeczywisty selektor ;
 100:  ! kontrolera w AUTO. ON tak, OFF ;
 101:  ! nie. Wymaga ;
 102:  ! odbioru V9.40. ;
 103:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND F[416:TrybAUTO]) ;
 104:  ! F[419] - Rzeczywisty wlaczony ;
 105:  ! pendant, blokuje produkcje ;
 106:  ! AUTO. ON tak, OFF ;
 107:  ! nie. Wymaga odbioru V9.40. ;
 108:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND !F[419:PendantON]) ;
 109:  ! F[420] - Gotowosc kontrolera, ;
 110:  ! niezalezna od gotowosci ;
 111:  ! procesu. ON tak, OFF ;
 112:  ! nie. Wymaga odbioru V9.40. ;
 113:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND F[420:SystemGotow]) ;
 114:  ! F[421] - Diagnostyczny E-STOP, ;
 115:  ! nie zastepuje ukladu ;
 116:  ! bezpieczenstwa. ON tak, ;
 117:  ! OFF nie. Wymaga odbioru V9.40. ;
 118:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND !F[421:EStopAkt]) ;
 119:  ! F[422] - Rzeczywisty alarm ;
 120:  ! kontrolera, nie kod bledu ;
 121:  ! technologii. ON tak, ;
 122:  ! OFF nie. Wymaga odbioru V9.40. ;
 123:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND !F[422:AlarmRobota]) ;
 124:  ! F[423] - Aktywna symulacja ;
 125:  ! wejsc na kontrolerze, blokuje ;
 126:  ! produkcje. ON tak, ;
 127:  ! OFF nie. Wymaga odbioru V9.40. ;
 128:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND !F[423:SymWejsc]) ;
 129:  ! F[424] - Aktywna symulacja ;
 130:  ! wyjsc na kontrolerze, blokuje ;
 131:  ! produkcje. ON tak, ;
 132:  ! OFF nie. Wymaga odbioru V9.40. ;
 133:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND !F[424:SymWyjsc]) ;
 134:  ! F[116] - Zatrzask ;
 135:  ! niespojnego/przerwanego ;
 136:  ! procesu, blokuje ruch do ;
 137:  ! jawnego ;
 138:  ! uzgodnienia. ON: opisany ;
 139:  ! warunek/zadanie, OFF: brak. ;
 140:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND !F[116:BUzgodnijStan]) ;
 141:  ! F[759] - Zadano krytyczna ;
 142:  ! blokade i recovery, OFF brak ;
 143:  ! tego zadania. ON ;
 144:  ! opisany warunek/zadanie, OFF ;
 145:  ! brak. ;
 146:  F[757:ProcesDozw]=(F[757:ProcesDozw] AND !F[759:BlokadaBG]) ;
 147:  ! F[131] - Krok jest w zakresie ;
 148:  ! 200..699, wskaznik trwajacej ;
 149:  ! operacji dla BG. ;
 150:  ! ON: opisany warunek/zadanie, ;
 151:  ! OFF: brak. ;
 152:  ! R[283] - Kontekst BOX. Krok ;
 153:  ! technologii: 10 gotowosc, ;
 154:  ! 200..299 pusty nosnik, ;
 155:  ! 300..399 IMM, 400..499 ;
 156:  ! produkty, 500..699 pelny ;
 157:  ! ladunek/przekladki, 700 ;
 158:  ! powrot HOME, 710 postoj, 900 ;
 159:  ! recovery. ;
 160:  F[131:BOperacjaTrwa]=((R[283:BKrok]>=200) AND (R[283:BKrok]<700)) ;
 161:  ! F[133] - BG wykryl krytyczne ;
 162:  ! naruszenie dopuszczenia lub ;
 163:  ! spojnosc procesu. ;
 164:  ! ON: opisany warunek/zadanie, ;
 165:  ! OFF: brak. ;
 166:  F[133:BBladBG]=(OFF) ;
 167:  ! F[119] - TRAY: pusta tacka ;
 168:  ! odlozona. BOX: PLC potwierdzil ;
 169:  ! przygotowany ;
 170:  ! pojemnik. ON: opisany ;
 171:  ! warunek/zadanie, OFF: brak. ;
 172:  ! R[293] - Kontekst BOX. ;
 173:  ! Identyfikator aktualnego stosu ;
 174:  ! TRAY / pojemnika BOX ;
 175:  ! przypisany przez PLC. ;
 176:  ! R[66] - Snapshot odebrany ;
 177:  ! przez PLC_RX. Identyfikator ;
 178:  ! aktualnego ;
 179:  ! stosu/pojemnika nadany przez ;
 180:  ! PLC, nie zmieniac przed ;
 181:  ! zakonczeniem wymian ;
 182:  ! tego stosu. Kierunek: PLC do ;
 183:  ! robota. ;
 184:  IF (F[119:BNosnikGotow] AND (R[283:BKrok]<600) AND (R[293:BNrLadunku]<>R[66:RxProdLad])),F[133:BBladBG]=(ON) ;
 185:  ! F[150] - Robot rozpoczal ;
 186:  ! wejscie w magazyn przekladek i ;
 187:  ! nie potwierdzil ;
 188:  ! wyjazdu. ON: opisany ;
 189:  ! warunek/zadanie, OFF: brak. ;
 190:  ! F[509] - Snapshot odebrany ;
 191:  ! przez PLC_RX. 1: aktualne dane ;
 192:  ! zaleznych ;
 193:  ! urzadzen. Kierunek: PLC do ;
 194:  ! robota. ;
 195:  ! F[507] - Snapshot odebrany ;
 196:  ! przez PLC_RX. 1: przyznany ;
 197:  ! dostep do tego obszaru ;
 198:  ! przy utrzymanym accessReq i ;
 199:  ! blokadach. Kierunek: PLC do ;
 200:  ! robota. ;
 201:  IF (F[150:BWMagazynie] AND (!F[509:RxMagWaz] OR !F[507:RxMagZez])),F[133:BBladBG]=(ON) ;
 202:  ! F[408] - Zatrzask: oba main ;
 203:  ! aktywne/paused albo oba ;
 204:  ! zglosily wybor. ON ;
 205:  ! tak/zadanie, OFF nie. ;
 206:  IF (F[408:KonfliktMain]),F[133:BBladBG]=(ON) ;
 207:  ! F[115] - Przyjeto nowy ;
 208:  ! fizyczny Start, Stop rozbraja ;
 209:  ! po rozliczeniu ;
 210:  ! rozpoczetych operacji. ON: ;
 211:  ! opisany warunek/zadanie, OFF: ;
 212:  ! brak. ;
 213:  IF (F[115:BUzbrojony] AND (!F[745:SesjaWazna])),F[133:BBladBG]=(ON) ;
 214:  ! F[568] - Snapshot odebrany ;
 215:  ! przez PLC_RX. 1: blokada ;
 216:  ! krytyczna, 0: brak ;
 217:  ! zgloszonej blokady. Nie jest ;
 218:  ! sygnalem safety. Kierunek: PLC ;
 219:  ! do robota. ;
 220:  IF (F[115:BUzbrojony] AND (F[568:RxProdKrytBlok])),F[133:BBladBG]=(ON) ;
 221:  ! F[573] - Snapshot odebrany ;
 222:  ! przez PLC_RX. 1: wymagane ;
 223:  ! uzgodnienie stanu, 0: ;
 224:  ! uzgodniony stan. Kierunek: PLC ;
 225:  ! do robota. ;
 226:  IF (F[115:BUzbrojony] AND (F[573:RxProdRecovery])),F[133:BBladBG]=(ON) ;
 227:  IF (F[115:BUzbrojony] AND (!F[403:NativeWazne])),F[133:BBladBG]=(ON) ;
 228:  IF (F[115:BUzbrojony] AND (F[421:EStopAkt])),F[133:BBladBG]=(ON) ;
 229:  IF (F[115:BUzbrojony] AND (F[422:AlarmRobota])),F[133:BBladBG]=(ON) ;
 230:  IF (F[115:BUzbrojony] AND (F[419:PendantON])),F[133:BBladBG]=(ON) ;
 231:  IF (F[115:BUzbrojony] AND (!F[416:TrybAUTO])),F[133:BBladBG]=(ON) ;
 232:  ! R[129] - Biezacy czas ;
 233:  ! watchdogow [surowe ticki], ;
 234:  ! czestotliwosc do pomiaru. ;
 235:  ! R[138] - Limit nieaktualnego ;
 236:  ! serwisu lub BG [ticki]. ;
 237:  IF (F[115:BUzbrojony] AND ($FAST_CLOCK-R[129:CzasTeraz_t]>R[138:SVCczasMax_t])),F[133:BBladBG]=(ON) ;
 238:  ! R[142] - LIVE: czas ostatniego ;
 239:  ! BG_STATUS [ticki]. TEST: ;
 240:  ! syntetyczny zegar ;
 241:  ! testu. ;
 242:  IF (F[115:BUzbrojony] AND ($FAST_CLOCK-R[142:CzasStatus_t]>R[138:SVCczasMax_t])),F[133:BBladBG]=(ON) ;
 243:  ! F[114] - Main pozostaje ;
 244:  ! wybrany, FALSE konczy petle. ;
 245:  ! Nie jest natywnym ;
 246:  ! statusem pracy. ON: opisany ;
 247:  ! warunek/zadanie, OFF: brak. ;
 248:  ! F[426] - Natywna praca main ;
 249:  ! aktualnego wlasciciela, nie ;
 250:  ! PLC_SVC. ON tak, OFF ;
 251:  ! nie. Wymaga odbioru V9.40. ;
 252:  ! F[427] - Natywne PAUSE ;
 253:  ! aktualnego main, nadal zajmuje ;
 254:  ! wybor. ON tak, OFF ;
 255:  ! nie. Wymaga odbioru V9.40. ;
 256:  IF (F[114:BMainWybrany] AND F[403:NativeWazne] AND !F[426:MainPracuje] AND !F[427:MainPauza]),F[133:BBladBG]=(ON) ;
 257:  IF (F[115:BUzbrojony] AND (!F[575:RxProdZRobot])),F[133:BBladBG]=(ON) ;
 258:  IF (F[115:BUzbrojony] AND (!F[572:RxProdZlecON])),F[133:BBladBG]=(ON) ;
 259:  IF (F[115:BUzbrojony] AND (R[65:RxProdProgram]<>1)),F[133:BBladBG]=(ON) ;
 260:  IF (F[114:BMainWybrany] AND (!F[416:TrybAUTO])),F[133:BBladBG]=(ON) ;
 261:  IF (F[114:BMainWybrany] AND (F[419:PendantON])),F[133:BBladBG]=(ON) ;
 262:  IF (F[114:BMainWybrany] AND (!F[403:NativeWazne])),F[133:BBladBG]=(ON) ;
 263:  ! F[614] - Lokalne zadanie lub ;
 264:  ! status aplikacji. 1: zadanie ;
 265:  ! pozycji HOME, 0: ;
 266:  ! brak tego zadania. Para ;
 267:  ! 00=brak nowego ruchu, ;
 268:  ! 11=odrzuc. Kierunek: Robot do ;
 269:  ! PLC. ;
 270:  ! F[615] - Lokalne zadanie lub ;
 271:  ! status aplikacji. 1: zadanie ;
 272:  ! pozycji WORK, 0: ;
 273:  ! brak tego zadania. Para ;
 274:  ! 00=brak nowego ruchu, ;
 275:  ! 11=odrzuc. Kierunek: Robot do ;
 276:  ! PLC. ;
 277:  ! F[515] - Snapshot odebrany ;
 278:  ! przez PLC_RX. 1: aktualne ;
 279:  ! czujniki i diagnostyka, ;
 280:  ! 0: nie uzywac potwierdzen. ;
 281:  ! Kierunek: PLC do robota. ;
 282:  IF (F[131:BOperacjaTrwa] AND (F[614:CmdV501Home] OR F[615:CmdV501Work]) AND !F[515:RxV501Waz]),F[133:BBladBG]=(ON) ;
 283:  ! F[512] - Snapshot odebrany ;
 284:  ! przez PLC_RX. 1: rzeczywiste ;
 285:  ! HOME po filtracji, ;
 286:  ! 0: brak potwierdzenia HOME. ;
 287:  ! Kierunek: PLC do robota. ;
 288:  ! F[513] - Snapshot odebrany ;
 289:  ! przez PLC_RX. 1: rzeczywiste ;
 290:  ! WORK po filtracji, ;
 291:  ! 0: brak potwierdzenia WORK. ;
 292:  ! Kierunek: PLC do robota. ;
 293:  IF (F[131:BOperacjaTrwa] AND F[512:RxV501WHome] AND F[513:RxV501WWork]),F[133:BBladBG]=(ON) ;
 294:  ! F[616] - Lokalne zadanie lub ;
 295:  ! status aplikacji. 1: zadanie ;
 296:  ! pozycji HOME, 0: ;
 297:  ! brak tego zadania. Para ;
 298:  ! 00=brak nowego ruchu, ;
 299:  ! 11=odrzuc. Kierunek: Robot do ;
 300:  ! PLC. ;
 301:  ! F[617] - Lokalne zadanie lub ;
 302:  ! status aplikacji. 1: zadanie ;
 303:  ! pozycji WORK, 0: ;
 304:  ! brak tego zadania. Para ;
 305:  ! 00=brak nowego ruchu, ;
 306:  ! 11=odrzuc. Kierunek: Robot do ;
 307:  ! PLC. ;
 308:  ! F[521] - Snapshot odebrany ;
 309:  ! przez PLC_RX. 1: aktualne ;
 310:  ! czujniki i diagnostyka, ;
 311:  ! 0: nie uzywac potwierdzen. ;
 312:  ! Kierunek: PLC do robota. ;
 313:  IF (F[131:BOperacjaTrwa] AND (F[616:CmdV502Home] OR F[617:CmdV502Work]) AND !F[521:RxV502Waz]),F[133:BBladBG]=(ON) ;
 314:  ! F[518] - Snapshot odebrany ;
 315:  ! przez PLC_RX. 1: rzeczywiste ;
 316:  ! HOME po filtracji, ;
 317:  ! 0: brak potwierdzenia HOME. ;
 318:  ! Kierunek: PLC do robota. ;
 319:  ! F[519] - Snapshot odebrany ;
 320:  ! przez PLC_RX. 1: rzeczywiste ;
 321:  ! WORK po filtracji, ;
 322:  ! 0: brak potwierdzenia WORK. ;
 323:  ! Kierunek: PLC do robota. ;
 324:  IF (F[131:BOperacjaTrwa] AND F[518:RxV502WHome] AND F[519:RxV502WWork]),F[133:BBladBG]=(ON) ;
 325:  ! F[618] - Lokalne zadanie lub ;
 326:  ! status aplikacji. 1: zadanie ;
 327:  ! pozycji HOME, 0: ;
 328:  ! brak tego zadania. Para ;
 329:  ! 00=brak nowego ruchu, ;
 330:  ! 11=odrzuc. Kierunek: Robot do ;
 331:  ! PLC. ;
 332:  ! F[619] - Lokalne zadanie lub ;
 333:  ! status aplikacji. 1: zadanie ;
 334:  ! pozycji WORK, 0: ;
 335:  ! brak tego zadania. Para ;
 336:  ! 00=brak nowego ruchu, ;
 337:  ! 11=odrzuc. Kierunek: Robot do ;
 338:  ! PLC. ;
 339:  ! F[527] - Snapshot odebrany ;
 340:  ! przez PLC_RX. 1: aktualne ;
 341:  ! czujniki i diagnostyka, ;
 342:  ! 0: nie uzywac potwierdzen. ;
 343:  ! Kierunek: PLC do robota. ;
 344:  IF (F[131:BOperacjaTrwa] AND (F[618:CmdV503Home] OR F[619:CmdV503Work]) AND !F[527:RxV503Waz]),F[133:BBladBG]=(ON) ;
 345:  ! F[524] - Snapshot odebrany ;
 346:  ! przez PLC_RX. 1: rzeczywiste ;
 347:  ! HOME po filtracji, ;
 348:  ! 0: brak potwierdzenia HOME. ;
 349:  ! Kierunek: PLC do robota. ;
 350:  ! F[525] - Snapshot odebrany ;
 351:  ! przez PLC_RX. 1: rzeczywiste ;
 352:  ! WORK po filtracji, ;
 353:  ! 0: brak potwierdzenia WORK. ;
 354:  ! Kierunek: PLC do robota. ;
 355:  IF (F[131:BOperacjaTrwa] AND F[524:RxV503WHome] AND F[525:RxV503WWork]),F[133:BBladBG]=(ON) ;
 356:  ! F[620] - Lokalne zadanie lub ;
 357:  ! status aplikacji. 1: zadanie ;
 358:  ! pozycji HOME, 0: ;
 359:  ! brak tego zadania. Para ;
 360:  ! 00=brak nowego ruchu, ;
 361:  ! 11=odrzuc. Kierunek: Robot do ;
 362:  ! PLC. ;
 363:  ! F[621] - Lokalne zadanie lub ;
 364:  ! status aplikacji. 1: zadanie ;
 365:  ! pozycji WORK, 0: ;
 366:  ! brak tego zadania. Para ;
 367:  ! 00=brak nowego ruchu, ;
 368:  ! 11=odrzuc. Kierunek: Robot do ;
 369:  ! PLC. ;
 370:  ! F[533] - Snapshot odebrany ;
 371:  ! przez PLC_RX. 1: aktualne ;
 372:  ! czujniki i diagnostyka, ;
 373:  ! 0: nie uzywac potwierdzen. ;
 374:  ! Kierunek: PLC do robota. ;
 375:  IF (F[131:BOperacjaTrwa] AND (F[620:CmdV504Home] OR F[621:CmdV504Work]) AND !F[533:RxV504Waz]),F[133:BBladBG]=(ON) ;
 376:  ! F[530] - Snapshot odebrany ;
 377:  ! przez PLC_RX. 1: rzeczywiste ;
 378:  ! HOME po filtracji, ;
 379:  ! 0: brak potwierdzenia HOME. ;
 380:  ! Kierunek: PLC do robota. ;
 381:  ! F[531] - Snapshot odebrany ;
 382:  ! przez PLC_RX. 1: rzeczywiste ;
 383:  ! WORK po filtracji, ;
 384:  ! 0: brak potwierdzenia WORK. ;
 385:  ! Kierunek: PLC do robota. ;
 386:  IF (F[131:BOperacjaTrwa] AND F[530:RxV504WHome] AND F[531:RxV504WWork]),F[133:BBladBG]=(ON) ;
 387:  ! F[622] - Lokalne zadanie lub ;
 388:  ! status aplikacji. 1: zadanie ;
 389:  ! pozycji HOME, 0: ;
 390:  ! brak tego zadania. Para ;
 391:  ! 00=brak nowego ruchu, ;
