 590:  IF (F[115:BUzbrojony] AND (((R[267:BAMaskaPusta] DIV 16) MOD 2)=1) AND !F[606:RxVac5Waz]),F[133:BBladBG]=(ON) ;
 591:  ! F[610] - Lokalne zadanie lub ;
 592:  ! status aplikacji. 1: robot ;
 593:  ! zada dostepu, 0: ;
 594:  ! zwalnia zadanie po opuszczeniu ;
 595:  ! obszaru. Kierunek: Robot do ;
