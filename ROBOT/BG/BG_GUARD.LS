 918:  IF (F[33:TBladBG] AND (R[97:CmdProdK_Bledu]=0)),R[97:CmdProdK_Bledu]=(1800) ;
 919:  IF (F[33:TBladBG]),F[16:TUzgodnijStan]=(ON) ;
 920:  IF (F[33:TBladBG]),F[759:BlokadaBG]=(ON) ;
 921:  IF (F[33:TBladBG]),F[757:ProcesDozw]=(OFF) ;
 922:  IF (F[33:TBladBG]),F[739:ProcesUzbr]=(OFF) ;
 923:  IF (F[33:TBladBG]),F[645:CmdProdL_Znany]=(OFF) ;
 924:  ! F[27] - Program potwierdzil ;
 925:  ! wyjazd poza zrodlo tacek, ;
 926:  ! wymaga aktualnego ;
 927:  ! AUTO/statusu. ON: opisany ;
 928:  ! warunek/zadanie, OFF: brak. ;
 929:  IF (F[33:TBladBG]),F[27:TPozaZrodlem]=(OFF) ;
 930:  ! F[28] - Program potwierdzil ;
 931:  ! wyjazd poza winde, przy ;
 932:  ! bledzie uniewazniane. ;
 933:  ! ON: opisany warunek/zadanie, ;
 934:  ! OFF: brak. ;
 935:  IF (F[33:TBladBG]),F[28:TPozaWinda]=(OFF) ;
 936:  ! F[29] - Program potwierdzil ;
 937:  ! wyjazd poza magazyn ;
 938:  ! przekladek, przy bledzie ;
 939:  ! uniewazniane. ON: opisany ;
 940:  ! warunek/zadanie, OFF: brak. ;
 941:  IF (F[33:TBladBG]),F[29:TPozaMagaz]=(OFF) ;
 942:  ! F[30] - Program potwierdzil ;
 943:  ! wyjazd poza IMM, potrzebne do ;
 944:  ! pozwolenia ;
 945:  ! zamkniecia formy. ON: opisany ;
 946:  ! warunek/zadanie, OFF: brak. ;
 947:  IF (F[33:TBladBG]),F[30:TPozaForma]=(OFF) ;
 948:  ! F[3] - Zgoda operatora na ;
