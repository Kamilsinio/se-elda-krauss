 905:  IF (F[15:TUzbrojony] AND (((R[178:TAMaskaPusta] DIV 16) MOD 2)=1) AND !F[606:RxVac5Waz]),F[33:TBladBG]=(ON) ;
 906:  ! F[39] - Robot rozpoczal ;
 907:  ! wejscie w zrodlo tacek i nie ;
