 651:  ! sekwencja. ;
 652:  IF (F[133:BBladBG] AND (R[97:CmdProdK_Bledu]=0)),R[97:CmdProdK_Bledu]=(1800) ;
 653:  IF (F[133:BBladBG]),F[116:BUzgodnijStan]=(ON) ;
 654:  IF (F[133:BBladBG]),F[759:BlokadaBG]=(ON) ;
 655:  IF (F[133:BBladBG]),F[757:ProcesDozw]=(OFF) ;
