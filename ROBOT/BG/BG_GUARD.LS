 587:  IF (F[115:BUzbrojony] AND (((R[267:BAMaskaPusta] DIV 2) MOD 2)=1) AND !F[588:RxVac2Waz]),F[133:BBladBG]=(ON) ;
 588:  IF (F[115:BUzbrojony] AND (((R[267:BAMaskaPusta] DIV 4) MOD 2)=1) AND !F[594:RxVac3Waz]),F[133:BBladBG]=(ON) ;
