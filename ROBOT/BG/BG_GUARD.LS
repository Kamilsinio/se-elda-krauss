 911:  IF (F[31:TOperacjaTrwa] AND F[610:CmdZrodWejReq] AND F[39:TWZrodle] AND (!F[506:RxZrodWaz] OR !F[504:RxZrodZez])),F[33:TBladBG]=(ON) ;
 912:  ! F[40] - Robot rozpoczal ;
 913:  ! wejscie w winde i nie ;
