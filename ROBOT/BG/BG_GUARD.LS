 575:  IF (F[115:BUzbrojony] AND (((R[246:BAMaskG5] DIV 2) MOD 2)=1) AND !F[588:RxVac2Waz]),F[133:BBladBG]=(ON) ;
 576:  IF (F[115:BUzbrojony] AND (((R[246:BAMaskG5] DIV 4) MOD 2)=1) AND !F[594:RxVac3Waz]),F[133:BBladBG]=(ON) ;
 577:  IF (F[115:BUzbrojony] AND (((R[246:BAMaskG5] DIV 8) MOD 2)=1) AND !F[600:RxVac4Waz]),F[133:BBladBG]=(ON) ;
 578:  IF (F[115:BUzbrojony] AND (((R[246:BAMaskG5] DIV 16) MOD 2)=1) AND !F[606:RxVac5Waz]),F[133:BBladBG]=(ON) ;
 579:  ! R[267] - Aktywna kopia po ;
 580:  ! APPLY, nie edytowac podczas ;
 581:  ! produkcji. Obwody ;
 582:  ! pustej tacki TRAY / przekladki ;
