 547:  IF (F[115:BUzbrojony] AND (((R[243:BAMaskG2] DIV 8) MOD 2)=1) AND !F[600:RxVac4Waz]),F[133:BBladBG]=(ON) ;
 548:  IF (F[115:BUzbrojony] AND (((R[243:BAMaskG2] DIV 16) MOD 2)=1) AND !F[606:RxVac5Waz]),F[133:BBladBG]=(ON) ;
