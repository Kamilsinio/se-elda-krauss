 256:  ! F[543] - Snapshot odebrany ;
 257:  ! przez PLC_RX. 1: zdarzenie ;
 258:  ! immPickupCompleted ;
 259:  ! zarejestrowane dokladnie raz w ;
 260:  ! biezacej sesji, 0: kanal wolny ;
 261:  ! po req=0. ;
 262:  ! Kierunek: PLC do robota. ;
 263:  F[409:ZmianaDozw]=(F[409:ZmianaDozw] AND !F[543:RxPobrIMACK]) ;
 264:  ! R[165] - Kanal: odlozenie ;
 265:  ! odrzutow. Stan wymiany: 0 ;
 266:  ! bezczynna, 10 REQ=1 ;
 267:  ! czeka ACK=1, 20 REQ=0 czeka ;
 268:  ! ACK=0. ;
 269:  F[409:ZmianaDozw]=(F[409:ZmianaDozw] AND (R[165:OdrzutyStan]=0)) ;
 270:  ! F[671] - Lokalne zadanie lub ;
 271:  ! status aplikacji. Potwierdzone ;
 272:  ! odlozenie ;
 273:  ! odrzutu do miejsca probek. ;
 274:  ! Osobny kanal i rozliczenie, ;
 275:  ! nie zwieksza dobrych ;
 276:  ! sztuk ani probek. Pelny ;
 277:  ! REQ/ACK. Kierunek: Robot do ;
 278:  ! PLC. ;
 279:  F[409:ZmianaDozw]=(F[409:ZmianaDozw] AND !F[671:CmdOdrzutReq]) ;
