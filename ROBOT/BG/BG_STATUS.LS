 796:  ! PLC. ;
 797:  F[609:CmdWindPoza]=(F[403:NativeWazne] AND (F[425:W_HOME] OR (F[128:BPozaWinda] AND F[146:BDrogaWazna])) AND !F[116:BUzgodnijStan] AND !F[608:CmdWindWejReq]) ;
 798:  ! F[613] - Lokalne zadanie lub ;
 799:  ! status aplikacji. 1: robot ;
 800:  ! faktycznie poza ;
 801:  ! obszarem i nie planuje wejscia ;
 802:  ! bez nowego przyznania, 0: brak ;
 803:  ! zwolnienia. ;
 804:  ! Nie jest safety. Kierunek: ;
 805:  ! Robot do PLC. ;
 806:  ! F[129] - Program potwierdzil ;
 807:  ! wyjazd poza magazyn ;
 808:  ! przekladek, przy bledzie ;
 809:  ! uniewazniane. ON: opisany ;
 810:  ! warunek/zadanie, OFF: brak. ;
 811:  ! F[612] - Lokalne zadanie lub ;
 812:  ! status aplikacji. 1: robot ;
 813:  ! zada dostepu, 0: ;
 814:  ! zwalnia zadanie po opuszczeniu ;
 815:  ! obszaru. Kierunek: Robot do ;
 816:  ! PLC. ;
 817:  F[613:CmdMagPoza]=(F[403:NativeWazne] AND (F[425:W_HOME] OR (F[129:BPozaMagaz] AND F[146:BDrogaWazna])) AND !F[116:BUzgodnijStan] AND !F[612:CmdMagWejReq]) ;
 818:  ! F[108] - Odebrano rzeczywiste ;
 819:  ! zatrzymanie zadania ruchowego ;
 820:  ! przez reakcje ;
 821:  ! alarmowa. ON: opisany ;
 822:  ! warunek/zadanie, OFF: brak. ;
 823:  ! F[103] - Zgoda operatora na ;
 824:  ! uzgodnienie recovery i ;
 825:  ! kasowanie alarmu, sama ;
 826:  ! nie dopuszcza ruchu. ON: ;
 827:  ! opisany warunek/zadanie, OFF: ;
 828:  ! brak. ;
 829:  ! R[146] - LIVE: czas ostatniego ;
 830:  ! BG_GUARD [ticki]. TEST: 1 ;
 831:  ! PASS, 900 FAIL, 0 ;
 832:  ! niewykonany. ;
 833:  ! R[138] - Limit nieaktualnego ;
 834:  ! serwisu lub BG [ticki]. ;
 835:  ! UALM - Alarm procesu UALM[1], ;
 836:  ! reakcja zatrzymania wymaga ;
 837:  ! odbioru. ;
 838:  IF (F[115:BUzbrojony] AND F[108:BAlarmOdebr] AND !F[103:BZezRecovery] AND ($FAST_CLOCK-R[146:CzasGuard_t]>R[138:SVCczasMax_t])),UALM[1] ;
 839:  ! R[129] - Biezacy czas ;
 840:  ! watchdogow [surowe ticki], ;
 841:  ! czestotliwosc do pomiaru. ;
 842:  IF (F[115:BUzbrojony] AND F[108:BAlarmOdebr] AND !F[103:BZezRecovery] AND ($FAST_CLOCK-R[129:CzasTeraz_t]>R[138:SVCczasMax_t])),UALM[1] ;
 843:  JMP LBL[939] ;
 844:  LBL[931] ;
 845:  IF (R[331:WybranyMain]<>2),JMP LBL[932] ;
 846:  R[142:CzasStatus_t]=($FAST_CLOCK) ;
 847:  F[640:CmdProdT_bAUTO]=(F[416:TrybAUTO] AND F[403:NativeWazne]) ;
 848:  F[651:CmdProdTrybT1]=(F[417:TrybT1] AND F[403:NativeWazne]) ;
 849:  F[652:CmdProdTrybT2]=(F[418:TrybT2] AND F[403:NativeWazne]) ;
 850:  F[653:CmdProdP_antON]=(F[419:PendantON] AND F[403:NativeWazne]) ;
 851:  F[650:CmdProdS_Gotow]=(F[420:SystemGotow] AND F[403:NativeWazne]) ;
 852:  F[641:CmdProdE_opAkt]=(F[421:EStopAkt] AND F[403:NativeWazne]) ;
 853:  F[642:CmdProdA_obota]=(F[422:AlarmRobota] AND F[403:NativeWazne]) ;
 854:  F[644:CmdProdS_Wejsc]=(F[423:SymWejsc] AND F[403:NativeWazne]) ;
 855:  F[647:CmdProdS_Wyjsc]=(F[424:SymWyjsc] AND F[403:NativeWazne]) ;
 856:  F[643:CmdProdHome]=(F[425:W_HOME] AND F[403:NativeWazne]) ;
 857:  R[100:CmdProdProgram]=(0) ;
 858:  IF (F[14:TMainWybrany] AND F[403:NativeWazne] AND (F[426:MainPracuje] OR F[427:MainPauza])),R[100:CmdProdProgram]=(2) ;
 859:  F[648:CmdProdPraca]=(F[14:TMainWybrany] AND F[426:MainPracuje] AND !F[427:MainPauza] AND F[403:NativeWazne]) ;
 860:  ! F[16] - Zatrzask ;
 861:  ! niespojnego/przerwanego ;
 862:  ! procesu, blokuje ruch do ;
 863:  ! jawnego ;
 864:  ! uzgodnienia. ON: opisany ;
 865:  ! warunek/zadanie, OFF: brak. ;
 866:  F[642:CmdProdA_obota]=(F[642:CmdProdA_obota] OR F[16:TUzgodnijStan]) ;
 867:  ! F[46] - Natywny main w AUTO ;
 868:  ! bez TP/PAUSE pozwala uzyc ;
 869:  ! potwierdzenia wyjazdu. ;
 870:  ! ON: opisany warunek/zadanie, ;
 871:  ! OFF: brak. ;
 872:  F[46:TDrogaWazna]=(F[14:TMainWybrany] AND F[416:TrybAUTO] AND !F[419:PendantON] AND F[426:MainPracuje] AND !F[427:MainPauza]) ;
 873:  ! F[27] - Program potwierdzil ;
 874:  ! wyjazd poza zrodlo tacek, ;
 875:  ! wymaga aktualnego ;
 876:  ! AUTO/statusu. ON: opisany ;
 877:  ! warunek/zadanie, OFF: brak. ;
 878:  F[611:CmdZrodPoza]=(F[403:NativeWazne] AND (F[425:W_HOME] OR (F[27:TPozaZrodlem] AND F[46:TDrogaWazna])) AND !F[16:TUzgodnijStan] AND !F[610:CmdZrodWejReq]) ;
 879:  ! F[28] - Program potwierdzil ;
 880:  ! wyjazd poza winde, przy ;
 881:  ! bledzie uniewazniane. ;
 882:  ! ON: opisany warunek/zadanie, ;
 883:  ! OFF: brak. ;
 884:  F[609:CmdWindPoza]=(F[403:NativeWazne] AND (F[425:W_HOME] OR (F[28:TPozaWinda] AND F[46:TDrogaWazna])) AND !F[16:TUzgodnijStan] AND !F[608:CmdWindWejReq]) ;
 885:  ! F[29] - Program potwierdzil ;
 886:  ! wyjazd poza magazyn ;
 887:  ! przekladek, przy bledzie ;
 888:  ! uniewazniane. ON: opisany ;
 889:  ! warunek/zadanie, OFF: brak. ;
 890:  F[613:CmdMagPoza]=(F[403:NativeWazne] AND (F[425:W_HOME] OR (F[29:TPozaMagaz] AND F[46:TDrogaWazna])) AND !F[16:TUzgodnijStan] AND !F[612:CmdMagWejReq]) ;
 891:  ! F[8] - Odebrano rzeczywiste ;
 892:  ! zatrzymanie zadania ruchowego ;
 893:  ! przez reakcje ;
 894:  ! alarmowa. ON: opisany ;
 895:  ! warunek/zadanie, OFF: brak. ;
 896:  ! F[3] - Zgoda operatora na ;
 897:  ! uzgodnienie recovery i ;
 898:  ! kasowanie alarmu, sama nie ;
 899:  ! dopuszcza ruchu. ON: opisany ;
 900:  ! warunek/zadanie, OFF: brak. ;
 901:  IF (F[15:TUzbrojony] AND F[8:TAlarmOdebr] AND !F[3:TZezRecovery] AND ($FAST_CLOCK-R[146:CzasGuard_t]>R[138:SVCczasMax_t])),UALM[1] ;
 902:  IF (F[15:TUzbrojony] AND F[8:TAlarmOdebr] AND !F[3:TZezRecovery] AND ($FAST_CLOCK-R[129:CzasTeraz_t]>R[138:SVCczasMax_t])),UALM[1] ;
 903:  JMP LBL[939] ;
 904:  LBL[932] ;
 905:  R[142:CzasStatus_t]=($FAST_CLOCK) ;
 906:  R[100:CmdProdProgram]=(0) ;
 907:  F[648:CmdProdPraca]=(OFF) ;
 908:  F[640:CmdProdT_bAUTO]=(F[416:TrybAUTO] AND F[403:NativeWazne]) ;
 909:  F[651:CmdProdTrybT1]=(F[417:TrybT1] AND F[403:NativeWazne]) ;
 910:  F[652:CmdProdTrybT2]=(F[418:TrybT2] AND F[403:NativeWazne]) ;
 911:  F[653:CmdProdP_antON]=(F[419:PendantON] AND F[403:NativeWazne]) ;
 912:  F[650:CmdProdS_Gotow]=(F[420:SystemGotow] AND F[403:NativeWazne]) ;
 913:  F[641:CmdProdE_opAkt]=(F[421:EStopAkt] AND F[403:NativeWazne]) ;
 914:  F[642:CmdProdA_obota]=(F[422:AlarmRobota] AND F[403:NativeWazne]) ;
 915:  F[644:CmdProdS_Wejsc]=(F[423:SymWejsc] AND F[403:NativeWazne]) ;
 916:  F[647:CmdProdS_Wyjsc]=(F[424:SymWyjsc] AND F[403:NativeWazne]) ;
 917:  F[643:CmdProdHome]=(F[425:W_HOME] AND F[403:NativeWazne]) ;
 918:  F[611:CmdZrodPoza]=(F[403:NativeWazne] AND F[425:W_HOME] AND !F[610:CmdZrodWejReq]) ;
 919:  F[609:CmdWindPoza]=(F[403:NativeWazne] AND F[425:W_HOME] AND !F[608:CmdWindWejReq]) ;
 920:  F[613:CmdMagPoza]=(F[403:NativeWazne] AND F[425:W_HOME] AND !F[612:CmdMagWejReq]) ;
 921:  LBL[939] ;
 922:  ! F[759] - Zadano krytyczna ;
 923:  ! blokade i recovery, OFF brak ;
 924:  ! tego zadania. ON ;
 925:  ! opisany warunek/zadanie, OFF ;
 926:  ! brak. ;
 927:  IF (F[408:KonfliktMain]),F[759:BlokadaBG]=(ON) ;
 928:  IF (F[408:KonfliktMain]),F[739:ProcesUzbr]=(OFF) ;
 929:  IF (F[408:KonfliktMain]),F[757:ProcesDozw]=(OFF) ;
/POS
/END
