 216:  ! biezacej sesji, 0: kanal wolny ;
 217:  ! po req=0. ;
 218:  ! Kierunek: PLC do robota. ;
 219:  F[409:ZmianaDozw]=(F[409:ZmianaDozw] AND !F[544:RxWarstwACK]) ;
 220:  ! R[161] - Kanal: ukonczenie ;
 221:  ! stosu lub pojemnika. Stan ;
 222:  ! wymiany: 0 bezczynna, ;
 223:  ! 10 REQ=1 czeka ACK=1, 20 REQ=0 ;
 224:  ! czeka ACK=0. ;
 225:  F[409:ZmianaDozw]=(F[409:ZmianaDozw] AND (R[161:PelLadStan]=0)) ;
