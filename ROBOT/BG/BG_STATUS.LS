 179:  ! bezczynna, 10 REQ=1 czeka ;
 180:  ! ACK=1, 20 REQ=0 czeka ACK=0. ;
 181:  F[409:ZmianaDozw]=(F[409:ZmianaDozw] AND (R[157:ProbkiStan]=0)) ;
