/PROG BG_STATUS
/ATTR
OWNER = MNEDITOR;
COMMENT = "Status i wybor";
PROTECT = READ_WRITE;
DEFAULT_GROUP = *,*,*,*,*;
CONTROL_CODE = 00000000 00000000;
/MN
   1:  ! Native i wybor main ;
   2:  ! Robot zada - PLC wykonuje ;
   3:  ! Festo i EUROMAP ;
   4:  ! F[403] - Komplet odebranych ;
   5:  ! native i zweryfikowane zasoby, ;
   6:  ! statusy moga byc ;
   7:  ! publikowane. ON tak/zadanie, ;
   8:  ! OFF nie. ;
   9:  ! F[401] - BG_BIND ma ;
  10:  ! zdefiniowane wszystkie 14 ;
  11:  ! natywnych zrodel, nie dowod ;
  12:  ! odbioru. ON tak/zadanie, OFF ;
  13:  ! nie. ;
  14:  ! F[402] - Na V9.40 odebrano ;
  15:  ! znaczenie i aktualnosc ;
  16:  ! wszystkich zrodel native. ;
  17:  ! ON tak/zadanie, OFF nie. ;
  18:  ! F[404] - Sprawdzono R1..400, ;
  19:  ! wymagane F/PR i brak kolizji, ;
  20:  ! domyslnie OFF. ON ;
  21:  ! tak/zadanie, OFF nie. ;
  22:  F[403:NativeWazne]=(F[401:NativeKompl] AND F[402:NativeOdebr] AND F[404:PamiecOdebr]) ;
  23:  ! F[409] - BG potwierdzil ;
  24:  ! zamkniete zlecenie, HOME i ;
  25:  ! rozliczone ;
  26:  ! kanaly/wtryski, roboczy ;
  27:  ! warunek przekazania wyboru. ON ;
  28:  ! tak/zadanie, OFF nie. ;
  29:  ! F[572] - Snapshot odebrany ;
  30:  ! przez PLC_RX. 1: zlecenie ;
  31:  ! otwarte, 0: brak ;
  32:  ! aktywnego zlecenia. Kierunek: ;
  33:  ! PLC do robota. ;
  34:  ! F[425] - Aktualna odebrana ;
  35:  ! Reference Position grupy 1, ;
  36:  ! nie flaga ostatniego ;
  37:  ! ruchu. ON tak, OFF nie. Wymaga ;
  38:  ! odbioru V9.40. ;
  39:  F[409:ZmianaDozw]=(!F[572:RxProdZlecON] AND F[403:NativeWazne] AND F[425:W_HOME]) ;
  40:  ! F[553] - Snapshot odebrany ;
  41:  ! przez PLC_RX. 1: model ;
  42:  ! rozpoczetych wtryskow ;
  43:  ! uzgodniony, 0: stan nieznany, ;
  44:  ! blokada nowych cykli. ;
  45:  ! Kierunek: PLC do robota. ;
  46:  F[409:ZmianaDozw]=(F[409:ZmianaDozw] AND F[553:RxIMMCyklZnany]) ;
  47:  ! F[562] - Snapshot odebrany ;
  48:  ! przez PLC_RX. 1: rozliczone ;
  49:  ! rozpoczete wtryski i ;
  50:  ! wymagane operacje maszyny. ;
  51:  ! Kierunek: PLC do robota. ;
  52:  F[409:ZmianaDozw]=(F[409:ZmianaDozw] AND F[562:RxIMMRozlicz]) ;
  53:  ! R[63] - Snapshot odebrany ;
  54:  ! przez PLC_RX. Liczba ;
  55:  ! rozpoczetych wtryskow, ;
  56:  ! ktorych robot jeszcze nie ;
  57:  ! rozliczyl, prowadzi PLC. ;
  58:  ! Kierunek: PLC do robota. ;
  59:  F[409:ZmianaDozw]=(F[409:ZmianaDozw] AND (R[63:RxIMMNie_zlicz]=0)) ;
  60:  ! F[560] - Snapshot odebrany ;
  61:  ! przez PLC_RX. 1: cycleId ;
  62:  ! przydzielono do nowego ;
  63:  ! pobrania i jeszcze go nie ;
  64:  ! potwierdzono przez ;
  65:  ! immPickupCompleted, 0: nie ;
  66:  ! rozpoczynac ponownego pobrania ;
  67:  ! tego identyfikatora. Kierunek: ;
  68:  ! PLC do robota. ;
  69:  F[409:ZmianaDozw]=(F[409:ZmianaDozw] AND !F[560:RxIMMDoPobr]) ;
  70:  ! R[147] - Kanal: pobranie ;
  71:  ! pustej tacki. Stan wymiany: 0 ;
  72:  ! bezczynna, 10 REQ=1 ;
  73:  ! czeka ACK=1, 20 REQ=0 czeka ;
  74:  ! ACK=0. ;
  75:  F[409:ZmianaDozw]=(F[409:ZmianaDozw] AND (R[147:PobrTackStan]=0)) ;
  76:  ! F[625] - Lokalne zadanie lub ;
  77:  ! status aplikacji. 1: nowe ;
  78:  ! zdarzenie ;
  79:  ! blisterPicked, utrzymac do ;
  80:  ! ACK, nastepne po pelnym ;
  81:  ! wyzerowaniu kanalu. ;
  82:  ! Kierunek: Robot do PLC. ;
  83:  F[409:ZmianaDozw]=(F[409:ZmianaDozw] AND !F[625:CmdPobrTaReq]) ;
  84:  ! F[541] - Snapshot odebrany ;
  85:  ! przez PLC_RX. 1: zdarzenie ;
  86:  ! blisterPicked ;
  87:  ! zarejestrowane dokladnie raz w ;
  88:  ! biezacej sesji, 0: kanal wolny ;
  89:  ! po req=0. ;
  90:  ! Kierunek: PLC do robota. ;
  91:  F[409:ZmianaDozw]=(F[409:ZmianaDozw] AND !F[541:RxPobrTaACK]) ;
  92:  ! R[149] - Kanal: odlozenie ;
  93:  ! pustej tacki. Stan wymiany: 0 ;
  94:  ! bezczynna, 10 REQ=1 ;
  95:  ! czeka ACK=1, 20 REQ=0 czeka ;
  96:  ! ACK=0. ;
  97:  F[409:ZmianaDozw]=(F[409:ZmianaDozw] AND (R[149:OdlTackStan]=0)) ;
  98:  ! F[626] - Lokalne zadanie lub ;
  99:  ! status aplikacji. 1: nowe ;
 100:  ! zdarzenie ;
 101:  ! blisterPlaced, utrzymac do ;
 102:  ! ACK, nastepne po pelnym ;
 103:  ! wyzerowaniu kanalu. ;
 104:  ! Kierunek: Robot do PLC. ;
 105:  F[409:ZmianaDozw]=(F[409:ZmianaDozw] AND !F[626:CmdOdlTacReq]) ;
 106:  ! F[542] - Snapshot odebrany ;
 107:  ! przez PLC_RX. 1: zdarzenie ;
 108:  ! blisterPlaced ;
 109:  ! zarejestrowane dokladnie raz w ;
 110:  ! biezacej sesji, 0: kanal wolny ;
 111:  ! po req=0. ;
 112:  ! Kierunek: PLC do robota. ;
 113:  F[409:ZmianaDozw]=(F[409:ZmianaDozw] AND !F[542:RxOdlTacACK]) ;
 114:  ! R[151] - Kanal: napelnienie ;
 115:  ! pojedynczej tacki. Stan ;
 116:  ! wymiany: 0 bezczynna, 10 ;
 117:  ! REQ=1 czeka ACK=1, 20 REQ=0 ;
 118:  ! czeka ACK=0. ;
 119:  F[409:ZmianaDozw]=(F[409:ZmianaDozw] AND (R[151:PelTackStan]=0)) ;
 120:  ! F[624] - Lokalne zadanie lub ;
 121:  ! status aplikacji. 1: ;
 122:  ! pojedynczy blister ;
 123:  ! napelniony, nie oznacza ;
 124:  ! ukonczenia stosu. Kierunek: ;
 125:  ! Robot do PLC. ;
 126:  F[409:ZmianaDozw]=(F[409:ZmianaDozw] AND !F[624:CmdPelTacReq]) ;
 127:  ! F[540] - Snapshot odebrany ;
 128:  ! przez PLC_RX. 1: ukonczenie ;
 129:  ! pojedynczego blistra ;
 130:  ! zarejestrowane raz. Kierunek: ;
 131:  ! PLC do robota. ;
 132:  F[409:ZmianaDozw]=(F[409:ZmianaDozw] AND !F[540:RxPelTacACK]) ;
 133:  ! R[153] - Kanal: odlozenie ;
 134:  ! przekladki. Stan wymiany: 0 ;
 135:  ! bezczynna, 10 REQ=1 ;
 136:  ! czeka ACK=1, 20 REQ=0 czeka ;
 137:  ! ACK=0. ;
 138:  F[409:ZmianaDozw]=(F[409:ZmianaDozw] AND (R[153:PrzeklStan]=0)) ;
 139:  ! F[631] - Lokalne zadanie lub ;
 140:  ! status aplikacji. 1: nowe ;
 141:  ! zdarzenie ;
 142:  ! spacerPlaced, utrzymac do ACK, ;
 143:  ! nastepne po pelnym wyzerowaniu ;
 144:  ! kanalu. ;
 145:  ! Kierunek: Robot do PLC. ;
 146:  F[409:ZmianaDozw]=(F[409:ZmianaDozw] AND !F[631:CmdPrzeklReq]) ;
 147:  ! F[547] - Snapshot odebrany ;
 148:  ! przez PLC_RX. 1: zdarzenie ;
 149:  ! spacerPlaced ;
 150:  ! zarejestrowane dokladnie raz w ;
 151:  ! biezacej sesji, 0: kanal wolny ;
 152:  ! po req=0. ;
 153:  ! Kierunek: PLC do robota. ;
 154:  F[409:ZmianaDozw]=(F[409:ZmianaDozw] AND !F[547:RxPrzeklACK]) ;
 155:  ! R[155] - Kanal: odlozenie ;
 156:  ! dobrych detali. Stan wymiany: ;
 157:  ! 0 bezczynna, 10 ;
 158:  ! REQ=1 czeka ACK=1, 20 REQ=0 ;
 159:  ! czeka ACK=0. ;
 160:  F[409:ZmianaDozw]=(F[409:ZmianaDozw] AND (R[155:DobreStan]=0)) ;
