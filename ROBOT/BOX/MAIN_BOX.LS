/PROG MAIN_BOX
/ATTR
OWNER = MNEDITOR;
COMMENT = "Produkcja BOX";
PROTECT = READ_WRITE;
DEFAULT_GROUP = 1,*,*,*,*;
CONTROL_CODE = 00000000 00000000;
/MN
   1:  ! Produkcja kuwet i pojemnikow ;
   2:  ! Robot zada - PLC wykonuje ;
   3:  ! Festo i EUROMAP ;
   4:  ! Komendy operatora: INIT APPLY ;
   5:  ! NEW RECOVERY EXIT ;
   6:  ! Nastawy S edytowane, A aktywne ;
   7:  ! po APPLY ;
   8:  ! Caly proces, ruchy i ;
   9:  ! rozliczenia sa ponizej ;
  10:  ! Pelna technologia w tym ;
  11:  ! programie ;
  12:  ! PLC wykonuje pneumatyke oraz ;
  13:  ! EUROMAP 67 ;
  14:  ! Start lokalny na robocie, ;
  15:  ! potem nowy Start PLC ;
  16:  ! Stop konczy rozpoczete ;
  17:  ! operacje oraz N+1 ;
  18:  ! Blad wymaga uzgodnienia stanu ;
  19:  ! i nowego Startu ;
  20:  ! Inicjalizacja wyboru programu ;
  21:  ! Przyjecie lokalnego wyboru ;
  22:  ! main i bazowego tokenu Start ;
  23:  CALL BG_BIND ;
  24:  ! F[114] - Main pozostaje ;
  25:  ! wybrany, FALSE konczy petle. ;
  26:  ! Nie jest natywnym ;
  27:  ! statusem pracy. ON: opisany ;
  28:  ! warunek/zadanie, OFF: brak. ;
  29:  F[114:BMainWybrany]=(ON) ;
  30:  ! F[115] - Przyjeto nowy ;
  31:  ! fizyczny Start, Stop rozbraja ;
  32:  ! po rozliczeniu ;
  33:  ! rozpoczetych operacji. ON: ;
  34:  ! opisany warunek/zadanie, OFF: ;
  35:  ! brak. ;
  36:  F[115:BUzbrojony]=(OFF) ;
  37:  ! F[138] - Po przyznaniu wyboru ;
  38:  ! main sprawdzil wejscie i ;
  39:  ! zapamietal zastany ;
  40:  ! token Start. ON: opisany ;
  41:  ! warunek/zadanie, OFF: brak. ;
  42:  F[138:BStartObsluz]=(OFF) ;
  43:  ! F[412] - MAIN_BOX zada ;
  44:  ! lokalnego wyboru, nie wybor ;
  45:  ! programu przez PLC. ON ;
  46:  ! tak/zadanie, OFF nie. ;
  47:  F[412:WyborBOX]=(ON) ;
  48:  LBL[1] ;
  49:  ! Obsluga operatora przy postoju ;
  50:  ! R[331] - Jedyny pisarz ;
  51:  ! BG_STATUS: 0 brak, 1 MAIN_BOX, ;
  52:  ! 2 MAIN_TRAY. Nie ;
  53:  ! wpisywac recznie. ;
  54:  IF ((R[331:WybranyMain]<>1) AND !F[412:WyborBOX]),F[114:BMainWybrany]=(OFF) ;
  55:  IF (R[331:WybranyMain]<>1),JMP LBL[2] ;
  56:  ! F[101] - Jawne zadanie ;
  57:  ! wyzerowania prywatnej ;
  58:  ! konfiguracji/kontekstu przy ;
  59:  ! potwierdzonym pustym postoju. ;
  60:  ! ON: opisany warunek/zadanie, ;
  61:  ! OFF: brak. ;
  62:  IF (!F[101:BZezInit]),JMP LBL[1001] ;
  63:  ! F[409] - BG potwierdzil ;
  64:  ! zamkniete zlecenie, HOME i ;
  65:  ! rozliczone ;
  66:  ! kanaly/wtryski, roboczy ;
  67:  ! warunek przekazania wyboru. ON ;
  68:  ! tak/zadanie, OFF nie. ;
  69:  ! F[408] - Zatrzask: oba main ;
  70:  ! aktywne/paused albo oba ;
  71:  ! zglosily wybor. ON ;
  72:  ! tak/zadanie, OFF nie. ;
  73:  IF (!F[409:ZmianaDozw] OR F[408:KonfliktMain]),JMP LBL[1001] ;
  74:  ! F[105] - Operator potwierdzil ;
  75:  ! pusty postoj dla ;
  76:  ! INIT/APPLY/zmiany programu, ;
  77:  ! nie automatyczny czujnik. ON: ;
  78:  ! opisany warunek/zadanie, OFF: ;
  79:  ! brak. ;
  80:  IF (F[115:BUzbrojony] OR !F[105:BStacjaPusta]),JMP LBL[1001] ;
  81:  ! F[117] - Zachowano cycleId, ;
  82:  ! ilosc i przeznaczenie partii, ;
  83:  ! nie przypisywac ;
  84:  ! ponownie. ON: opisany ;
  85:  ! warunek/zadanie, OFF: brak. ;
  86:  ! R[289] - Kontekst BOX. ;
  87:  ! Pozostala do potwierdzonego ;
  88:  ! rozliczenia ilosc partii ;
  89:  ! [szt.], maleje po pelnym ;
  90:  ! ACK=0. ;
  91:  IF (F[117:BPartiaPrzyp] OR (R[289:BPozostalo]<>0)),JMP LBL[1001] ;
  92:  ! Jawna inicjalizacja prywatnych ;
  93:  ! danych przy pustym postoju ;
  94:  ! R[201] - Nastawa edytowana, ;
  95:  ! wymaga APPLY przy zamknietym ;
  96:  ! zleceniu i pustej ;
  97:  ! stacji. Maska grupy 1: bit ;
  98:  ! 0..4 = obwod prozni 1..5. ;
  99:  R[201:BSMaskG1]=(0) ;
 100:  ! R[202] - Nastawa edytowana, ;
 101:  ! wymaga APPLY przy zamknietym ;
 102:  ! zleceniu i pustej ;
 103:  ! stacji. Maska grupy 2: bit ;
 104:  ! 0..4 = obwod prozni 1..5. ;
 105:  R[202:BSMaskG2]=(0) ;
 106:  ! R[203] - Nastawa edytowana, ;
 107:  ! wymaga APPLY przy zamknietym ;
 108:  ! zleceniu i pustej ;
 109:  ! stacji. Maska grupy 3: bit ;
 110:  ! 0..4 = obwod prozni 1..5. ;
 111:  R[203:BSMaskG3]=(0) ;
 112:  ! R[204] - Nastawa edytowana, ;
 113:  ! wymaga APPLY przy zamknietym ;
 114:  ! zleceniu i pustej ;
 115:  ! stacji. Maska grupy 4: bit ;
 116:  ! 0..4 = obwod prozni 1..5. ;
 117:  R[204:BSMaskG4]=(0) ;
 118:  ! R[205] - Nastawa edytowana, ;
 119:  ! wymaga APPLY przy zamknietym ;
 120:  ! zleceniu i pustej ;
 121:  ! stacji. Maska grupy 5: bit ;
 122:  ! 0..4 = obwod prozni 1..5. ;
 123:  R[205:BSMaskG5]=(0) ;
 124:  ! R[206] - Nastawa edytowana, ;
 125:  ! wymaga APPLY przy zamknietym ;
 126:  ! zleceniu i pustej ;
 127:  ! stacji. Liczba detali grupy 1 ;
 128:  ! [szt.], niezalezna od ssawek i ;
 129:  ! obwodow. ;
 130:  R[206:BSSztG1]=(0) ;
 131:  ! R[207] - Nastawa edytowana, ;
 132:  ! wymaga APPLY przy zamknietym ;
 133:  ! zleceniu i pustej ;
 134:  ! stacji. Liczba detali grupy 2 ;
 135:  ! [szt.], niezalezna od ssawek i ;
 136:  ! obwodow. ;
 137:  R[207:BSSztG2]=(0) ;
 138:  ! R[208] - Nastawa edytowana, ;
 139:  ! wymaga APPLY przy zamknietym ;
 140:  ! zleceniu i pustej ;
 141:  ! stacji. Liczba detali grupy 3 ;
 142:  ! [szt.], niezalezna od ssawek i ;
 143:  ! obwodow. ;
 144:  R[208:BSSztG3]=(0) ;
 145:  ! R[209] - Nastawa edytowana, ;
 146:  ! wymaga APPLY przy zamknietym ;
 147:  ! zleceniu i pustej ;
 148:  ! stacji. Liczba detali grupy 4 ;
 149:  ! [szt.], niezalezna od ssawek i ;
 150:  ! obwodow. ;
 151:  R[209:BSSztG4]=(0) ;
 152:  ! R[210] - Nastawa edytowana, ;
 153:  ! wymaga APPLY przy zamknietym ;
 154:  ! zleceniu i pustej ;
 155:  ! stacji. Liczba detali grupy 5 ;
 156:  ! [szt.], niezalezna od ssawek i ;
 157:  ! obwodow. ;
 158:  R[210:BSSztG5]=(0) ;
 159:  ! R[211] - Nastawa edytowana, ;
 160:  ! wymaga APPLY przy zamknietym ;
 161:  ! zleceniu i pustej ;
 162:  ! stacji. Liczba pozycji osi X, ;
 163:  ! dodatnia liczba calkowita. ;
 164:  ! P2/P3: obie osie 0 ;
 165:  ! wylaczaja sekcje. ;
 166:  R[211:BSSiatkaX]=(0) ;
 167:  ! R[212] - Nastawa edytowana, ;
 168:  ! wymaga APPLY przy zamknietym ;
 169:  ! zleceniu i pustej ;
 170:  ! stacji. Liczba pozycji osi Y, ;
 171:  ! dodatnia liczba calkowita. ;
 172:  ! P2/P3: obie osie 0 ;
 173:  ! wylaczaja sekcje. ;
 174:  R[212:BSSiatkaY]=(0) ;
 175:  ! R[213] - Nastawa edytowana, ;
 176:  ! wymaga APPLY przy zamknietym ;
 177:  ! zleceniu i pustej ;
 178:  ! stacji. Skok pozycji po X ;
 179:  ! UFRAME [mm], moze byc ujemny. ;
 180:  R[213:BSSkokX_mm]=(0) ;
 181:  ! R[214] - Nastawa edytowana, ;
 182:  ! wymaga APPLY przy zamknietym ;
 183:  ! zleceniu i pustej ;
 184:  ! stacji. Skok rzedow po Y ;
 185:  ! UFRAME [mm], moze byc ujemny. ;
 186:  R[214:BSSkokY_mm]=(0) ;
 187:  ! R[215] - Nastawa edytowana, ;
 188:  ! wymaga APPLY przy zamknietym ;
 189:  ! zleceniu i pustej ;
 190:  ! stacji. TRAY: wysokosc tacki ;
 191:  ! [mm]. BOX: przyrost Z warstwy ;
 192:  ! razem z ;
 193:  ! przekladka [mm]. ;
 194:  R[215:BSSkokZ_mm]=(0) ;
 195:  ! R[216] - Nastawa edytowana, ;
 196:  ! wymaga APPLY przy zamknietym ;
 197:  ! zleceniu i pustej ;
 198:  ! stacji. TRAY: liczba tacek w ;
 199:  ! stosie. BOX: liczba warstw ;
 200:  ! pojemnika, minimum ;
 201:  ! 1. ;
 202:  R[216:BSWarstwMax]=(0) ;
 203:  ! R[217] - Nastawa edytowana, ;
 204:  ! wymaga APPLY przy zamknietym ;
 205:  ! zleceniu i pustej ;
 206:  ! stacji. Dodatni krok szukania ;
 207:  ! pustej tacki/przekladki po ;
 208:  ! ujemnym Z UFRAME ;
 209:  ! [mm]. ;
 210:  R[217:BSSzukKrok_mm]=(0) ;
 211:  ! R[218] - Nastawa edytowana, ;
 212:  ! wymaga APPLY przy zamknietym ;
 213:  ! zleceniu i pustej ;
 214:  ! stacji. Maksymalne dopuszczone ;
 215:  ! zejscie podczas szukania [mm]. ;
 216:  R[218:BSSzukMax_mm]=(0) ;
 217:  ! R[219] - Nastawa edytowana, ;
 218:  ! wymaga APPLY przy zamknietym ;
 219:  ! zleceniu i pustej ;
 220:  ! stacji. Maksymalna liczba ;
 221:  ! krokow szukania, przekroczenie ;
 222:  ! jest bledem. ;
 223:  R[219:BSSzukProbMax]=(0) ;
 224:  ! R[220] - Nastawa edytowana, ;
 225:  ! wymaga APPLY przy zamknietym ;
 226:  ! zleceniu i pustej ;
 227:  ! stacji. Limit predkosci: J w ;
 228:  ! procentach, L w mm/s, zakres ;
 229:  ! 1..100. ;
 230:  R[220:BSPredkosc]=(0) ;
 231:  ! R[221] - Nastawa edytowana, ;
 232:  ! wymaga APPLY przy zamknietym ;
 233:  ! zleceniu i pustej ;
 234:  ! stacji. Limit oczekiwania ;
 235:  ! chwytaka, IMM i ACK [surowe ;
 236:  ! ticki zegara]. ;
 237:  R[221:BSCzasMax_t]=(0) ;
 238:  ! R[222] - Nastawa edytowana, ;
 239:  ! wymaga APPLY przy zamknietym ;
 240:  ! zleceniu i pustej ;
 241:  ! stacji. Numer zatwierdzonego ;
 242:  ! UTOOL, nie zawiera danych TCP. ;
 243:  R[222:BSNrNarzedzia]=(0) ;
 244:  ! R[223] - Nastawa edytowana, ;
 245:  ! wymaga APPLY przy zamknietym ;
 246:  ! zleceniu i pustej ;
 247:  ! stacji. Numer zatwierdzonego ;
 248:  ! UFRAME, nie zawiera danych ;
 249:  ! geometrii ukladu. ;
 250:  R[223:BSNrUkladu]=(0) ;
 251:  ! R[224] - Nastawa edytowana, ;
 252:  ! wymaga APPLY przy zamknietym ;
 253:  ! zleceniu i pustej ;
 254:  ! stacji. Cele silownikow do ;
 255:  ! przejazdu i pustego nosnika. ;
 256:  ! Bity 0..4 HOME ;
 257:  ! V501..505, 5..9 WORK, para 00 ;
 258:  ! pomija, 11 blad. ;
 259:  R[224:BSCylPrzejazd]=(0) ;
 260:  ! R[225] - Nastawa edytowana, ;
 261:  ! wymaga APPLY przy zamknietym ;
 262:  ! zleceniu i pustej ;
 263:  ! stacji. Cele silownikow do ;
 264:  ! pobrania IMM. Bity 0..4 HOME ;
 265:  ! V501..505, 5..9 ;
 266:  ! WORK, para 00 pomija, 11 blad. ;
 267:  R[225:BSCylIMM]=(0) ;
 268:  ! R[226] - Nastawa edytowana, ;
 269:  ! wymaga APPLY przy zamknietym ;
 270:  ! zleceniu i pustej ;
 271:  ! stacji. Obwody pustej tacki ;
 272:  ! TRAY / przekladki BOX. Bit ;
 273:  ! 0..4 = proznia 1..5, ;
 274:  ! maska rozlaczna z produktami. ;
 275:  R[226:BSMaskaPusta]=(0) ;
 276:  ! R[227] - Nastawa edytowana, ;
 277:  ! wymaga APPLY przy zamknietym ;
 278:  ! zleceniu i pustej ;
 279:  ! stacji. Sekcja P2. Liczba ;
 280:  ! pozycji osi X, dodatnia liczba ;
 281:  ! calkowita. P2/P3: ;
 282:  ! obie osie 0 wylaczaja sekcje. ;
 283:  R[227:BSP2SiatkaX]=(0) ;
 284:  ! R[228] - Nastawa edytowana, ;
 285:  ! wymaga APPLY przy zamknietym ;
 286:  ! zleceniu i pustej ;
 287:  ! stacji. Sekcja P2. Liczba ;
 288:  ! pozycji osi Y, dodatnia liczba ;
 289:  ! calkowita. P2/P3: ;
 290:  ! obie osie 0 wylaczaja sekcje. ;
 291:  R[228:BSP2SiatkaY]=(0) ;
 292:  ! R[229] - Nastawa edytowana, ;
 293:  ! wymaga APPLY przy zamknietym ;
 294:  ! zleceniu i pustej ;
 295:  ! stacji. Sekcja P2. Skok ;
 296:  ! pozycji po X UFRAME [mm], moze ;
 297:  ! byc ujemny. ;
 298:  R[229:BSP2SkokX_mm]=(0) ;
 299:  ! R[230] - Nastawa edytowana, ;
 300:  ! wymaga APPLY przy zamknietym ;
 301:  ! zleceniu i pustej ;
 302:  ! stacji. Sekcja P2. Skok rzedow ;
 303:  ! po Y UFRAME [mm], moze byc ;
 304:  ! ujemny. ;
 305:  R[230:BSP2SkokY_mm]=(0) ;
 306:  ! R[231] - Nastawa edytowana, ;
 307:  ! wymaga APPLY przy zamknietym ;
 308:  ! zleceniu i pustej ;
 309:  ! stacji. Sekcja P3. Liczba ;
 310:  ! pozycji osi X, dodatnia liczba ;
 311:  ! calkowita. P2/P3: ;
 312:  ! obie osie 0 wylaczaja sekcje. ;
 313:  R[231:BSP3SiatkaX]=(0) ;
