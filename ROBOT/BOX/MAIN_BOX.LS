1362:  ! Kierunek: PLC do robota. ;
1363:  ! F[560] - Snapshot odebrany ;
1364:  ! przez PLC_RX. 1: cycleId ;
1365:  ! przydzielono do nowego ;
1366:  ! pobrania i jeszcze go nie ;
1367:  ! potwierdzono przez ;
1368:  ! immPickupCompleted, 0: nie ;
