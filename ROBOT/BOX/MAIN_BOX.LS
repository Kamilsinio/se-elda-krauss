 323:  ! wymaga APPLY przy zamknietym ;
 324:  ! zleceniu i pustej ;
 325:  ! stacji. Sekcja P3. Skok ;
 326:  ! pozycji po X UFRAME [mm], moze ;
 327:  ! byc ujemny. ;
 328:  R[233:BSP3SkokX_mm]=(0) ;
