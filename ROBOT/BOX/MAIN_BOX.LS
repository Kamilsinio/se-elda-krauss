 315:  ! wymaga APPLY przy zamknietym ;
 316:  ! zleceniu i pustej ;
 317:  ! stacji. Sekcja P3. Liczba ;
 318:  ! pozycji osi Y, dodatnia liczba ;
 319:  ! calkowita. P2/P3: ;
 320:  ! obie osie 0 wylaczaja sekcje. ;
 321:  R[232:BSP3SiatkaY]=(0) ;
