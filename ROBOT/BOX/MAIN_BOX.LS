 331:  ! zleceniu i pustej ;
 332:  ! stacji. Sekcja P3. Skok rzedow ;
 333:  ! po Y UFRAME [mm], moze byc ;
 334:  ! ujemny. ;
 335:  R[234:BSP3SkokY_mm]=(0) ;
 336:  ! R[235] - Nastawa edytowana, ;
 337:  ! wymaga APPLY przy zamknietym ;
 338:  ! zleceniu i pustej ;
 339:  ! stacji. Cele grupy 1: bity ;
 340:  ! HOME 0..4, WORK 5..9, para 00 ;
