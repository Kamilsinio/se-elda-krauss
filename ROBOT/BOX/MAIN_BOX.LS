1320:  ! Kierunek: PLC do robota. ;
1321:  R[294:BStartPoprz]=(R[78:RxProdStart]) ;
1322:  LBL[1001] ;
1323:  IF (!F[151:BZadApply]),JMP LBL[1002] ;
1324:  ! Sprawdzenie i zastosowanie ;
1325:  ! nastaw operatora ;
