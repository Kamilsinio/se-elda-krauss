 434:  ! obwodow. ;
 435:  R[249:BASztG3]=(0) ;
 436:  ! R[250] - Aktywna kopia po ;
 437:  ! APPLY, nie edytowac podczas ;
 438:  ! produkcji. Liczba ;
 439:  ! detali grupy 4 [szt.], ;
 440:  ! niezalezna od ssawek i ;
