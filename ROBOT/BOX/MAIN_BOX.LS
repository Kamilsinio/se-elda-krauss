9921:  ! R[99] - Lokalne zadanie lub ;
9922:  ! status aplikacji. 0 nieznana, ;
9923:  ! 10 oczekiwanie, 20 ;
9924:  ! pobranie IMM, 30 odkladanie, ;
9925:  ! 40 blister/przekladka, 50 ;
9926:  ! probki, 60 ;
9927:  ! zatrzymywanie, 70 zatrzymany, ;
9928:  ! 900 blad/odzyskiwanie. ;
9929:  ! Kierunek: Robot do PLC. ;
9930:  ! 10 gotowosc, 20 IMM, 30 ;
9931:  ! odkladanie, 40 pusty ;
9932:  ! nosnik/przekladki/koniec, 50 ;
9933:  ! probki/odrzuty, 60 powrot ;
9934:  ! HOME, 70 postoj, 900 recovery. ;
9935:  R[99:CmdProdFaza]=(10) ;
9936:  IF ((R[283:BKrok]>=200) AND (R[283:BKrok]<300)),R[99:CmdProdFaza]=(40) ;
9937:  IF ((R[283:BKrok]>=300) AND (R[283:BKrok]<400)),R[99:CmdProdFaza]=(20) ;
9938:  IF ((R[283:BKrok]>=400) AND (R[283:BKrok]<500)),R[99:CmdProdFaza]=(30) ;
9939:  IF ((R[283:BKrok]>=500) AND (R[283:BKrok]<700)),R[99:CmdProdFaza]=(40) ;
9940:  IF ((R[283:BKrok]>=700) AND (R[283:BKrok]<710)),R[99:CmdProdFaza]=(60) ;
9941:  IF ((R[283:BKrok]>=710) AND (R[283:BKrok]<711)),R[99:CmdProdFaza]=(70) ;
9942:  IF ((R[283:BKrok]>=720) AND (R[283:BKrok]<721)),R[99:CmdProdFaza]=(70) ;
9943:  IF ((R[283:BKrok]>=900) AND (R[283:BKrok]<901)),R[99:CmdProdFaza]=(900) ;
9944:  IF ((R[283:BKrok]>=400) AND (R[283:BKrok]<500) AND (R[299:BCelPartii]<>0)),R[99:CmdProdFaza]=(50) ;
9945:  IF (F[116:BUzgodnijStan]),F[759:BlokadaBG]=(ON) ;
9946:  IF (F[116:BUzgodnijStan]),R[283:BKrok]=(900) ;
9947:  LBL[1007] ;
9948:  LBL[2] ;
9949:  ! Oddanie czasu PLC i BG - 20 ms ;
9950:  WAIT   .02(sec) ;
9951:  IF (F[114:BMainWybrany]),JMP LBL[1] ;
9952:  ! Koniec programu po zwolnieniu ;
9953:  ! wyboru w BG ;
/POS
