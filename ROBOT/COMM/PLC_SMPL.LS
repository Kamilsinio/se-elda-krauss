/PROG PLC_SMPL
/ATTR
OWNER = MNEDITOR;
COMMENT = "Obsluga probek";
PROTECT = READ_WRITE;
DEFAULT_GROUP = *,*,*,*,*;
CONTROL_CODE = 00000000 00000000;
/MN
   1:  ! Zadanie i ACK probek ;
   2:  ! Robot zada - PLC wykonuje ;
   3:  ! Festo i EUROMAP ;
   4:  ! F[745] - Obustronna ;
   5:  ! synchronizacja i gotowosc sa ;
   6:  ! aktualne, OFF brak waznych ;
   7:  ! komend. ON opisany ;
   8:  ! warunek/zadanie, OFF brak. ;
   9:  ! R[143] - 0 bezczynna, 10 czeka ;
  10:  ! na decyzje main, 20 utrzymuje ;
  11:  ! ACK do zaniku ;
  12:  ! zadania PLC. ;
  13:  IF (!F[745:SesjaWazna]),R[143:StanProbek]=(0) ;
  14:  ! F[576] - Snapshot odebrany ;
  15:  ! przez PLC_RX. 1: jednorazowe ;
  16:  ! zadanie odlozenia ;
  17:  ! probek, 0: zwolnienie kanalu ;
  18:  ! po ACK. Kierunek: PLC do ;
  19:  ! robota. ;
  20:  ! R[144] - 0 brak, 10 ;
  21:  ! oczekiwanie, 20 przyjeto, 30 ;
  22:  ! odrzucono, 904 bledny ;
  23:  ! wynik. ;
  24:  IF ((R[143:StanProbek]=0) AND F[745:SesjaWazna] AND F[576:RxProbkiReq]),R[144:WynikProbek]=(10) ;
  25:  IF ((R[143:StanProbek]=0) AND F[745:SesjaWazna] AND F[576:RxProbkiReq]),R[143:StanProbek]=(10) ;
  26:  IF ((R[143:StanProbek]=10) AND !F[576:RxProbkiReq]),R[143:StanProbek]=(0) ;
  27:  ! F[655] - Lokalne zadanie lub ;
  28:  ! status aplikacji. 1: zadanie ;
  29:  ! probek przyjete, ;
  30:  ! nie oznacza odlozenia, ;
  31:  ! ukonczenie przez ;
  32:  ! event.samplesPlaced. Kierunek: ;
  33:  ! Robot ;
  34:  ! do PLC. ;
  35:  ! R[103] - Lokalne zadanie lub ;
  36:  ! status aplikacji. 0 brak, 1 ;
  37:  ! przyjeto, 2 ;
  38:  ! odrzucono, stabilne przy ;
  39:  ! samples.ack=1. Kierunek: Robot ;
  40:  ! do PLC. ;
  41:  IF ((R[143:StanProbek]=10) AND F[655:CmdProbkiACK] AND (R[103:CmdProbkiWynik]<>1) AND (R[103:CmdProbkiWynik]<>2)),R[144:WynikProbek]=(904) ;
  42:  ! R[145] - Odpowiedz probek: 1 ;
  43:  ! przyjeto caly nastepny ;
  44:  ! komplet, 2 odrzucono. ;
  45:  IF ((R[143:StanProbek]=10) AND F[655:CmdProbkiACK] AND (R[103:CmdProbkiWynik]=1)),R[145:DecyzjaProb]=(1) ;
  46:  IF ((R[143:StanProbek]=10) AND F[655:CmdProbkiACK] AND (R[103:CmdProbkiWynik]=1)),R[144:WynikProbek]=(20) ;
  47:  IF ((R[143:StanProbek]=10) AND F[655:CmdProbkiACK] AND (R[103:CmdProbkiWynik]=1)),R[143:StanProbek]=(20) ;
  48:  IF ((R[143:StanProbek]=10) AND F[655:CmdProbkiACK] AND (R[103:CmdProbkiWynik]=2)),R[145:DecyzjaProb]=(2) ;
  49:  IF ((R[143:StanProbek]=10) AND F[655:CmdProbkiACK] AND (R[103:CmdProbkiWynik]=2)),R[144:WynikProbek]=(30) ;
  50:  IF ((R[143:StanProbek]=10) AND F[655:CmdProbkiACK] AND (R[103:CmdProbkiWynik]=2)),R[143:StanProbek]=(20) ;
  51:  F[655:CmdProbkiACK]=(OFF) ;
  52:  IF ((R[143:StanProbek]=20) AND !F[576:RxProbkiReq]),R[143:StanProbek]=(0) ;
  53:  ! F[719] - Bufor wyjscia po ;
  54:  ! walidacji. 1: zadanie probek ;
  55:  ! przyjete, nie oznacza ;
  56:  ! odlozenia, ukonczenie przez ;
  57:  ! event.samplesPlaced. Kierunek: ;
  58:  ! Robot do PLC. ;
  59:  F[719:TxProbkiACK]=((R[143:StanProbek]=20) AND F[745:SesjaWazna]) ;
/POS
/END
