/PROG PLC_IMM
/ATTR
OWNER = MNEDITOR;
COMMENT = "Zadania IMM";
PROTECT = READ_WRITE;
DEFAULT_GROUP = *,*,*,*,*;
CONTROL_CODE = 00000000 00000000;
/MN
   1:  ! Zadania EUROMAP do PLC ;
   2:  ! Robot zada - PLC wykonuje ;
   3:  ! Festo i EUROMAP ;
   4:  ! F[697] - Bufor wyjscia po ;
   5:  ! walidacji. 1: robot zada ;
   6:  ! procesowego pozwolenia ;
   7:  ! ejectorBack, 0: nie zada. PLC ;
   8:  ! kontroluje koncowe wyjscie. ;
   9:  ! Kierunek: Robot do ;
  10:  ! PLC. ;
  11:  ! F[633] - Lokalne zadanie lub ;
  12:  ! status aplikacji. 1: robot ;
  13:  ! zada procesowego ;
  14:  ! pozwolenia ejectorBack, 0: nie ;
  15:  ! zada. PLC kontroluje koncowe ;
  16:  ! wyjscie. ;
  17:  ! Kierunek: Robot do PLC. ;
  18:  ! F[752] - Komunikacja dopuszcza ;
  19:  ! wykonanie po walidacji sesji i ;
  20:  ! procesu, OFF ;
  21:  ! blokada. ON opisany ;
  22:  ! warunek/zadanie, OFF brak. ;
  23:  F[697:TxIMMZWyrzTyl]=(F[633:CmdIMMZWyrzTyl] AND F[752:KomendyDozw]) ;
  24:  ! F[698] - Bufor wyjscia po ;
  25:  ! walidacji. 1: robot zada ;
  26:  ! procesowego pozwolenia ;
  27:  ! ejectorForward, 0: nie zada. ;
  28:  ! PLC kontroluje koncowe ;
  29:  ! wyjscie. Kierunek: Robot ;
  30:  ! do PLC. ;
  31:  ! F[634] - Lokalne zadanie lub ;
  32:  ! status aplikacji. 1: robot ;
  33:  ! zada procesowego ;
  34:  ! pozwolenia ejectorForward, 0: ;
  35:  ! nie zada. PLC kontroluje ;
  36:  ! koncowe wyjscie. ;
  37:  ! Kierunek: Robot do PLC. ;
  38:  F[698:TxIMMZWyrzPrz]=(F[634:CmdIMMZWyrzPrz] AND F[752:KomendyDozw]) ;
  39:  ! F[699] - Bufor wyjscia po ;
  40:  ! walidacji. 1: robot zada ;
  41:  ! procesowego pozwolenia ;
  42:  ! mouldClose, 0: nie zada. PLC ;
  43:  ! kontroluje koncowe wyjscie. ;
  44:  ! Kierunek: Robot do ;
  45:  ! PLC. ;
  46:  ! F[635] - Lokalne zadanie lub ;
  47:  ! status aplikacji. 1: robot ;
  48:  ! zada procesowego ;
  49:  ! pozwolenia mouldClose, 0: nie ;
  50:  ! zada. PLC kontroluje koncowe ;
  51:  ! wyjscie. ;
  52:  ! Kierunek: Robot do PLC. ;
  53:  F[699:TxIMMZZamForme]=(F[635:CmdIMMZZ_Forme] AND F[752:KomendyDozw]) ;
  54:  ! F[700] - Bufor wyjscia po ;
  55:  ! walidacji. 1: robot zada ;
  56:  ! procesowego pozwolenia ;
  57:  ! mouldFullOpen, 0: nie zada. ;
  58:  ! PLC kontroluje koncowe ;
  59:  ! wyjscie. Kierunek: Robot ;
  60:  ! do PLC. ;
  61:  ! F[636] - Lokalne zadanie lub ;
  62:  ! status aplikacji. 1: robot ;
  63:  ! zada procesowego ;
  64:  ! pozwolenia mouldFullOpen, 0: ;
  65:  ! nie zada. PLC kontroluje ;
  66:  ! koncowe wyjscie. ;
  67:  ! Kierunek: Robot do PLC. ;
  68:  F[700:TxIMMZOtwForme]=(F[636:CmdIMMZO_Forme] AND F[752:KomendyDozw]) ;
/POS
/END
