  11:  ! recovery lacza i ma wazne ;
  12:  ! monitory. ON opisany ;
  13:  ! warunek/zadanie, OFF brak. ;
  14:  F[746:RobotGotow]=(OFF) ;
  15:  ! F[739] - Main uzbroil proces, ;
  16:  ! OFF robot nie moze wydawac ;
  17:  ! komend ;
  18:  ! wykonawczych. ON opisany ;
  19:  ! warunek/zadanie, OFF brak. ;
  20:  F[739:ProcesUzbr]=(OFF) ;
  21:  ! F[740] - Jednorazowe zadanie ;
  22:  ! jawnego recovery lacza, ;
  23:  ! konsumowane przez ;
  24:  ! PLC_LINK. ON opisany ;
  25:  ! warunek/zadanie, OFF brak. ;
  26:  F[740:ZadRecLacza]=(OFF) ;
  27:  ! F[750] - Od resetu istniala ;
  28:  ! sesja, wykrywanie utraty ;
  29:  ! gotowosci partnera. ON ;
  30:  ! opisany warunek/zadanie, OFF ;
  31:  ! brak. ;
  32:  F[750:SesjaByla]=(OFF) ;
  33:  ! F[749] - W biezacej wymianie ;
  34:  ! odebrano zadanie SYNC PLC. ON ;
  35:  ! opisany ;
  36:  ! warunek/zadanie, OFF brak. ;
  37:  F[749:SYNCPLCbyl]=(OFF) ;
  38:  ! F[747] - Robot zada ;
  39:  ! synchronizacji, OFF zadanie ;
  40:  ! wygaszone. ON opisany ;
  41:  ! warunek/zadanie, OFF brak. ;
  42:  F[747:ZadSYNC]=(OFF) ;
  43:  ! F[748] - Odpowiedz na zadanie ;
  44:  ! SYNC PLC: ON potwierdza, OFF ;
  45:  ! wygasza. ON ;
  46:  ! opisany warunek/zadanie, OFF ;
  47:  ! brak. ;
  48:  F[748:ACK_SYNC]=(OFF) ;
  49:  ! R[126] - Stan: 0 rozbrojone, ;
  50:  ! 10 zadanie SYNC, 20 wygaszanie ;
  51:  ! ACK, 30 ;
  52:  ! recovery, 40 po jawnym ;
  53:  ! recovery, gotowosc sesji. ;
  54:  R[126:StanLacza]=(0) ;
  55:  ! R[140] - Czas rozpoczecia ;
  56:  ! synchronizacji [ticki]. ;
  57:  ! R[129] - Biezacy czas ;
  58:  ! watchdogow [surowe ticki], ;
  59:  ! czestotliwosc do pomiaru. ;
  60:  R[140:SYNCod_t]=(R[129:CzasTeraz_t]) ;
