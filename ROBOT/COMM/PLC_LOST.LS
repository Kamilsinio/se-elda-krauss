/PROG PLC_LOST
/ATTR
OWNER = MNEDITOR;
COMMENT = "Utrata lacza";
PROTECT = READ_WRITE;
DEFAULT_GROUP = *,*,*,*,*;
CONTROL_CODE = 00000000 00000000;
/MN
   1:  ! Uniewaznienie sesji ;
   2:  ! Robot zada - PLC wykonuje ;
   3:  ! Festo i EUROMAP ;
   4:  ! F[745] - Obustronna ;
   5:  ! synchronizacja i gotowosc sa ;
   6:  ! aktualne, OFF brak waznych ;
   7:  ! komend. ON opisany ;
   8:  ! warunek/zadanie, OFF brak. ;
   9:  F[745:SesjaWazna]=(OFF) ;
