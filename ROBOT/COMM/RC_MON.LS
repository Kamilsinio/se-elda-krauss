/PROG RC_MON
/ATTR
OWNER = MNEDITOR;
COMMENT = "EIP bez ruchu";
PROTECT = READ_WRITE;
DEFAULT_GROUP = *,*,*,*,*;
CONTROL_CODE = 00000000 00000000;
/MN
   1:  R[129]=($FAST_CLOCK) ;
   2:  F[744]=(R[129]>=R[130]) ;
   3:  IF (!F[744]),F[741]=(OFF) ;
   4:  IF (!F[744]),F[742]=(OFF) ;
   5:  IF (!F[744]),R[134]=(R[129]) ;
   6:  IF (R[52]<>R[133]),R[131]=(R[129]) ;
   7:  IF (R[52]<>R[133]),F[741]=(ON) ;
   8:  R[133]=(R[52]) ;
   9:  IF (R[127]<>R[128]),R[132]=(R[129]) ;
  10:  IF (R[127]<>R[128]),F[742]=(ON) ;
  11:  R[128]=(R[127]) ;
  12:  F[758]=((R[129]>=R[142]) AND (R[142]>0)) ;
  13:  F[758]=(F[758] AND (R[129]-R[142]<R[138])) ;
  14:  F[758]=(F[758] AND (R[129]>=R[146]) AND (R[146]>0)) ;
  15:  F[758]=(F[758] AND (R[129]-R[146]<R[138])) ;
  16:  F[743]=(F[738]) ;
  17:  F[743]=(F[743] AND F[736]) ;
  18:  F[743]=(F[743] AND F[744]) ;
  19:  F[743]=(F[743] AND F[741]) ;
  20:  F[743]=(F[743] AND F[742]) ;
  21:  F[743]=(F[743] AND (R[51]=2)) ;
  22:  F[743]=(F[743] AND (R[129]-R[131]<R[137])) ;
  23:  F[743]=(F[743] AND (R[129]-R[132]<R[138])) ;
  24:  F[743]=(F[743] AND (R[136]>0)) ;
  25:  F[743]=(F[743] AND (R[137]>R[136])) ;
  26:  F[743]=(F[743] AND (R[138]>0)) ;
  27:  F[743]=(F[743] AND (!F[756] OR F[758])) ;
  28:  F[754]=(F[736] AND F[738] AND F[742] AND (R[129]-R[132]<R[138]) AND (R[129]-R[134]>=R[136])) ;
  29:  IF (F[754]),R[135]=((R[135]+1) MOD 65536) ;
  30:  IF (F[754]),R[134]=(R[129]) ;
  31:  R[130]=(R[129]) ;
  32:  GO[2]=(R[135]) ;
/POS
/END
