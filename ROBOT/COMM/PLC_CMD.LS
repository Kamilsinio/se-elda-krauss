 894:  ! narzedzia, nie liczba ;
 895:  ! detali. W F-2680 obwod 3 ;
 896:  ! dotyczy blistrow. Pozostale ;
 897:  ! bity 0. Wazne tylko z ;
 898:  ! loadKnown=1. Kierunek: Robot ;
 899:  ! do PLC. ;
 900:  IF ((R[98:CmdProdMaskLad]<0) OR (R[98:CmdProdMaskLad]>65535) OR ((R[98:CmdProdMaskLad] MOD 1)<>0)),F[751:BladProto]=(ON) ;
 901:  IF ((R[98:CmdProdMaskLad]<0) OR (R[98:CmdProdMaskLad]>65535) OR ((R[98:CmdProdMaskLad] MOD 1)<>0)),R[141:BladLacza]=(908) ;
 902:  ! R[99] - Lokalne zadanie lub ;
 903:  ! status aplikacji. 0 nieznana, ;
 904:  ! 10 oczekiwanie, 20 ;
 905:  ! pobranie IMM, 30 odkladanie, ;
 906:  ! 40 blister/przekladka, 50 ;
 907:  ! probki, 60 ;
 908:  ! zatrzymywanie, 70 zatrzymany, ;
 909:  ! 900 blad/odzyskiwanie. ;
 910:  ! Kierunek: Robot do PLC. ;
 911:  ! 10 gotowosc, 20 IMM, 30 ;
 912:  ! odkladanie, 40 pusty ;
 913:  ! nosnik/przekladki/koniec, 50 ;
 914:  ! probki/odrzuty, 60 powrot ;
 915:  ! HOME, 70 postoj, 900 recovery. ;
 916:  IF ((R[99:CmdProdFaza]<0) OR (R[99:CmdProdFaza]>65535) OR ((R[99:CmdProdFaza] MOD 1)<>0)),F[751:BladProto]=(ON) ;
 917:  IF ((R[99:CmdProdFaza]<0) OR (R[99:CmdProdFaza]>65535) OR ((R[99:CmdProdFaza] MOD 1)<>0)),R[141:BladLacza]=(908) ;
 918:  ! R[100] - Lokalne zadanie lub ;
 919:  ! status aplikacji. 0: ;
 920:  ! zaden/nieznany, 1: ;
 921:  ! Pojemniki, 2: Blistry, ;
 922:  ! identyfikacja programu ;
 923:  ! faktycznie uruchomionego. ;
 924:  ! Kierunek: Robot do PLC. ;
 925:  IF ((R[100:CmdProdProgram]<0) OR (R[100:CmdProdProgram]>65535) OR ((R[100:CmdProdProgram] MOD 1)<>0)),F[751:BladProto]=(ON) ;
 926:  IF ((R[100:CmdProdProgram]<0) OR (R[100:CmdProdProgram]>65535) OR ((R[100:CmdProdProgram] MOD 1)<>0)),R[141:BladLacza]=(908) ;
 927:  ! R[101] - Lokalne zadanie lub ;
 928:  ! status aplikacji. Kod miejsca ;
 929:  ! w procedurze wg ;
 930:  ! robot-modernization.md. ;
 931:  ! Kierunek: Robot do PLC. ;
 932:  IF ((R[101:CmdProdKrok]<0) OR (R[101:CmdProdKrok]>65535) OR ((R[101:CmdProdKrok] MOD 1)<>0)),F[751:BladProto]=(ON) ;
 933:  IF ((R[101:CmdProdKrok]<0) OR (R[101:CmdProdKrok]>65535) OR ((R[101:CmdProdKrok] MOD 1)<>0)),R[141:BladLacza]=(908) ;
 934:  ! R[102] - Lokalne zadanie lub ;
 935:  ! status aplikacji. 0 brak, 10 ;
 936:  ! synchronizacja, 20 ;
 937:  ! pozwolenie, 30 IMM, 40 ;
 938:  ! silownik, 50 proznia, 60 ;
 939:  ! obszar, 70 ACK, 80 operator. ;
 940:  ! Kierunek: Robot do PLC. 0 ;
 941:  ! brak, 20 partia, 30 forma, 40 ;
 942:  ! chwytak, 50 ;
 943:  ! proznia/przedmuch, 60 ;
 944:  ! obszar/nosnik, 70 ACK, 80 ;
 945:  ! operator lub Start. ;
 946:  IF ((R[102:CmdProdC_kaKod]<0) OR (R[102:CmdProdC_kaKod]>65535) OR ((R[102:CmdProdC_kaKod] MOD 1)<>0)),F[751:BladProto]=(ON) ;
 947:  IF ((R[102:CmdProdC_kaKod]<0) OR (R[102:CmdProdC_kaKod]>65535) OR ((R[102:CmdProdC_kaKod] MOD 1)<>0)),R[141:BladLacza]=(908) ;
 948:  ! F[752] - Komunikacja dopuszcza ;
 949:  ! wykonanie po walidacji sesji i ;
 950:  ! procesu, OFF ;
 951:  ! blokada. ON opisany ;
 952:  ! warunek/zadanie, OFF brak. ;
 953:  ! F[745] - Obustronna ;
 954:  ! synchronizacja i gotowosc sa ;
 955:  ! aktualne, OFF brak waznych ;
 956:  ! komend. ON opisany ;
 957:  ! warunek/zadanie, OFF brak. ;
 958:  F[752:KomendyDozw]=(F[745:SesjaWazna]) ;
 959:  ! F[759] - Zadano krytyczna ;
 960:  ! blokade i recovery, OFF brak ;
 961:  ! tego zadania. ON ;
 962:  ! opisany warunek/zadanie, OFF ;
 963:  ! brak. ;
 964:  F[752:KomendyDozw]=(F[752:KomendyDozw] AND !F[751:BladProto] AND !F[759:BlokadaBG]) ;
 965:  ! F[739] - Main uzbroil proces, ;
 966:  ! OFF robot nie moze wydawac ;
 967:  ! komend ;
 968:  ! wykonawczych. ON opisany ;
 969:  ! warunek/zadanie, OFF brak. ;
 970:  F[752:KomendyDozw]=(F[752:KomendyDozw] AND F[739:ProcesUzbr]) ;
 971:  ! F[568] - Snapshot odebrany ;
 972:  ! przez PLC_RX. 1: blokada ;
 973:  ! krytyczna, 0: brak ;
 974:  ! zgloszonej blokady. Nie jest ;
 975:  ! sygnalem safety. Kierunek: PLC ;
 976:  ! do robota. ;
 977:  ! F[573] - Snapshot odebrany ;
 978:  ! przez PLC_RX. 1: wymagane ;
 979:  ! uzgodnienie stanu, 0: ;
 980:  ! uzgodniony stan. Kierunek: PLC ;
 981:  ! do robota. ;
 982:  F[752:KomendyDozw]=(F[752:KomendyDozw] AND !F[568:RxProdKrytBlok] AND !F[573:RxProdRecovery]) ;
 983:  ! F[571] - Snapshot odebrany ;
 984:  ! przez PLC_RX. 1: mozna ;
 985:  ! rozpoczac nowa operacje ;
 986:  ! produkcyjna, 0: nie ;
 987:  ! rozpoczynac kolejnej. ;
 988:  ! Kierunek: PLC do robota. ;
 989:  ! F[570] - Snapshot odebrany ;
 990:  ! przez PLC_RX. 1: dozwolone ;
 991:  ! dokonczenie ;
 992:  ! rozliczanych operacji przy ;
 993:  ! spelnionych blokadach, 0: brak ;
 994:  ! pozwolenia. ;
 995:  ! Kierunek: PLC do robota. ;
 996:  F[752:KomendyDozw]=(F[752:KomendyDozw] AND (F[571:RxProdNoweZez] OR F[570:RxProdDo_czZez])) ;
 997:  ! F[756] - Wybrany main wymaga ;
 998:  ! aktualnych BG, OFF sam serwis ;
 999:  ! komunikacji. ON ;
1000:  ! opisany warunek/zadanie, OFF ;
1001:  ! brak. ;
1002:  ! F[757] - BG potwierdza blokady ;
1003:  ! procesu, native, profil i ;
1004:  ! zlecenie, OFF ruch ;
1005:  ! i komendy zabronione. ON ;
1006:  ! opisany warunek/zadanie, OFF ;
1007:  ! brak. ;
1008:  F[752:KomendyDozw]=(F[752:KomendyDozw] AND (!F[756:MainWymag] OR F[757:ProcesDozw])) ;
1009:  ! F[746] - Robot zakonczyl ;
1010:  ! recovery lacza i ma wazne ;
1011:  ! monitory. ON opisany ;
1012:  ! warunek/zadanie, OFF brak. ;
1013:  F[701:TxLaczGot]=(F[746:RobotGotow]) ;
1014:  ! F[747] - Robot zada ;
1015:  ! synchronizacji, OFF zadanie ;
1016:  ! wygaszone. ON opisany ;
1017:  ! warunek/zadanie, OFF brak. ;
1018:  F[703:TxLaczSyncReq]=(F[747:ZadSYNC]) ;
1019:  ! F[748] - Odpowiedz na zadanie ;
1020:  ! SYNC PLC: ON potwierdza, OFF ;
1021:  ! wygasza. ON ;
1022:  ! opisany warunek/zadanie, OFF ;
1023:  ! brak. ;
1024:  F[702:TxLaczSyncACK]=(F[748:ACK_SYNC]) ;
1025:  CALL PLC_CYL ;
1026:  CALL PLC_VAC ;
1027:  CALL PLC_AREA ;
1028:  CALL PLC_IMM ;
1029:  CALL PLC_EVT ;
1030:  CALL PLC_SMPL ;
