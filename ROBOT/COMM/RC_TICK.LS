/PROG RC_TICK
/ATTR
OWNER = MNEDITOR;
COMMENT = "EIP bez ruchu";
PROTECT = READ_WRITE;
DEFAULT_GROUP = *,*,*,*,*;
CONTROL_CODE = 00000000 00000000;
/MN
   1:  CALL RC_RX ;
   2:  CALL RC_LINK ;
   3:  CALL RC_CMD ;
   4:  IF (F[751] AND (R[126]=40)),CALL RC_DROP ;
   5:  IF (F[751]),CALL RC_CMD ;
   6:  CALL RC_TX ;
   7:  R[127]=((R[127]+1) MOD 65536) ;
/POS
/END
