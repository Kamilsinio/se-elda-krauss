/PROG RT_FULL
/ATTR
OWNER = MNEDITOR;
COMMENT = "Krauss tacki";
PROTECT = READ_WRITE;
DEFAULT_GROUP = *,*,*,*,*;
CONTROL_CODE = 00000000 00000000;
/MN
   1:  IF (R[180]=500),JMP LBL[500] ;
   2:  IF (R[180]=510),JMP LBL[510] ;
   3:  IF (R[180]=520),JMP LBL[520] ;
   4:  IF (R[180]=600),JMP LBL[600] ;
   5:  IF (R[180]=610),JMP LBL[610] ;
   6:  IF (R[180]=620),JMP LBL[620] ;
   7:  CALL RT_BADSTATE ;
   8:  JMP LBL[999] ;
   9:  LBL[500] ;
  10:  ! Zdarzenie pelnej tacki ;
  11:  CALL RE_BLFULL ;
  12:  R[179]=(510) ;
  13:  JMP LBL[999] ;
  14:  LBL[510] ;
  15:  ! ACK pelnej tacki ;
  16:  R[196]=(3) ;
  17:  R[102]=(70) ;
  18:  CALL RE_DONE ;
  19:  IF (F[23]),R[179]=(520) ;
  20:  JMP LBL[999] ;
  21:  LBL[520] ;
  22:  ! Nastepna tacka ;
  23:  R[188]=(R[188]+1) ;
  24:  R[187]=(0) ;
  25:  F[19]=(OFF) ;
  26:  R[179]=(10) ;
  27:  IF (R[188]=R[42]),R[179]=(600) ;
  28:  JMP LBL[999] ;
  29:  LBL[600] ;
  30:  ! Zdarzenie pelnego stosu ;
  31:  CALL RE_STACK ;
  32:  R[179]=(610) ;
  33:  JMP LBL[999] ;
  34:  LBL[610] ;
  35:  ! ACK stosu ;
  36:  R[196]=(4) ;
  37:  R[102]=(70) ;
  38:  CALL RE_DONE ;
  39:  IF (F[23]),F[42]=(ON) ;
  40:  IF (F[23]),R[179]=(620) ;
  41:  JMP LBL[999] ;
  42:  LBL[620] ;
  43:  ! Oczekiwanie na nowy stos ;
  44:  R[102]=(60) ;
  45:  IF ((F[574] OR F[569]) AND F[562] AND (R[63]=0)),R[179]=(700) ;
  46:  IF (R[179]=700),JMP LBL[999] ;
  47:  IF (R[66]=R[189]),JMP LBL[999] ;
  48:  F[42]=(OFF) ;
  49:  R[189]=(R[66]) ;
  50:  R[188]=(0) ;
  51:  R[179]=(10) ;
  52:  JMP LBL[999] ;
  53:  LBL[9000] ;
  54:  IF (R[97]=0),R[97]=(1900) ;
  55:  F[16]=(ON) ;
  56:  R[179]=(900) ;
  57:  LBL[999] ;
/POS
/END
