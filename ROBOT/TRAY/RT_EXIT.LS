/PROG RT_EXIT
/ATTR
OWNER = MNEDITOR;
COMMENT = "Krauss tacki";
PROTECT = READ_WRITE;
DEFAULT_GROUP = *,*,*,*,*;
CONTROL_CODE = 00000000 00000000;
/MN
   1:  IF ((R[179]<>710) OR F[17] OR (R[98]<>0)),JMP LBL[999] ;
   2:  F[14]=(OFF) ;
   3:  F[15]=(OFF) ;
   4:  F[739]=(OFF) ;
   5:  F[756]=(OFF) ;
   6:  LBL[999] ;
/POS
/END
