/PROG RT_TACK
/ATTR
OWNER = MNEDITOR;
COMMENT = "Krauss tacki";
PROTECT = READ_WRITE;
DEFAULT_GROUP = *,*,*,*,*;
CONTROL_CODE = 00000000 00000000;
/MN
   1:  IF (R[180]=205),JMP LBL[205] ;
   2:  IF (R[180]=200),JMP LBL[200] ;
   3:  IF (R[180]=210),JMP LBL[210] ;
   4:  IF (R[180]=220),JMP LBL[220] ;
   5:  IF (R[180]=225),JMP LBL[225] ;
   6:  IF (R[180]=240),JMP LBL[240] ;
   7:  IF (R[180]=245),JMP LBL[245] ;
   8:  IF (R[180]=250),JMP LBL[250] ;
   9:  IF (R[180]=260),JMP LBL[260] ;
  10:  IF (R[180]=270),JMP LBL[270] ;
  11:  IF (R[180]=275),JMP LBL[275] ;
  12:  IF (R[180]=280),JMP LBL[280] ;
  13:  IF (R[180]=285),JMP LBL[285] ;
  14:  IF (R[180]=290),JMP LBL[290] ;
  15:  IF (R[180]=295),JMP LBL[295] ;
  16:  CALL RT_BADSTATE ;
  17:  JMP LBL[999] ;
  18:  LBL[205] ;
  19:  ! Oczekiwanie na dostep do zrodla ;
  20:  R[102]=(60) ;
  21:  IF (F[506] AND F[504]),R[179]=(210) ;
  22:  JMP LBL[999] ;
  23:  LBL[200] ;
  24:  ! Zadanie dostepu do zrodla ;
  25:  IF (!(!(((R[178] DIV 1) MOD 2)=1) OR !F[581])),R[97]=(1502) ;
  26:  IF (!(!(((R[178] DIV 1) MOD 2)=1) OR !F[581])),JMP LBL[9000] ;
  27:  IF (!(!(((R[178] DIV 2) MOD 2)=1) OR !F[587])),R[97]=(1502) ;
  28:  IF (!(!(((R[178] DIV 2) MOD 2)=1) OR !F[587])),JMP LBL[9000] ;
  29:  IF (!(!(((R[178] DIV 4) MOD 2)=1) OR !F[593])),R[97]=(1502) ;
  30:  IF (!(!(((R[178] DIV 4) MOD 2)=1) OR !F[593])),JMP LBL[9000] ;
  31:  IF (!(!(((R[178] DIV 8) MOD 2)=1) OR !F[599])),R[97]=(1502) ;
  32:  IF (!(!(((R[178] DIV 8) MOD 2)=1) OR !F[599])),JMP LBL[9000] ;
  33:  IF (!(!(((R[178] DIV 16) MOD 2)=1) OR !F[605])),R[97]=(1502) ;
  34:  IF (!(!(((R[178] DIV 16) MOD 2)=1) OR !F[605])),JMP LBL[9000] ;
  35:  F[27]=(OFF) ;
  36:  F[610]=(ON) ;
  37:  R[191]=(R[178]) ;
  38:  R[193]=(0) ;
  39:  R[194]=(0) ;
  40:  R[179]=(205) ;
  41:  JMP LBL[999] ;
  42:  LBL[210] ;
  43:  ! Dostep i dojazd do stosu ;
  44:  R[102]=(60) ;
  45:  CALL RG_FOLD ;
  46:  IF (!F[506] OR !F[504]),JMP LBL[999] ;
  47:  IF (!F[24]),JMP LBL[999] ;
  48:  F[39]=(ON) ;
  49:  CALL RM_SRCIN ;
  50:  IF (F[20]),R[179]=(220) ;
  51:  JMP LBL[999] ;
  52:  LBL[220] ;
  53:  ! Wlaczenie prozni tacki ;
  54:  CALL RG_VACON ;
  55:  IF (F[25]),R[179]=(240) ;
  56:  IF (!F[25]),R[179]=(225) ;
  57:  JMP LBL[999] ;
  58:  LBL[225] ;
  59:  ! Ograniczone szukanie tacki ;
  60:  R[102]=(50) ;
  61:  CALL RG_VACON ;
  62:  IF (F[25]),R[179]=(240) ;
  63:  IF (F[25]),JMP LBL[999] ;
  64:  IF (R[129]-R[182]<R[47]),JMP LBL[999] ;
  65:  R[193]=(R[193]+R[43]) ;
  66:  R[194]=(R[194]+1) ;
  67:  IF (!((R[193]<=R[44]) AND (R[194]<=R[45]))),R[97]=(1501) ;
  68:  IF (!((R[193]<=R[44]) AND (R[194]<=R[45]))),JMP LBL[9000] ;
  69:  CALL RM_SEARCH ;
  70:  IF (F[20]),R[179]=(220) ;
  71:  JMP LBL[999] ;
  72:  LBL[240] ;
  73:  ! Podniesienie i wyjazd ze zrodla ;
  74:  R[98]=(R[178]) ;
  75:  F[645]=(ON) ;
  76:  CALL RM_SRCOUT ;
  77:  IF (F[20]),R[179]=(245) ;
  78:  JMP LBL[999] ;
  79:  LBL[245] ;
  80:  ! Potwierdzenie pobrania tacki ;
  81:  F[27]=(ON) ;
  82:  F[39]=(OFF) ;
  83:  F[610]=(OFF) ;
  84:  CALL RE_BLPICK ;
  85:  R[179]=(250) ;
  86:  JMP LBL[999] ;
  87:  LBL[250] ;
  88:  ! ACK pobrania tacki ;
  89:  R[196]=(1) ;
  90:  R[102]=(70) ;
  91:  CALL RE_DONE ;
  92:  IF (F[23]),R[179]=(260) ;
  93:  JMP LBL[999] ;
  94:  LBL[260] ;
  95:  ! Zadanie dostepu do windy ;
  96:  F[28]=(OFF) ;
  97:  F[608]=(ON) ;
  98:  R[179]=(270) ;
  99:  JMP LBL[999] ;
 100:  LBL[270] ;
 101:  ! Odlozenie pustej tacki ;
 102:  R[102]=(60) ;
 103:  IF (!F[503] OR !F[501]),JMP LBL[999] ;
 104:  F[40]=(ON) ;
 105:  CALL RM_TRAYIN ;
 106:  IF (F[20]),R[179]=(275) ;
 107:  JMP LBL[999] ;
 108:  LBL[275] ;
 109:  ! Zwolnienie tacki ;
 110:  R[191]=(R[178]) ;
 111:  CALL RG_RELEASE ;
 112:  R[179]=(280) ;
 113:  JMP LBL[999] ;
 114:  LBL[280] ;
 115:  ! Potwierdzenie zwolnienia tacki ;
 116:  R[102]=(50) ;
 117:  CALL RG_RELEASED ;
 118:  IF (F[26]),CALL RE_BLPLACE ;
 119:  IF (F[26]),R[179]=(285) ;
 120:  JMP LBL[999] ;
 121:  LBL[285] ;
 122:  ! ACK odlozenia tacki ;
 123:  R[196]=(2) ;
 124:  R[102]=(70) ;
 125:  CALL RE_DONE ;
 126:  IF (F[23]),R[179]=(290) ;
 127:  JMP LBL[999] ;
 128:  LBL[290] ;
 129:  ! Wycofanie z windy ;
 130:  CALL RM_TRAYOUT ;
 131:  IF (F[20]),R[179]=(295) ;
 132:  JMP LBL[999] ;
 133:  LBL[295] ;
 134:  ! Tacka gotowa ;
 135:  F[28]=(ON) ;
 136:  F[40]=(OFF) ;
 137:  F[608]=(OFF) ;
 138:  F[19]=(ON) ;
 139:  R[179]=(10) ;
 140:  IF (F[17]),R[179]=(300) ;
 141:  JMP LBL[999] ;
 142:  LBL[9000] ;
 143:  IF (R[97]=0),R[97]=(1900) ;
 144:  F[16]=(ON) ;
 145:  R[179]=(900) ;
 146:  LBL[999] ;
/POS
/END
