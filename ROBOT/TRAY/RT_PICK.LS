/PROG RT_PICK
/ATTR
OWNER = MNEDITOR;
COMMENT = "Krauss tacki";
PROTECT = READ_WRITE;
DEFAULT_GROUP = *,*,*,*,*;
CONTROL_CODE = 00000000 00000000;
/MN
   1:  IF (R[180]=300),JMP LBL[300] ;
   2:  IF (R[180]=310),JMP LBL[310] ;
   3:  IF (R[180]=320),JMP LBL[320] ;
   4:  IF (R[180]=330),JMP LBL[330] ;
   5:  IF (R[180]=340),JMP LBL[340] ;
   6:  IF (R[180]=350),JMP LBL[350] ;
   7:  IF (R[180]=360),JMP LBL[360] ;
   8:  IF (R[180]=370),JMP LBL[370] ;
   9:  IF (R[180]=380),JMP LBL[380] ;
  10:  CALL RT_BADSTATE ;
  11:  JMP LBL[999] ;
  12:  LBL[300] ;
  13:  ! Przygotowanie pobrania z formy ;
  14:  CALL RG_STRAIGHT ;
  15:  R[102]=(40) ;
  16:  IF (!F[24]),JMP LBL[999] ;
  17:  CALL RM_IMMIN ;
  18:  IF (F[20]),R[179]=(310) ;
  19:  JMP LBL[999] ;
  20:  LBL[310] ;
  21:  ! Oczekiwanie na otwarta forme ;
  22:  R[102]=(30) ;
  23:  F[635]=(OFF) ;
  24:  F[636]=(ON) ;
  25:  IF (!F[563] OR !F[564] OR !F[558] OR F[556]),JMP LBL[999] ;
  26:  R[179]=(320) ;
  27:  JMP LBL[999] ;
  28:  LBL[320] ;
  29:  ! Wejscie i proznia detali ;
  30:  R[191]=(0) ;
  31:  R[191]=(R[191]+R[27]) ;
  32:  R[191]=(R[191]+R[28]) ;
  33:  R[191]=(R[191]+R[29]) ;
  34:  R[191]=(R[191]+R[30]) ;
  35:  R[191]=(R[191]+R[31]) ;
  36:  CALL RG_VACON ;
  37:  F[30]=(OFF) ;
  38:  CALL RM_PICK ;
  39:  IF (F[20]),R[179]=(330) ;
  40:  JMP LBL[999] ;
  41:  LBL[330] ;
  42:  ! Zadanie wyrzutnika ;
  43:  F[633]=(OFF) ;
  44:  F[634]=(ON) ;
  45:  R[179]=(340) ;
  46:  JMP LBL[999] ;
  47:  LBL[340] ;
  48:  ! Potwierdzenie detali i wyrzutnika ;
  49:  R[102]=(50) ;
  50:  CALL RG_VACON ;
  51:  IF (!F[25] OR !F[555] OR F[554]),JMP LBL[999] ;
  52:  R[98]=(R[191]) ;
  53:  F[645]=(ON) ;
  54:  CALL RM_RETRACT ;
  55:  IF (F[20]),R[179]=(350) ;
  56:  JMP LBL[999] ;
  57:  LBL[350] ;
  58:  ! Powrot wyrzutnika ;
  59:  F[634]=(OFF) ;
  60:  F[633]=(ON) ;
  61:  R[179]=(360) ;
  62:  JMP LBL[999] ;
  63:  LBL[360] ;
  64:  ! Wyjazd z formy ;
  65:  R[102]=(30) ;
  66:  IF (!F[563] OR !F[554] OR F[555]),JMP LBL[999] ;
  67:  CALL RM_IMMOUT ;
  68:  IF (F[20]),R[179]=(370) ;
  69:  JMP LBL[999] ;
  70:  LBL[370] ;
  71:  ! Zdarzenie pobrania partii ;
  72:  F[18]=(ON) ;
  73:  F[30]=(ON) ;
  74:  F[633]=(OFF) ;
  75:  F[636]=(OFF) ;
  76:  CALL RE_IMMPICK ;
  77:  R[179]=(380) ;
  78:  JMP LBL[999] ;
  79:  LBL[380] ;
  80:  ! ACK pobrania IMM ;
  81:  R[196]=(5) ;
  82:  R[102]=(70) ;
  83:  CALL RE_DONE ;
  84:  IF (F[23]),R[179]=(400) ;
  85:  JMP LBL[999] ;
  86:  LBL[9000] ;
  87:  IF (R[97]=0),R[97]=(1900) ;
  88:  F[16]=(ON) ;
  89:  R[179]=(900) ;
  90:  LBL[999] ;
/POS
/END
