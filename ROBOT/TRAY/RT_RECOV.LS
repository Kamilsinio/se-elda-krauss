  22:  IF (!(F[12] AND F[645])),R[97]=(1401) ;
  23:  IF (!(F[12] AND F[645])),JMP LBL[9000] ;
  24:  R[197]=(0) ;
  25:  R[191]=(0) ;
  26:  IF (R[186]<=1),R[197]=(R[197]+R[32]) ;
  27:  IF (R[186]<=1),R[191]=(R[191]+R[27]) ;
  28:  IF (R[186]<=2),R[197]=(R[197]+R[33]) ;
