  42:  IF (!(F[18] OR !F[17] OR (R[61]=R[183]))),R[97]=(1405) ;
  43:  IF (!(F[18] OR !F[17] OR (R[61]=R[183]))),JMP LBL[9000] ;
  44:  IF (!(F[18] OR (R[98]=0))),R[97]=(1406) ;
  45:  IF (!(F[18] OR (R[98]=0))),JMP LBL[9000] ;
  46:  IF (!(!F[17] OR F[18] OR F[560])),R[97]=(1407) ;
  47:  IF (!(!F[17] OR F[18] OR F[560])),JMP LBL[9000] ;
  48:  IF (!((R[185]<>0) OR (R[187]<R[37]*R[38]))),R[97]=(1408) ;
  49:  IF (!((R[185]<>0) OR (R[187]<R[37]*R[38]))),JMP LBL[9000] ;
