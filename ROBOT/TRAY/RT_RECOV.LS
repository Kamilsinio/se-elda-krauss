  34:  IF (R[186]<=5),R[197]=(R[197]+R[36]) ;
  35:  IF (R[186]<=5),R[191]=(R[191]+R[31]) ;
  36:  IF (!(!F[18] OR (R[185]=R[197]))),R[97]=(1402) ;
  37:  IF (!(!F[18] OR (R[185]=R[197]))),JMP LBL[9000] ;
  38:  IF (!(!F[18] OR (R[98]=R[191]))),R[97]=(1403) ;
  39:  IF (!(!F[18] OR (R[98]=R[191]))),JMP LBL[9000] ;
  40:  IF (!(!F[18] OR !F[560])),R[97]=(1404) ;
