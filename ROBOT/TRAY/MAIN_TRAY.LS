 745:  ! profil i ilosc sa zamrozone do ;
 746:  ! rozliczenia. ;
 747:  ! ON: opisany warunek/zadanie, ;
 748:  ! OFF: brak. ;
 749:  F[37:TProfilPartii]=(OFF) ;
 750:  ! F[39] - Robot rozpoczal ;
 751:  ! wejscie w zrodlo tacek i nie ;
 752:  ! potwierdzil wyjazdu. ;
 753:  ! ON: opisany warunek/zadanie, ;
 754:  ! OFF: brak. ;
 755:  F[39:TWZrodle]=(OFF) ;
 756:  ! F[40] - Robot rozpoczal ;
 757:  ! wejscie w winde i nie ;
 758:  ! potwierdzil wyjazdu. ON: ;
 759:  ! opisany warunek/zadanie, OFF: ;
 760:  ! brak. ;
 761:  F[40:TWWindzie]=(OFF) ;
