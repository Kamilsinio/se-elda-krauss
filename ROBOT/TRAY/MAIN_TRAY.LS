/PROG MAIN_TRAY
/ATTR
OWNER = MNEDITOR;
COMMENT = "Produkcja TRAY";
PROTECT = READ_WRITE;
DEFAULT_GROUP = 1,*,*,*,*;
CONTROL_CODE = 00000000 00000000;
/MN
   1:  ! Produkcja tacek i stosow ;
   2:  ! Robot zada - PLC wykonuje ;
   3:  ! Festo i EUROMAP ;
   4:  ! Komendy operatora: INIT APPLY ;
   5:  ! NEW RECOVERY EXIT ;
   6:  ! Nastawy S edytowane, A aktywne ;
   7:  ! po APPLY ;
   8:  ! Caly proces, ruchy i ;
   9:  ! rozliczenia sa ponizej ;
  10:  ! Pelna technologia w tym ;
  11:  ! programie ;
  12:  ! PLC wykonuje pneumatyke oraz ;
  13:  ! EUROMAP 67 ;
  14:  ! Start lokalny na robocie, ;
  15:  ! potem nowy Start PLC ;
  16:  ! Stop konczy rozpoczete ;
  17:  ! operacje oraz N+1 ;
  18:  ! Blad wymaga uzgodnienia stanu ;
  19:  ! i nowego Startu ;
  20:  ! Inicjalizacja wyboru programu ;
  21:  ! Przyjecie lokalnego wyboru ;
  22:  ! main i bazowego tokenu Start ;
  23:  CALL BG_BIND ;
  24:  ! F[14] - Main pozostaje ;
  25:  ! wybrany, FALSE konczy petle. ;
  26:  ! Nie jest natywnym ;
  27:  ! statusem pracy. ON: opisany ;
  28:  ! warunek/zadanie, OFF: brak. ;
  29:  F[14:TMainWybrany]=(ON) ;
  30:  ! F[15] - Przyjeto nowy fizyczny ;
  31:  ! Start, Stop rozbraja po ;
  32:  ! rozliczeniu ;
  33:  ! rozpoczetych operacji. ON: ;
  34:  ! opisany warunek/zadanie, OFF: ;
  35:  ! brak. ;
  36:  F[15:TUzbrojony]=(OFF) ;
  37:  ! F[38] - Po przyznaniu wyboru ;
  38:  ! main sprawdzil wejscie i ;
  39:  ! zapamietal zastany ;
  40:  ! token Start. ON: opisany ;
  41:  ! warunek/zadanie, OFF: brak. ;
  42:  F[38:TStartObsluz]=(OFF) ;
  43:  ! F[413] - MAIN_TRAY zada ;
  44:  ! lokalnego wyboru, nie wybor ;
  45:  ! programu przez PLC. ON ;
  46:  ! tak/zadanie, OFF nie. ;
  47:  F[413:WyborTRAY]=(ON) ;
  48:  LBL[1] ;
  49:  ! Obsluga operatora przy postoju ;
  50:  ! R[331] - Jedyny pisarz ;
  51:  ! BG_STATUS: 0 brak, 1 MAIN_BOX, ;
  52:  ! 2 MAIN_TRAY. Nie ;
  53:  ! wpisywac recznie. ;
  54:  IF ((R[331:WybranyMain]<>2) AND !F[413:WyborTRAY]),F[14:TMainWybrany]=(OFF) ;
  55:  IF (R[331:WybranyMain]<>2),JMP LBL[2] ;
  56:  ! F[1] - Jawne zadanie ;
  57:  ! wyzerowania prywatnej ;
  58:  ! konfiguracji/kontekstu przy ;
  59:  ! potwierdzonym pustym postoju. ;
  60:  ! ON: opisany warunek/zadanie, ;
  61:  ! OFF: brak. ;
  62:  IF (!F[1:TZezInit]),JMP LBL[1001] ;
  63:  ! F[409] - BG potwierdzil ;
  64:  ! zamkniete zlecenie, HOME i ;
  65:  ! rozliczone ;
  66:  ! kanaly/wtryski, roboczy ;
  67:  ! warunek przekazania wyboru. ON ;
  68:  ! tak/zadanie, OFF nie. ;
  69:  ! F[408] - Zatrzask: oba main ;
  70:  ! aktywne/paused albo oba ;
  71:  ! zglosily wybor. ON ;
  72:  ! tak/zadanie, OFF nie. ;
  73:  IF (!F[409:ZmianaDozw] OR F[408:KonfliktMain]),JMP LBL[1001] ;
  74:  ! F[5] - Operator potwierdzil ;
  75:  ! pusty postoj dla ;
  76:  ! INIT/APPLY/zmiany programu, ;
  77:  ! nie ;
  78:  ! automatyczny czujnik. ON: ;
  79:  ! opisany warunek/zadanie, OFF: ;
  80:  ! brak. ;
  81:  IF (F[15:TUzbrojony] OR !F[5:TStacjaPusta]),JMP LBL[1001] ;
  82:  ! F[17] - Zachowano cycleId, ;
  83:  ! ilosc i przeznaczenie partii, ;
  84:  ! nie przypisywac ;
  85:  ! ponownie. ON: opisany ;
  86:  ! warunek/zadanie, OFF: brak. ;
  87:  ! R[185] - Kontekst TRAY. ;
  88:  ! Pozostala do potwierdzonego ;
  89:  ! rozliczenia ilosc partii ;
  90:  ! [szt.], maleje po pelnym ;
  91:  ! ACK=0. ;
  92:  IF (F[17:TPartiaPrzyp] OR (R[185:TPozostalo]<>0)),JMP LBL[1001] ;
  93:  ! Jawna inicjalizacja prywatnych ;
  94:  ! danych przy pustym postoju ;
  95:  ! R[1] - Nastawa edytowana, ;
  96:  ! wymaga APPLY przy zamknietym ;
  97:  ! zleceniu i pustej ;
  98:  ! stacji. Maska grupy 1: bit ;
  99:  ! 0..4 = obwod prozni 1..5. ;
 100:  R[1:TSMaskG1]=(0) ;
 101:  ! R[2] - Nastawa edytowana, ;
 102:  ! wymaga APPLY przy zamknietym ;
 103:  ! zleceniu i pustej ;
 104:  ! stacji. Maska grupy 2: bit ;
 105:  ! 0..4 = obwod prozni 1..5. ;
 106:  R[2:TSMaskG2]=(0) ;
 107:  ! R[3] - Nastawa edytowana, ;
 108:  ! wymaga APPLY przy zamknietym ;
 109:  ! zleceniu i pustej ;
 110:  ! stacji. Maska grupy 3: bit ;
 111:  ! 0..4 = obwod prozni 1..5. ;
 112:  R[3:TSMaskG3]=(0) ;
 113:  ! R[4] - Nastawa edytowana, ;
 114:  ! wymaga APPLY przy zamknietym ;
 115:  ! zleceniu i pustej ;
 116:  ! stacji. Maska grupy 4: bit ;
 117:  ! 0..4 = obwod prozni 1..5. ;
 118:  R[4:TSMaskG4]=(0) ;
 119:  ! R[5] - Nastawa edytowana, ;
 120:  ! wymaga APPLY przy zamknietym ;
 121:  ! zleceniu i pustej ;
 122:  ! stacji. Maska grupy 5: bit ;
 123:  ! 0..4 = obwod prozni 1..5. ;
 124:  R[5:TSMaskG5]=(0) ;
 125:  ! R[6] - Nastawa edytowana, ;
 126:  ! wymaga APPLY przy zamknietym ;
 127:  ! zleceniu i pustej ;
 128:  ! stacji. Liczba detali grupy 1 ;
 129:  ! [szt.], niezalezna od ssawek i ;
 130:  ! obwodow. ;
 131:  R[6:TSSztG1]=(0) ;
 132:  ! R[7] - Nastawa edytowana, ;
 133:  ! wymaga APPLY przy zamknietym ;
 134:  ! zleceniu i pustej ;
 135:  ! stacji. Liczba detali grupy 2 ;
 136:  ! [szt.], niezalezna od ssawek i ;
 137:  ! obwodow. ;
 138:  R[7:TSSztG2]=(0) ;
 139:  ! R[8] - Nastawa edytowana, ;
 140:  ! wymaga APPLY przy zamknietym ;
 141:  ! zleceniu i pustej ;
 142:  ! stacji. Liczba detali grupy 3 ;
 143:  ! [szt.], niezalezna od ssawek i ;
 144:  ! obwodow. ;
 145:  R[8:TSSztG3]=(0) ;
 146:  ! R[9] - Nastawa edytowana, ;
 147:  ! wymaga APPLY przy zamknietym ;
 148:  ! zleceniu i pustej ;
 149:  ! stacji. Liczba detali grupy 4 ;
 150:  ! [szt.], niezalezna od ssawek i ;
 151:  ! obwodow. ;
 152:  R[9:TSSztG4]=(0) ;
 153:  ! R[10] - Nastawa edytowana, ;
 154:  ! wymaga APPLY przy zamknietym ;
 155:  ! zleceniu i pustej ;
 156:  ! stacji. Liczba detali grupy 5 ;
 157:  ! [szt.], niezalezna od ssawek i ;
 158:  ! obwodow. ;
 159:  R[10:TSSztG5]=(0) ;
 160:  ! R[11] - Nastawa edytowana, ;
 161:  ! wymaga APPLY przy zamknietym ;
 162:  ! zleceniu i pustej ;
 163:  ! stacji. Liczba pozycji osi X, ;
 164:  ! dodatnia liczba calkowita. ;
 165:  ! P2/P3: obie osie 0 ;
 166:  ! wylaczaja sekcje. ;
 167:  R[11:TSSiatkaX]=(0) ;
 168:  ! R[12] - Nastawa edytowana, ;
 169:  ! wymaga APPLY przy zamknietym ;
 170:  ! zleceniu i pustej ;
 171:  ! stacji. Liczba pozycji osi Y, ;
 172:  ! dodatnia liczba calkowita. ;
 173:  ! P2/P3: obie osie 0 ;
 174:  ! wylaczaja sekcje. ;
 175:  R[12:TSSiatkaY]=(0) ;
 176:  ! R[13] - Nastawa edytowana, ;
 177:  ! wymaga APPLY przy zamknietym ;
 178:  ! zleceniu i pustej ;
 179:  ! stacji. Skok pozycji po X ;
 180:  ! UFRAME [mm], moze byc ujemny. ;
 181:  R[13:TSSkokX_mm]=(0) ;
 182:  ! R[14] - Nastawa edytowana, ;
 183:  ! wymaga APPLY przy zamknietym ;
 184:  ! zleceniu i pustej ;
 185:  ! stacji. Skok rzedow po Y ;
 186:  ! UFRAME [mm], moze byc ujemny. ;
 187:  R[14:TSSkokY_mm]=(0) ;
 188:  ! R[15] - Nastawa edytowana, ;
 189:  ! wymaga APPLY przy zamknietym ;
 190:  ! zleceniu i pustej ;
 191:  ! stacji. TRAY: wysokosc tacki ;
 192:  ! [mm]. BOX: przyrost Z warstwy ;
 193:  ! razem z ;
 194:  ! przekladka [mm]. ;
 195:  R[15:TSSkokZ_mm]=(0) ;
 196:  ! R[16] - Nastawa edytowana, ;
 197:  ! wymaga APPLY przy zamknietym ;
 198:  ! zleceniu i pustej ;
 199:  ! stacji. TRAY: liczba tacek w ;
 200:  ! stosie. BOX: liczba warstw ;
 201:  ! pojemnika, minimum ;
 202:  ! 1. ;
 203:  R[16:TSWarstwMax]=(0) ;
 204:  ! R[17] - Nastawa edytowana, ;
 205:  ! wymaga APPLY przy zamknietym ;
 206:  ! zleceniu i pustej ;
 207:  ! stacji. Dodatni krok szukania ;
 208:  ! pustej tacki/przekladki po ;
 209:  ! ujemnym Z UFRAME ;
 210:  ! [mm]. ;
 211:  R[17:TSSzukKrok_mm]=(0) ;
 212:  ! R[18] - Nastawa edytowana, ;
 213:  ! wymaga APPLY przy zamknietym ;
 214:  ! zleceniu i pustej ;
 215:  ! stacji. Maksymalne dopuszczone ;
 216:  ! zejscie podczas szukania [mm]. ;
 217:  R[18:TSSzukMax_mm]=(0) ;
 218:  ! R[19] - Nastawa edytowana, ;
 219:  ! wymaga APPLY przy zamknietym ;
 220:  ! zleceniu i pustej ;
 221:  ! stacji. Maksymalna liczba ;
 222:  ! krokow szukania, przekroczenie ;
 223:  ! jest bledem. ;
 224:  R[19:TSSzukProbMax]=(0) ;
 225:  ! R[20] - Nastawa edytowana, ;
 226:  ! wymaga APPLY przy zamknietym ;
 227:  ! zleceniu i pustej ;
 228:  ! stacji. Limit predkosci: J w ;
 229:  ! procentach, L w mm/s, zakres ;
 230:  ! 1..100. ;
 231:  R[20:TSPredkosc]=(0) ;
 232:  ! R[21] - Nastawa edytowana, ;
 233:  ! wymaga APPLY przy zamknietym ;
 234:  ! zleceniu i pustej ;
 235:  ! stacji. Limit oczekiwania ;
 236:  ! chwytaka, IMM i ACK [surowe ;
 237:  ! ticki zegara]. ;
 238:  R[21:TSCzasMax_t]=(0) ;
 239:  ! R[22] - Nastawa edytowana, ;
 240:  ! wymaga APPLY przy zamknietym ;
 241:  ! zleceniu i pustej ;
 242:  ! stacji. Numer zatwierdzonego ;
 243:  ! UTOOL, nie zawiera danych TCP. ;
 244:  R[22:TSNrNarzedzia]=(0) ;
 245:  ! R[23] - Nastawa edytowana, ;
 246:  ! wymaga APPLY przy zamknietym ;
 247:  ! zleceniu i pustej ;
 248:  ! stacji. Numer zatwierdzonego ;
 249:  ! UFRAME, nie zawiera danych ;
 250:  ! geometrii ukladu. ;
 251:  R[23:TSNrUkladu]=(0) ;
 252:  ! R[24] - Nastawa edytowana, ;
 253:  ! wymaga APPLY przy zamknietym ;
 254:  ! zleceniu i pustej ;
 255:  ! stacji. Cele silownikow do ;
 256:  ! przejazdu i pustego nosnika. ;
 257:  ! Bity 0..4 HOME ;
 258:  ! V501..505, 5..9 WORK, para 00 ;
 259:  ! pomija, 11 blad. ;
 260:  R[24:TSCylPrzejazd]=(0) ;
 261:  ! R[25] - Nastawa edytowana, ;
 262:  ! wymaga APPLY przy zamknietym ;
 263:  ! zleceniu i pustej ;
 264:  ! stacji. Cele silownikow do ;
 265:  ! pobrania IMM. Bity 0..4 HOME ;
 266:  ! V501..505, 5..9 ;
 267:  ! WORK, para 00 pomija, 11 blad. ;
 268:  R[25:TSCylIMM]=(0) ;
 269:  ! R[26] - Nastawa edytowana, ;
 270:  ! wymaga APPLY przy zamknietym ;
 271:  ! zleceniu i pustej ;
 272:  ! stacji. Obwody pustej tacki ;
 273:  ! TRAY / przekladki BOX. Bit ;
 274:  ! 0..4 = proznia 1..5, ;
 275:  ! maska rozlaczna z produktami. ;
 276:  R[26:TSMaskaPusta]=(0) ;
 277:  ! R[27] - Aktywna kopia po ;
 278:  ! APPLY, nie edytowac podczas ;
 279:  ! produkcji. Maska grupy ;
 280:  ! 1: bit 0..4 = obwod prozni ;
 281:  ! 1..5. ;
 282:  R[27:TAMaskG1]=(0) ;
 283:  ! R[28] - Aktywna kopia po ;
 284:  ! APPLY, nie edytowac podczas ;
 285:  ! produkcji. Maska grupy ;
 286:  ! 2: bit 0..4 = obwod prozni ;
 287:  ! 1..5. ;
 288:  R[28:TAMaskG2]=(0) ;
 289:  ! R[29] - Aktywna kopia po ;
 290:  ! APPLY, nie edytowac podczas ;
 291:  ! produkcji. Maska grupy ;
 292:  ! 3: bit 0..4 = obwod prozni ;
 293:  ! 1..5. ;
 294:  R[29:TAMaskG3]=(0) ;
 295:  ! R[30] - Aktywna kopia po ;
 296:  ! APPLY, nie edytowac podczas ;
 297:  ! produkcji. Maska grupy ;
 298:  ! 4: bit 0..4 = obwod prozni ;
 299:  ! 1..5. ;
 300:  R[30:TAMaskG4]=(0) ;
 301:  ! R[31] - Aktywna kopia po ;
 302:  ! APPLY, nie edytowac podczas ;
 303:  ! produkcji. Maska grupy ;
 304:  ! 5: bit 0..4 = obwod prozni ;
 305:  ! 1..5. ;
 306:  R[31:TAMaskG5]=(0) ;
 307:  ! R[32] - Aktywna kopia po ;
 308:  ! APPLY, nie edytowac podczas ;
 309:  ! produkcji. Liczba ;
 310:  ! detali grupy 1 [szt.], ;
 311:  ! niezalezna od ssawek i ;
 312:  ! obwodow. ;
 313:  R[32:TASztG1]=(0) ;
 314:  ! R[33] - Aktywna kopia po ;
 315:  ! APPLY, nie edytowac podczas ;
 316:  ! produkcji. Liczba ;
 317:  ! detali grupy 2 [szt.], ;
 318:  ! niezalezna od ssawek i ;
 319:  ! obwodow. ;
 320:  R[33:TASztG2]=(0) ;
 321:  ! R[34] - Aktywna kopia po ;
 322:  ! APPLY, nie edytowac podczas ;
 323:  ! produkcji. Liczba ;
 324:  ! detali grupy 3 [szt.], ;
 325:  ! niezalezna od ssawek i ;
 326:  ! obwodow. ;
 327:  R[34:TASztG3]=(0) ;
 328:  ! R[35] - Aktywna kopia po ;
 329:  ! APPLY, nie edytowac podczas ;
 330:  ! produkcji. Liczba ;
 331:  ! detali grupy 4 [szt.], ;
 332:  ! niezalezna od ssawek i ;
 333:  ! obwodow. ;
 334:  R[35:TASztG4]=(0) ;
 335:  ! R[36] - Aktywna kopia po ;
 336:  ! APPLY, nie edytowac podczas ;
 337:  ! produkcji. Liczba ;
 338:  ! detali grupy 5 [szt.], ;
 339:  ! niezalezna od ssawek i ;
 340:  ! obwodow. ;
 341:  R[36:TASztG5]=(0) ;
 342:  ! R[37] - Aktywna kopia po ;
 343:  ! APPLY, nie edytowac podczas ;
 344:  ! produkcji. Liczba ;
 345:  ! pozycji osi X, dodatnia liczba ;
 346:  ! calkowita. P2/P3: obie osie 0 ;
 347:  ! wylaczaja ;
 348:  ! sekcje. ;
 349:  R[37:TASiatkaX]=(0) ;
 350:  ! R[38] - Aktywna kopia po ;
 351:  ! APPLY, nie edytowac podczas ;
 352:  ! produkcji. Liczba ;
 353:  ! pozycji osi Y, dodatnia liczba ;
 354:  ! calkowita. P2/P3: obie osie 0 ;
 355:  ! wylaczaja ;
 356:  ! sekcje. ;
 357:  R[38:TASiatkaY]=(0) ;
 358:  ! R[39] - Aktywna kopia po ;
 359:  ! APPLY, nie edytowac podczas ;
 360:  ! produkcji. Skok pozycji ;
 361:  ! po X UFRAME [mm], moze byc ;
 362:  ! ujemny. ;
 363:  R[39:TASkokX_mm]=(0) ;
 364:  ! R[40] - Aktywna kopia po ;
 365:  ! APPLY, nie edytowac podczas ;
 366:  ! produkcji. Skok rzedow ;
 367:  ! po Y UFRAME [mm], moze byc ;
 368:  ! ujemny. ;
 369:  R[40:TASkokY_mm]=(0) ;
 370:  ! R[41] - Aktywna kopia po ;
 371:  ! APPLY, nie edytowac podczas ;
 372:  ! produkcji. TRAY: ;
 373:  ! wysokosc tacki [mm]. BOX: ;
 374:  ! przyrost Z warstwy razem z ;
 375:  ! przekladka [mm]. ;
 376:  R[41:TASkokZ_mm]=(0) ;
 377:  ! R[42] - Aktywna kopia po ;
 378:  ! APPLY, nie edytowac podczas ;
 379:  ! produkcji. TRAY: liczba ;
 380:  ! tacek w stosie. BOX: liczba ;
 381:  ! warstw pojemnika, minimum 1. ;
 382:  R[42:TAWarstwMax]=(0) ;
 383:  ! R[43] - Aktywna kopia po ;
 384:  ! APPLY, nie edytowac podczas ;
 385:  ! produkcji. Dodatni krok ;
 386:  ! szukania pustej ;
 387:  ! tacki/przekladki po ujemnym Z ;
 388:  ! UFRAME [mm]. ;
 389:  R[43:TASzukKrok_mm]=(0) ;
 390:  ! R[44] - Aktywna kopia po ;
 391:  ! APPLY, nie edytowac podczas ;
 392:  ! produkcji. Maksymalne ;
 393:  ! dopuszczone zejscie podczas ;
 394:  ! szukania [mm]. ;
 395:  R[44:TASzukMax_mm]=(0) ;
 396:  ! R[45] - Aktywna kopia po ;
 397:  ! APPLY, nie edytowac podczas ;
 398:  ! produkcji. Maksymalna ;
 399:  ! liczba krokow szukania, ;
 400:  ! przekroczenie jest bledem. ;
 401:  R[45:TASzukProbMax]=(0) ;
 402:  ! R[46] - Aktywna kopia po ;
 403:  ! APPLY, nie edytowac podczas ;
 404:  ! produkcji. Limit ;
 405:  ! predkosci: J w procentach, L w ;
 406:  ! mm/s, zakres 1..100. ;
 407:  R[46:TAPredkosc]=(0) ;
 408:  ! R[47] - Aktywna kopia po ;
 409:  ! APPLY, nie edytowac podczas ;
 410:  ! produkcji. Limit ;
 411:  ! oczekiwania chwytaka, IMM i ;
 412:  ! ACK [surowe ticki zegara]. ;
 413:  R[47:TACzasMax_t]=(0) ;
 414:  ! R[48] - Aktywna kopia po ;
 415:  ! APPLY, nie edytowac podczas ;
 416:  ! produkcji. Numer ;
 417:  ! zatwierdzonego UTOOL, nie ;
 418:  ! zawiera danych TCP. ;
 419:  R[48:TANrNarzedzia]=(0) ;
 420:  ! R[49] - Aktywna kopia po ;
 421:  ! APPLY, nie edytowac podczas ;
 422:  ! produkcji. Numer ;
 423:  ! zatwierdzonego UFRAME, nie ;
 424:  ! zawiera danych geometrii ;
 425:  ! ukladu. ;
 426:  R[49:TANrUkladu]=(0) ;
 427:  ! R[50] - Aktywna kopia po ;
 428:  ! APPLY, nie edytowac podczas ;
 429:  ! produkcji. Cele ;
 430:  ! silownikow do przejazdu i ;
 431:  ! pustego nosnika. Bity 0..4 ;
 432:  ! HOME V501..505, 5..9 ;
 433:  ! WORK, para 00 pomija, 11 blad. ;
 434:  R[50:TACylPrzejazd]=(0) ;
 435:  ! R[177] - Aktywna kopia po ;
 436:  ! APPLY, nie edytowac podczas ;
 437:  ! produkcji. Cele ;
 438:  ! silownikow do pobrania IMM. ;
 439:  ! Bity 0..4 HOME V501..505, 5..9 ;
 440:  ! WORK, para 00 ;
 441:  ! pomija, 11 blad. ;
 442:  R[177:TACylIMM]=(0) ;
 443:  ! R[178] - Aktywna kopia po ;
 444:  ! APPLY, nie edytowac podczas ;
 445:  ! produkcji. Obwody ;
 446:  ! pustej tacki TRAY / przekladki ;
 447:  ! BOX. Bit 0..4 = proznia 1..5, ;
 448:  ! maska rozlaczna ;
 449:  ! z produktami. ;
 450:  R[178:TAMaskaPusta]=(0) ;
 451:  ! R[179] - Kontekst TRAY. Krok ;
 452:  ! technologii: 10 gotowosc, ;
 453:  ! 200..299 pusty ;
 454:  ! nosnik, 300..399 IMM, 400..499 ;
 455:  ! produkty, 500..699 pelny ;
 456:  ! ladunek/przekladki, ;
 457:  ! 700 powrot HOME, 710 postoj, ;
 458:  ! 900 recovery. ;
 459:  R[179:TKrok]=(0) ;
 460:  ! R[180] - Kontekst TRAY. ;
 461:  ! Zapamietany krok wybrany w tej ;
 462:  ! iteracji, nie jest ;
 463:  ! kodem bledu. ;
 464:  R[180:TKrokWybrany]=(0) ;
 465:  ! R[181] - Kontekst TRAY. ;
 466:  ! Poprzedni krok do wykrycia ;
 467:  ! zmiany i rozpoczecia ;
 468:  ! pomiaru czasu. ;
 469:  R[181:TKrokPoprz]=(0) ;
 470:  ! R[182] - Kontekst TRAY. Czas ;
 471:  ! wejscia w krok [surowe ticki ;
 472:  ! zegara], jednostke ;
 473:  ! zmierzyc na V9.40. ;
 474:  R[182:TKrokOd_t]=(0) ;
 475:  ! R[183] - Kontekst TRAY. ;
 476:  ! Identyfikator przypisanej ;
 477:  ! partii z PLC, zachowany do ;
 478:  ! rozliczenia. ;
 479:  R[183:TNrCykluIMM]=(0) ;
 480:  ! R[184] - Kontekst TRAY. Liczba ;
 481:  ! detali przypisana do calej ;
 482:  ! partii IMM [szt.], ;
 483:  ! zachowana mimo edycji nastaw. ;
 484:  R[184:TIloscPartii]=(0) ;
 485:  R[185:TPozostalo]=(0) ;
 486:  ! R[186] - Kontekst TRAY. ;
 487:  ! Kolejna grupa odkladania 1..5, ;
 488:  ! 6 przechodzi do ;
 489:  ! rozliczenia partii. ;
 490:  R[186:TGrupa]=(0) ;
 491:  ! R[187] - Kontekst TRAY. Indeks ;
 492:  ! pozycji od 0, X najszybciej, ;
 493:  ! jedna pozycja na ;
 494:  ! grupe, nie na sztuke. ;
 495:  R[187:TPozycja]=(0) ;
 496:  ! R[188] - Kontekst TRAY. Indeks ;
 497:  ! od 0: tacki w stosie TRAY albo ;
 498:  ! warstwy ;
 499:  ! pojemnika BOX. ;
 500:  R[188:TWarstwa]=(0) ;
 501:  ! R[189] - Kontekst TRAY. ;
 502:  ! Identyfikator aktualnego stosu ;
 503:  ! TRAY / pojemnika BOX ;
 504:  ! przypisany przez PLC. ;
 505:  R[189:TNrLadunku]=(0) ;
 506:  ! R[190] - Kontekst TRAY. ;
 507:  ! Ostatnio widziany startToken ;
 508:  ! PLC 0..65535, zastany ;
 509:  ! token nie uruchamia. ;
 510:  R[190:TStartPoprz]=(0) ;
 511:  ! R[191] - Kontekst TRAY. Maska ;
 512:  ! biezacej operacji, bit 0..4 = ;
 513:  ! obwod prozni ;
 514:  ! 1..5. ;
 515:  R[191:TMaskaOper]=(0) ;
 516:  ! R[192] - Kontekst TRAY. Liczba ;
 517:  ! detali biezacej grupy [szt.], ;
 518:  ! przekazywana do ;
 519:  ! zdarzenia odlozenia. ;
 520:  R[192:TIloscGrupy]=(0) ;
 521:  ! R[193] - Kontekst TRAY. ;
 522:  ! Dotychczasowe zejscie od ;
 523:  ! poczatku szukania pustego ;
 524:  ! nosnika [mm Z]. ;
 525:  R[193:TSzukGleb_mm]=(0) ;
 526:  ! R[194] - Kontekst TRAY. Liczba ;
 527:  ! wykonanych krokow szukania ;
 528:  ! pustej ;
 529:  ! tacki/przekladki. ;
 530:  R[194:TSzukProba]=(0) ;
 531:  ! R[195] - Kontekst TRAY. ;
 532:  ! Przeznaczenie calej partii: 0 ;
 533:  ! dobre, 1 probki, 2 ;
 534:  ! odrzuty do miejsca probek. ;
 535:  R[195:TCelPartii]=(0) ;
 536:  ! R[196] - Kontekst TRAY. Liczba ;
 537:  ! robocza: rodzina = krok DIV ;
 538:  ! 100 albo kanal ;
 539:  ! ACK: 1 pobr.tacki, 2 ;
 540:  ! odl.tacki, 3 pelna tacka, 4 ;
 541:  ! pelny ladunek, 5 IMM, 6 ;
 542:  ! dobre, 7 probki, 8 odrzuty, 9 ;
 543:  ! warstwa BOX, 10 przekladka ;
 544:  ! BOX. ;
 545:  R[196:TPomLiczba]=(0) ;
 546:  ! R[197] - Kontekst TRAY. ;
 547:  ! Robocza suma ilosci lub masek ;
 548:  ! w ;
 549:  ! przypisaniu/recovery, nie ;
 550:  ! licznik produkcji. ;
 551:  R[197:TSumaPom]=(0) ;
 552:  ! R[198] - Kontekst TRAY. BOX: ;
 553:  ! cele silownikow aktywnej ;
 554:  ! grupy, bity HOME 0..4 ;
 555:  ! i WORK 5..9. TRAY: rezerwa ;
 556:  ! nieuzywana w procesie. ;
 557:  R[198:TCelCylGrupy]=(0) ;
 558:  ! R[199] - Kontekst TRAY. Liczba ;
 559:  ! aktywnych grup, pojemnosc ;
 560:  ! sekcji/tacki jest ;
 561:  ! jej wielokrotnoscia. ;
 562:  R[199:TGrupAktyw]=(0) ;
 563:  ! R[200] - Kontekst TRAY. Krok ;
 564:  ! przed wejsciem w recovery, ;
 565:  ! diagnostyka, nie ;
 566:  ! automatyczne wznowienie. ;
 567:  R[200:TKrokPrzerw]=(0) ;
 568:  F[1:TZezInit]=(OFF) ;
 569:  ! F[2] - Jawna deklaracja nowego ;
 570:  ! pustego kontekstu po ;
 571:  ! oproznieniu i ;
 572:  ! uzgodnieniu stacji. ON: ;
 573:  ! opisany warunek/zadanie, OFF: ;
 574:  ! brak. ;
 575:  F[2:TNowyKontekst]=(OFF) ;
 576:  ! F[3] - Zgoda operatora na ;
 577:  ! uzgodnienie recovery i ;
 578:  ! kasowanie alarmu, sama nie ;
 579:  ! dopuszcza ruchu. ON: opisany ;
 580:  ! warunek/zadanie, OFF: brak. ;
 581:  F[3:TZezRecovery]=(OFF) ;
 582:  ! F[4] - Operator sprawdzil ;
 583:  ! ladunek i rozliczenia PLC oraz ;
 584:  ! uzgodnil kontekst. ;
 585:  ! ON: opisany warunek/zadanie, ;
 586:  ! OFF: brak. ;
 587:  F[4:TStanSprawdz]=(OFF) ;
 588:  F[5:TStacjaPusta]=(OFF) ;
 589:  ! F[6] - Odebrano fizyczny ;
 590:  ! profil chwytaka, maski i cele ;
 591:  ! HOME/WORK. ON: ;
 592:  ! opisany warunek/zadanie, OFF: ;
 593:  ! brak. ;
 594:  F[6:TProfilOK]=(OFF) ;
 595:  ! F[7] - Odebrano trajektorie i ;
 596:  ! geometrie tej produkcji na ;
 597:  ! wlasciwym robocie. ;
 598:  ! ON: opisany warunek/zadanie, ;
 599:  ! OFF: brak. ;
 600:  F[7:TDrogiOK]=(OFF) ;
 601:  ! F[8] - Odebrano rzeczywiste ;
 602:  ! zatrzymanie zadania ruchowego ;
 603:  ! przez reakcje ;
 604:  ! alarmowa. ON: opisany ;
 605:  ! warunek/zadanie, OFF: brak. ;
 606:  F[8:TAlarmOdebr]=(OFF) ;
 607:  ! F[12] - Przyjeto aktywna kopie ;
 608:  ! nastaw, staging nie jest ;
 609:  ! uzywany do ruchu. ;
 610:  ! ON: opisany warunek/zadanie, ;
 611:  ! OFF: brak. ;
 612:  F[12:TNastawyOK]=(OFF) ;
 613:  ! F[13] - Roboczy wynik ;
 614:  ! walidacji staging, FALSE ;
 615:  ! oznacza blednego kandydata. ;
 616:  ! ON: opisany warunek/zadanie, ;
 617:  ! OFF: brak. ;
 618:  F[13:TKandydatOK]=(OFF) ;
 619:  F[15:TUzbrojony]=(OFF) ;
 620:  ! F[16] - Zatrzask ;
 621:  ! niespojnego/przerwanego ;
 622:  ! procesu, blokuje ruch do ;
 623:  ! jawnego ;
 624:  ! uzgodnienia. ON: opisany ;
 625:  ! warunek/zadanie, OFF: brak. ;
 626:  F[16:TUzgodnijStan]=(OFF) ;
 627:  F[17:TPartiaPrzyp]=(OFF) ;
 628:  ! F[18] - Potwierdzono pobranie ;
 629:  ! partii i wyjazd z formy, ;
 630:  ! pozostale grupy ;
 631:  ! wymagaja odlozenia. ON: ;
 632:  ! opisany warunek/zadanie, OFF: ;
 633:  ! brak. ;
 634:  F[18:TPartiaPobr]=(OFF) ;
 635:  ! F[19] - TRAY: pusta tacka ;
 636:  ! odlozona. BOX: PLC potwierdzil ;
 637:  ! przygotowany ;
 638:  ! pojemnik. ON: opisany ;
 639:  ! warunek/zadanie, OFF: brak. ;
 640:  F[19:TNosnikGotow]=(OFF) ;
 641:  ! F[20] - Ukonczono instrukcje ;
 642:  ! ruchu operacji, zerowane przed ;
 643:  ! nowym ruchem. ;
 644:  ! ON: opisany warunek/zadanie, ;
 645:  ! OFF: brak. ;
 646:  F[20:TRuchGotowy]=(OFF) ;
 647:  ! F[21] - Roboczy wynik blokad ;
 648:  ! ruchu lub walidacji, nie ;
 649:  ! funkcja ;
 650:  ! bezpieczenstwa. ON: opisany ;
 651:  ! warunek/zadanie, OFF: brak. ;
 652:  F[21:TRuchDozw]=(OFF) ;
 653:  ! F[22] - Roboczy BOOL ;
 654:  ! dokonczenia IMM lub walidacji ;
 655:  ! kodu silownika, nie ;
 656:  ! sygnal czujnika. ON: opisany ;
 657:  ! warunek/zadanie, OFF: brak. ;
 658:  F[22:TWarPom]=(OFF) ;
 659:  ! F[23] - Kanal zakonczyl caly ;
 660:  ! REQ/ACK, ma sukces i ACK=0. ;
 661:  ! ON: opisany ;
 662:  ! warunek/zadanie, OFF: brak. ;
 663:  F[23:TZdarzGotowe]=(OFF) ;
 664:  ! F[24] - Cele silownikow wazne, ;
 665:  ! zaakceptowane i osiagniete bez ;
 666:  ! przeciwnej ;
 667:  ! krancowki. ON: opisany ;
 668:  ! warunek/zadanie, OFF: brak. ;
 669:  F[24:TCylGotowe]=(OFF) ;
 670:  ! F[25] - Wybrane obwody maja ;
 671:  ! wazne potwierdzenie przyjecia, ;
 672:  ! wlaczenia i ;
 673:  ! osiagniecia prozni. ON: ;
 674:  ! opisany warunek/zadanie, OFF: ;
 675:  ! brak. ;
 676:  F[25:TProzniaOK]=(OFF) ;
 677:  ! F[26] - Wybrane przedmuchy ;
 678:  ! zakonczyly ACK z sukcesem i ;
 679:  ! proznia zanikla. ON: ;
 680:  ! opisany warunek/zadanie, OFF: ;
 681:  ! brak. ;
 682:  F[26:TZwolnGotowe]=(OFF) ;
