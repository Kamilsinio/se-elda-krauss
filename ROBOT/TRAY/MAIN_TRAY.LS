 763:  ! wybranej maski, inne niesione ;
 764:  ! obwody nadal ;
 765:  ! monitorowane. ON: opisany ;
 766:  ! warunek/zadanie, OFF: brak. ;
 767:  F[41:TZwalnianie]=(OFF) ;
