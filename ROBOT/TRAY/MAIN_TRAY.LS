 726:  ! timeout, aktualnie kod/miejsce ;
 727:  ! w ;
 728:  ! faultCode/resumeState. ON: ;
 729:  ! opisany warunek/zadanie, OFF: ;
 730:  ! brak. ;
 731:  F[34:TRezCzasBlad]=(OFF) ;
