 733:  ! maski, aktualnie uzywany ;
 734:  ! candidateValid. ON: ;
 735:  ! opisany warunek/zadanie, OFF: ;
 736:  ! brak. ;
 737:  F[35:TRezMaskaOK]=(OFF) ;
