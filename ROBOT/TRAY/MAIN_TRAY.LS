 684:  ! wyjazd poza zrodlo tacek, ;
 685:  ! wymaga aktualnego ;
 686:  ! AUTO/statusu. ON: opisany ;
 687:  ! warunek/zadanie, OFF: brak. ;
 688:  F[27:TPozaZrodlem]=(OFF) ;
 689:  ! F[28] - Program potwierdzil ;
 690:  ! wyjazd poza winde, przy ;
 691:  ! bledzie uniewazniane. ;
 692:  ! ON: opisany warunek/zadanie, ;
 693:  ! OFF: brak. ;
 694:  F[28:TPozaWinda]=(OFF) ;
 695:  ! F[29] - Program potwierdzil ;
 696:  ! wyjazd poza magazyn ;
 697:  ! przekladek, przy bledzie ;
 698:  ! uniewazniane. ON: opisany ;
 699:  ! warunek/zadanie, OFF: brak. ;
 700:  F[29:TPozaMagaz]=(OFF) ;
 701:  ! F[30] - Program potwierdzil ;
 702:  ! wyjazd poza IMM, potrzebne do ;
 703:  ! pozwolenia ;
 704:  ! zamkniecia formy. ON: opisany ;
 705:  ! warunek/zadanie, OFF: brak. ;
 706:  F[30:TPozaForma]=(OFF) ;
 707:  ! F[31] - Krok jest w zakresie ;
 708:  ! 200..699, wskaznik trwajacej ;
 709:  ! operacji dla BG. ;
 710:  ! ON: opisany warunek/zadanie, ;
 711:  ! OFF: brak. ;
 712:  F[31:TOperacjaTrwa]=(OFF) ;
 713:  ! F[32] - Stan stacji zabronil ;
 714:  ! APPLY, aktywne nastawy nie ;
