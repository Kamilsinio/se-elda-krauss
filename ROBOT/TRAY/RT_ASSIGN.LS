/PROG RT_ASSIGN
/ATTR
OWNER = MNEDITOR;
COMMENT = "Krauss tacki";
PROTECT = READ_WRITE;
DEFAULT_GROUP = *,*,*,*,*;
CONTROL_CODE = 00000000 00000000;
/MN
   1:  R[197]=(0) ;
   2:  R[199]=(0) ;
   3:  R[197]=(R[197]+R[32]) ;
   4:  IF (R[32]>0),R[199]=(R[199]+1) ;
   5:  R[197]=(R[197]+R[33]) ;
   6:  IF (R[33]>0),R[199]=(R[199]+1) ;
   7:  R[197]=(R[197]+R[34]) ;
   8:  IF (R[34]>0),R[199]=(R[199]+1) ;
   9:  R[197]=(R[197]+R[35]) ;
  10:  IF (R[35]>0),R[199]=(R[199]+1) ;
  11:  R[197]=(R[197]+R[36]) ;
  12:  IF (R[36]>0),R[199]=(R[199]+1) ;
  13:  IF (!(F[553] AND F[560])),R[97]=(1301) ;
  14:  IF (!(F[553] AND F[560])),JMP LBL[9000] ;
  15:  IF (!((R[77]=R[197]) AND (R[197]>0))),R[97]=(1302) ;
  16:  IF (!((R[77]=R[197]) AND (R[197]>0))),JMP LBL[9000] ;
  17:  IF (!(F[12] AND !F[17])),R[97]=(1303) ;
  18:  IF (!(F[12] AND !F[17])),JMP LBL[9000] ;
  19:  R[183]=(R[61]) ;
  20:  R[184]=(R[77]) ;
  21:  R[185]=(R[77]) ;
  22:  R[195]=(0) ;
  23:  R[186]=(1) ;
  24:  F[17]=(ON) ;
  25:  F[18]=(OFF) ;
  26:  F[37]=(ON) ;
  27:  IF (F[561]),R[195]=(2) ;
  28:  IF ((R[195]=0) AND (R[143]=10)),R[195]=(1) ;
  29:  IF ((R[195]=1) AND (R[143]=10)),R[103]=(1) ;
  30:  IF ((R[195]=1) AND (R[143]=10)),F[655]=(ON) ;
  31:  IF ((R[195]=2) AND (R[143]=10)),R[103]=(2) ;
  32:  IF ((R[195]=2) AND (R[143]=10)),F[655]=(ON) ;
  33:  JMP LBL[999] ;
  34:  LBL[9000] ;
  35:  F[16]=(ON) ;
  36:  F[759]=(ON) ;
  37:  R[179]=(900) ;
  38:  LBL[999] ;
/POS
/END
