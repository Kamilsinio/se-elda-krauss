/PROG RT_PLACE
/ATTR
OWNER = MNEDITOR;
COMMENT = "Krauss tacki";
PROTECT = READ_WRITE;
DEFAULT_GROUP = *,*,*,*,*;
CONTROL_CODE = 00000000 00000000;
/MN
   1:  IF (R[180]=400),JMP LBL[400] ;
   2:  IF (R[180]=412),JMP LBL[412] ;
   3:  IF (R[180]=410),JMP LBL[410] ;
   4:  IF (R[180]=415),JMP LBL[415] ;
   5:  IF (R[180]=420),JMP LBL[420] ;
   6:  IF (R[180]=430),JMP LBL[430] ;
   7:  IF (R[180]=440),JMP LBL[440] ;
   8:  IF (R[180]=450),JMP LBL[450] ;
   9:  IF (R[180]=460),JMP LBL[460] ;
  10:  IF (R[180]=470),JMP LBL[470] ;
  11:  IF (R[180]=480),JMP LBL[480] ;
  12:  IF (R[180]=485),JMP LBL[485] ;
  13:  IF (R[180]=490),JMP LBL[490] ;
  14:  CALL RT_BADSTATE ;
  15:  JMP LBL[999] ;
  16:  LBL[400] ;
  17:  ! Wybor kolejnej grupy ;
  18:  CALL RT_GROUP ;
  19:  IF (R[186]>5),R[179]=(490) ;
  20:  IF (R[186]>5),JMP LBL[999] ;
  21:  IF (R[192]=0),R[186]=(R[186]+1) ;
  22:  IF (R[192]=0),JMP LBL[999] ;
  23:  IF (R[195]=0),R[179]=(410) ;
  24:  IF (R[195]<>0),R[179]=(415) ;
  25:  JMP LBL[999] ;
  26:  LBL[412] ;
  27:  ! Oczekiwanie na dostep do windy ;
  28:  R[102]=(60) ;
  29:  IF (F[503] AND F[501]),R[179]=(420) ;
  30:  JMP LBL[999] ;
  31:  LBL[410] ;
  32:  ! Zadanie dostepu do odkladania ;
  33:  F[28]=(OFF) ;
  34:  F[608]=(ON) ;
  35:  R[179]=(412) ;
  36:  JMP LBL[999] ;
  37:  LBL[415] ;
  38:  ! Droga do probek lub odrzutow ;
  39:  CALL RG_FOLD ;
  40:  IF (!F[24]),JMP LBL[999] ;
  41:  CALL RM_SAMPLEIN ;
  42:  IF (F[20]),R[179]=(430) ;
  43:  JMP LBL[999] ;
  44:  LBL[420] ;
  45:  ! Dojazd nad tacke ;
  46:  R[102]=(60) ;
  47:  CALL RG_FOLD ;
  48:  IF (!F[24] OR !F[503] OR !F[501]),JMP LBL[999] ;
  49:  F[40]=(ON) ;
  50:  CALL RM_PLACEIN ;
  51:  IF (F[20]),R[179]=(430) ;
  52:  JMP LBL[999] ;
  53:  LBL[430] ;
  54:  ! Pozycja odlozenia grupy ;
  55:  CALL RT_OFFSET ;
  56:  IF (!((R[195]<>0) OR (R[187]<R[37]*R[38]))),R[97]=(1601) ;
  57:  IF (!((R[195]<>0) OR (R[187]<R[37]*R[38]))),JMP LBL[9000] ;
  58:  IF ((R[186]=1) AND (R[195]=0)),CALL RM_PROD1 ;
  59:  IF ((R[186]=1) AND (R[195]<>0)),CALL RM_SAMP1 ;
  60:  IF ((R[186]=2) AND (R[195]=0)),CALL RM_PROD2 ;
  61:  IF ((R[186]=2) AND (R[195]<>0)),CALL RM_SAMP2 ;
  62:  IF ((R[186]=3) AND (R[195]=0)),CALL RM_PROD3 ;
  63:  IF ((R[186]=3) AND (R[195]<>0)),CALL RM_SAMP3 ;
  64:  IF ((R[186]=4) AND (R[195]=0)),CALL RM_PROD4 ;
  65:  IF ((R[186]=4) AND (R[195]<>0)),CALL RM_SAMP4 ;
  66:  IF ((R[186]=5) AND (R[195]=0)),CALL RM_PROD5 ;
  67:  IF ((R[186]=5) AND (R[195]<>0)),CALL RM_SAMP5 ;
  68:  IF (F[20]),R[179]=(440) ;
  69:  JMP LBL[999] ;
  70:  LBL[440] ;
  71:  ! Jednorazowe zwolnienie grupy ;
  72:  CALL RG_RELEASE ;
  73:  R[179]=(450) ;
  74:  JMP LBL[999] ;
  75:  LBL[450] ;
  76:  ! Potwierdzenie fizycznego odlozenia ;
  77:  R[102]=(50) ;
  78:  CALL RG_RELEASED ;
  79:  IF (!F[26]),JMP LBL[999] ;
  80:  IF (R[195]=0),CALL RE_PROD ;
  81:  IF (R[195]=1),CALL RE_SAMPLE ;
  82:  IF (R[195]=2),CALL RE_REJECT ;
  83:  R[179]=(460) ;
  84:  JMP LBL[999] ;
  85:  LBL[460] ;
  86:  ! ACK rozliczenia grupy ;
  87:  R[196]=(R[195]+6) ;
  88:  R[102]=(70) ;
  89:  CALL RE_DONE ;
  90:  IF (F[23]),R[179]=(470) ;
  91:  JMP LBL[999] ;
  92:  LBL[470] ;
  93:  ! Zapis postepu po ACK ;
  94:  R[185]=(R[185]-R[192]) ;
  95:  IF (R[195]=0),R[187]=(R[187]+1) ;
  96:  R[186]=(R[186]+1) ;
  97:  R[179]=(480) ;
  98:  JMP LBL[999] ;
  99:  LBL[480] ;
 100:  ! Wycofanie po odlozeniu ;
 101:  IF (R[195]=0),CALL RM_PLACEOUT ;
 102:  IF (R[195]<>0),CALL RM_SAMPLEOUT ;
 103:  IF (F[20]),R[179]=(485) ;
 104:  JMP LBL[999] ;
 105:  LBL[485] ;
 106:  ! Zwolnienie obszaru windy ;
 107:  F[28]=(ON) ;
 108:  F[40]=(OFF) ;
 109:  F[608]=(OFF) ;
 110:  R[179]=(400) ;
 111:  JMP LBL[999] ;
 112:  LBL[490] ;
 113:  ! Partia rozliczona ;
 114:  IF (R[185]<>0),JMP LBL[9000] ;
 115:  F[17]=(OFF) ;
 116:  F[18]=(OFF) ;
 117:  F[37]=(OFF) ;
 118:  R[179]=(10) ;
 119:  IF ((R[195]=0) AND (R[187]=R[37]*R[38])),R[179]=(500) ;
 120:  JMP LBL[999] ;
 121:  LBL[9000] ;
 122:  IF (R[97]=0),R[97]=(1900) ;
 123:  F[16]=(ON) ;
 124:  R[179]=(900) ;
 125:  LBL[999] ;
/POS
/END
