1777:  ! (1..65535). Stabilna wraz z ;
1778:  ! cycleId i reject do ;
1779:  ! konca handshake ;
1780:  ! immPickupCompleted, nie ;
1781:  ! biezacy parametr HMI. ;
1782:  ! Kierunek: PLC ;
1783:  ! do robota. ;
1784:  R[77:RxIMMSztPart]=(R[27:MIMMSztPart]) ;
1785:  ! R[78] - Snapshot odebrany ;
1786:  ! przez PLC_RX. Licznik modulo ;
1787:  ! 65536 zwiekszany ;
1788:  ! wylacznie po przyjetym ;
1789:  ! fizycznym Start. Zastana ;
1790:  ! wartosc po ;
1791:  ! inicjalizacji/recovery nie ;
1792:  ! uruchamia pracy, potrzebna ;
1793:  ! kolejna zmiana. Nie ;
1794:  ! jest zdalnym START UOP. ;
1795:  ! Kierunek: PLC do robota. ;
1796:  ! R[28] - Syntetyczne wejscie ;
1797:  ! tylko izolowanego TEST. ;
1798:  ! Licznik modulo 65536 ;
1799:  ! zwiekszany wylacznie po ;
1800:  ! przyjetym fizycznym Start. ;
1801:  ! Zastana wartosc po ;
