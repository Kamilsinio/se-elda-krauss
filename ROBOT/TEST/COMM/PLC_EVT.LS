/PROG PLC_EVT
/ATTR
OWNER = MNEDITOR;
COMMENT = "Zdarzenia i ACK";
PROTECT = READ_WRITE;
DEFAULT_GROUP = *,*,*,*,*;
CONTROL_CODE = 00000000 00000000;
/MN
   1:  ! Kanaly zdarzen i ACK ;
   2:  ! Robot zada - PLC wykonuje ;
   3:  ! Festo i EUROMAP ;
   4:  ! Kanal blisterPicked ;
   5:  ! F[745] - Obustronna ;
   6:  ! synchronizacja i gotowosc sa ;
   7:  ! aktualne, OFF brak waznych ;
   8:  ! komend. ON opisany ;
   9:  ! warunek/zadanie, OFF brak. ;
  10:  ! R[147] - Kanal: pobranie ;
  11:  ! pustej tacki. Stan wymiany: 0 ;
  12:  ! bezczynna, 10 REQ=1 ;
  13:  ! czeka ACK=1, 20 REQ=0 czeka ;
  14:  ! ACK=0. ;
  15:  ! R[148] - Kanal: pobranie ;
  16:  ! pustej tacki. Wynik: 0 brak, ;
  17:  ! 10 trwa, 20 sukces ;
  18:  ! (wymaga stanu 0), 30 ;
  19:  ! odrzucono, 40 blad wykonania, ;
  20:  ! 900 utrata sesji, 901 ;
  21:  ! brak pozwolenia, 903 zastane ;
  22:  ! ACK=1, 904 bledny payload. ;
  23:  IF (!F[745:SesjaWazna] AND (R[147:PobrTackStan]<>0)),R[148:PobrTackWynik]=(900) ;
  24:  IF (!F[745:SesjaWazna]),R[147:PobrTackStan]=(0) ;
  25:  ! F[625] - Lokalne zadanie lub ;
  26:  ! status aplikacji. 1: nowe ;
  27:  ! zdarzenie ;
  28:  ! blisterPicked, utrzymac do ;
  29:  ! ACK, nastepne po pelnym ;
  30:  ! wyzerowaniu kanalu. ;
  31:  ! Kierunek: Robot do PLC. ;
  32:  IF (!F[625:CmdPobrTaReq]),JMP LBL[100] ;
  33:  F[625:CmdPobrTaReq]=(OFF) ;
  34:  ! R[141] - Kod: 0 brak, 902 ;
  35:  ! timeout SYNC, 905 zajety ;
  36:  ! kanal, 906 bledny wynik ;
  37:  ! przedmuchu. ;
  38:  IF (R[147:PobrTackStan]<>0),R[141:BladLacza]=(905) ;
  39:  IF (R[147:PobrTackStan]<>0),JMP LBL[100] ;
  40:  R[148:PobrTackWynik]=(901) ;
  41:  ! F[752] - Komunikacja dopuszcza ;
  42:  ! wykonanie po walidacji sesji i ;
  43:  ! procesu, OFF ;
  44:  ! blokada. ON opisany ;
  45:  ! warunek/zadanie, OFF brak. ;
  46:  IF (!F[752:KomendyDozw]),JMP LBL[100] ;
  47:  R[148:PobrTackWynik]=(903) ;
  48:  ! F[541] - Snapshot odebrany ;
  49:  ! przez PLC_RX. 1: zdarzenie ;
  50:  ! blisterPicked ;
  51:  ! zarejestrowane dokladnie raz w ;
  52:  ! biezacej sesji, 0: kanal wolny ;
  53:  ! po req=0. ;
  54:  ! Kierunek: PLC do robota. ;
  55:  IF (F[541:RxPobrTaACK]),JMP LBL[100] ;
  56:  R[148:PobrTackWynik]=(904) ;
  57:  ! R[83] - Lokalne zadanie lub ;
  58:  ! status aplikacji. ;
  59:  ! Identyfikator stosu/pojemnika ;
  60:  ! nadany przez PLC, echo ;
  61:  ! production.stackId. Stabilne ;
  62:  ! przed REQ=1 az do ACK=0, ;
  63:  ! osobny payload kazdego kanalu. ;
  64:  ! Kierunek: Robot do PLC. ;
  65:  IF ((R[83:CmdPobrTaLad]<0) OR (R[83:CmdPobrTaLad]>65535) OR ((R[83:CmdPobrTaLad] MOD 1)<>0)),JMP LBL[100] ;
  66:  ! R[109] - Payload zamrozony od ;
  67:  ! REQ do ACK=0. Identyfikator ;
  68:  ! stosu/pojemnika ;
  69:  ! nadany przez PLC, echo ;
  70:  ! production.stackId. Stabilne ;
  71:  ! przed REQ=1 az do ACK=0, ;
  72:  ! osobny payload kazdego kanalu. ;
  73:  ! Kierunek: Robot do PLC. ;
  74:  R[109:ACKPobrTaLad]=(R[83:CmdPobrTaLad]) ;
  75:  R[147:PobrTackStan]=(10) ;
  76:  R[148:PobrTackWynik]=(10) ;
  77:  LBL[100] ;
  78:  IF ((R[147:PobrTackStan]=10) AND F[541:RxPobrTaACK]),R[148:PobrTackWynik]=(20) ;
  79:  IF ((R[147:PobrTackStan]=10) AND F[541:RxPobrTaACK]),R[147:PobrTackStan]=(20) ;
  80:  IF ((R[147:PobrTackStan]=20) AND !F[541:RxPobrTaACK]),R[147:PobrTackStan]=(0) ;
  81:  ! F[689] - Bufor wyjscia po ;
  82:  ! walidacji. 1: nowe zdarzenie ;
  83:  ! blisterPicked, ;
  84:  ! utrzymac do ACK, nastepne po ;
  85:  ! pelnym wyzerowaniu kanalu. ;
  86:  ! Kierunek: Robot do ;
  87:  ! PLC. ;
  88:  F[689:TxPobrTaReq]=((R[147:PobrTackStan]=10) AND F[745:SesjaWazna]) ;
  89:  ! Kanal blisterPlaced ;
  90:  ! R[149] - Kanal: odlozenie ;
  91:  ! pustej tacki. Stan wymiany: 0 ;
  92:  ! bezczynna, 10 REQ=1 ;
  93:  ! czeka ACK=1, 20 REQ=0 czeka ;
  94:  ! ACK=0. ;
  95:  ! R[150] - Kanal: odlozenie ;
  96:  ! pustej tacki. Wynik: 0 brak, ;
  97:  ! 10 trwa, 20 sukces ;
  98:  ! (wymaga stanu 0), 30 ;
  99:  ! odrzucono, 40 blad wykonania, ;
 100:  ! 900 utrata sesji, 901 ;
 101:  ! brak pozwolenia, 903 zastane ;
 102:  ! ACK=1, 904 bledny payload. ;
 103:  IF (!F[745:SesjaWazna] AND (R[149:OdlTackStan]<>0)),R[150:OdlTackWynik]=(900) ;
 104:  IF (!F[745:SesjaWazna]),R[149:OdlTackStan]=(0) ;
 105:  ! F[626] - Lokalne zadanie lub ;
 106:  ! status aplikacji. 1: nowe ;
 107:  ! zdarzenie ;
 108:  ! blisterPlaced, utrzymac do ;
 109:  ! ACK, nastepne po pelnym ;
 110:  ! wyzerowaniu kanalu. ;
 111:  ! Kierunek: Robot do PLC. ;
 112:  IF (!F[626:CmdOdlTacReq]),JMP LBL[110] ;
 113:  F[626:CmdOdlTacReq]=(OFF) ;
 114:  IF (R[149:OdlTackStan]<>0),R[141:BladLacza]=(905) ;
 115:  IF (R[149:OdlTackStan]<>0),JMP LBL[110] ;
 116:  R[150:OdlTackWynik]=(901) ;
 117:  IF (!F[752:KomendyDozw]),JMP LBL[110] ;
 118:  R[150:OdlTackWynik]=(903) ;
 119:  ! F[542] - Snapshot odebrany ;
 120:  ! przez PLC_RX. 1: zdarzenie ;
 121:  ! blisterPlaced ;
 122:  ! zarejestrowane dokladnie raz w ;
 123:  ! biezacej sesji, 0: kanal wolny ;
 124:  ! po req=0. ;
 125:  ! Kierunek: PLC do robota. ;
 126:  IF (F[542:RxOdlTacACK]),JMP LBL[110] ;
 127:  R[150:OdlTackWynik]=(904) ;
 128:  ! R[84] - Lokalne zadanie lub ;
 129:  ! status aplikacji. ;
 130:  ! Identyfikator stosu/pojemnika ;
 131:  ! nadany przez PLC, echo ;
 132:  ! production.stackId. Stabilne ;
 133:  ! przed REQ=1 az do ACK=0, ;
 134:  ! osobny payload kazdego kanalu. ;
 135:  ! Kierunek: Robot do PLC. ;
 136:  IF ((R[84:CmdOdlTacLad]<0) OR (R[84:CmdOdlTacLad]>65535) OR ((R[84:CmdOdlTacLad] MOD 1)<>0)),JMP LBL[110] ;
 137:  ! R[110] - Payload zamrozony od ;
 138:  ! REQ do ACK=0. Identyfikator ;
 139:  ! stosu/pojemnika ;
 140:  ! nadany przez PLC, echo ;
 141:  ! production.stackId. Stabilne ;
 142:  ! przed REQ=1 az do ACK=0, ;
 143:  ! osobny payload kazdego kanalu. ;
 144:  ! Kierunek: Robot do PLC. ;
 145:  R[110:ACKOdlTacLad]=(R[84:CmdOdlTacLad]) ;
 146:  R[149:OdlTackStan]=(10) ;
 147:  R[150:OdlTackWynik]=(10) ;
 148:  LBL[110] ;
 149:  IF ((R[149:OdlTackStan]=10) AND F[542:RxOdlTacACK]),R[150:OdlTackWynik]=(20) ;
 150:  IF ((R[149:OdlTackStan]=10) AND F[542:RxOdlTacACK]),R[149:OdlTackStan]=(20) ;
 151:  IF ((R[149:OdlTackStan]=20) AND !F[542:RxOdlTacACK]),R[149:OdlTackStan]=(0) ;
 152:  ! F[690] - Bufor wyjscia po ;
 153:  ! walidacji. 1: nowe zdarzenie ;
 154:  ! blisterPlaced, ;
 155:  ! utrzymac do ACK, nastepne po ;
 156:  ! pelnym wyzerowaniu kanalu. ;
 157:  ! Kierunek: Robot do ;
 158:  ! PLC. ;
 159:  F[690:TxOdlTacReq]=((R[149:OdlTackStan]=10) AND F[745:SesjaWazna]) ;
 160:  ! Kanal blisterFinished ;
 161:  ! R[151] - Kanal: napelnienie ;
 162:  ! pojedynczej tacki. Stan ;
 163:  ! wymiany: 0 bezczynna, 10 ;
 164:  ! REQ=1 czeka ACK=1, 20 REQ=0 ;
 165:  ! czeka ACK=0. ;
 166:  ! R[152] - Kanal: napelnienie ;
 167:  ! pojedynczej tacki. Wynik: 0 ;
 168:  ! brak, 10 trwa, 20 ;
 169:  ! sukces (wymaga stanu 0), 30 ;
 170:  ! odrzucono, 40 blad wykonania, ;
 171:  ! 900 utrata sesji, ;
 172:  ! 901 brak pozwolenia, 903 ;
 173:  ! zastane ACK=1, 904 bledny ;
 174:  ! payload. ;
 175:  IF (!F[745:SesjaWazna] AND (R[151:PelTackStan]<>0)),R[152:PelTackWynik]=(900) ;
 176:  IF (!F[745:SesjaWazna]),R[151:PelTackStan]=(0) ;
 177:  ! F[624] - Lokalne zadanie lub ;
 178:  ! status aplikacji. 1: ;
 179:  ! pojedynczy blister ;
 180:  ! napelniony, nie oznacza ;
 181:  ! ukonczenia stosu. Kierunek: ;
 182:  ! Robot do PLC. ;
 183:  IF (!F[624:CmdPelTacReq]),JMP LBL[120] ;
 184:  F[624:CmdPelTacReq]=(OFF) ;
 185:  IF (R[151:PelTackStan]<>0),R[141:BladLacza]=(905) ;
 186:  IF (R[151:PelTackStan]<>0),JMP LBL[120] ;
 187:  R[152:PelTackWynik]=(901) ;
 188:  IF (!F[752:KomendyDozw]),JMP LBL[120] ;
 189:  R[152:PelTackWynik]=(903) ;
 190:  ! F[540] - Snapshot odebrany ;
 191:  ! przez PLC_RX. 1: ukonczenie ;
 192:  ! pojedynczego blistra ;
 193:  ! zarejestrowane raz. Kierunek: ;
 194:  ! PLC do robota. ;
 195:  IF (F[540:RxPelTacACK]),JMP LBL[120] ;
 196:  R[152:PelTackWynik]=(904) ;
 197:  ! R[81] - Lokalne zadanie lub ;
 198:  ! status aplikacji. Indeks ;
 199:  ! ukonczonego blistra od ;
 200:  ! 0, stabilny w calej wymianie. ;
 201:  ! Kierunek: Robot do PLC. ;
 202:  IF ((R[81:CmdPelTacIdx]<0) OR (R[81:CmdPelTacIdx]>65535) OR ((R[81:CmdPelTacIdx] MOD 1)<>0)),JMP LBL[120] ;
 203:  ! R[82] - Lokalne zadanie lub ;
 204:  ! status aplikacji. ;
 205:  ! Identyfikator stosu blistrow, ;
 206:  ! stabilny w calej wymianie. ;
 207:  ! Kierunek: Robot do PLC. ;
 208:  IF ((R[82:CmdPelTacLad]<0) OR (R[82:CmdPelTacLad]>65535) OR ((R[82:CmdPelTacLad] MOD 1)<>0)),JMP LBL[120] ;
 209:  ! R[107] - Payload zamrozony od ;
 210:  ! REQ do ACK=0. Indeks ;
 211:  ! ukonczonego blistra od 0, ;
 212:  ! stabilny w calej wymianie. ;
 213:  ! Kierunek: Robot do PLC. ;
 214:  R[107:ACKPelTacIdx]=(R[81:CmdPelTacIdx]) ;
 215:  ! R[108] - Payload zamrozony od ;
 216:  ! REQ do ACK=0. Identyfikator ;
 217:  ! stosu blistrow, ;
 218:  ! stabilny w calej wymianie. ;
 219:  ! Kierunek: Robot do PLC. ;
 220:  R[108:ACKPelTacLad]=(R[82:CmdPelTacLad]) ;
 221:  R[151:PelTackStan]=(10) ;
 222:  R[152:PelTackWynik]=(10) ;
 223:  LBL[120] ;
 224:  IF ((R[151:PelTackStan]=10) AND F[540:RxPelTacACK]),R[152:PelTackWynik]=(20) ;
 225:  IF ((R[151:PelTackStan]=10) AND F[540:RxPelTacACK]),R[151:PelTackStan]=(20) ;
 226:  IF ((R[151:PelTackStan]=20) AND !F[540:RxPelTacACK]),R[151:PelTackStan]=(0) ;
 227:  ! F[688] - Bufor wyjscia po ;
 228:  ! walidacji. 1: pojedynczy ;
 229:  ! blister napelniony, nie ;
 230:  ! oznacza ukonczenia stosu. ;
 231:  ! Kierunek: Robot do PLC. ;
 232:  F[688:TxPelTacReq]=((R[151:PelTackStan]=10) AND F[745:SesjaWazna]) ;
 233:  ! Kanal spacerPlaced ;
 234:  ! R[153] - Kanal: odlozenie ;
 235:  ! przekladki. Stan wymiany: 0 ;
 236:  ! bezczynna, 10 REQ=1 ;
 237:  ! czeka ACK=1, 20 REQ=0 czeka ;
 238:  ! ACK=0. ;
 239:  ! R[154] - Kanal: odlozenie ;
 240:  ! przekladki. Wynik: 0 brak, 10 ;
 241:  ! trwa, 20 sukces ;
 242:  ! (wymaga stanu 0), 30 ;
 243:  ! odrzucono, 40 blad wykonania, ;
 244:  ! 900 utrata sesji, 901 ;
 245:  ! brak pozwolenia, 903 zastane ;
 246:  ! ACK=1, 904 bledny payload. ;
 247:  IF (!F[745:SesjaWazna] AND (R[153:PrzeklStan]<>0)),R[154:PrzeklWynik]=(900) ;
 248:  IF (!F[745:SesjaWazna]),R[153:PrzeklStan]=(0) ;
 249:  ! F[631] - Lokalne zadanie lub ;
 250:  ! status aplikacji. 1: nowe ;
 251:  ! zdarzenie ;
 252:  ! spacerPlaced, utrzymac do ACK, ;
 253:  ! nastepne po pelnym wyzerowaniu ;
 254:  ! kanalu. ;
 255:  ! Kierunek: Robot do PLC. ;
 256:  IF (!F[631:CmdPrzeklReq]),JMP LBL[130] ;
 257:  F[631:CmdPrzeklReq]=(OFF) ;
 258:  IF (R[153:PrzeklStan]<>0),R[141:BladLacza]=(905) ;
 259:  IF (R[153:PrzeklStan]<>0),JMP LBL[130] ;
 260:  R[154:PrzeklWynik]=(901) ;
 261:  IF (!F[752:KomendyDozw]),JMP LBL[130] ;
 262:  R[154:PrzeklWynik]=(903) ;
 263:  ! F[547] - Snapshot odebrany ;
 264:  ! przez PLC_RX. 1: zdarzenie ;
 265:  ! spacerPlaced ;
 266:  ! zarejestrowane dokladnie raz w ;
 267:  ! biezacej sesji, 0: kanal wolny ;
 268:  ! po req=0. ;
 269:  ! Kierunek: PLC do robota. ;
 270:  IF (F[547:RxPrzeklACK]),JMP LBL[130] ;
 271:  R[154:PrzeklWynik]=(904) ;
 272:  ! R[95] - Lokalne zadanie lub ;
 273:  ! status aplikacji. ;
 274:  ! Identyfikator stosu/pojemnika ;
 275:  ! nadany przez PLC, echo ;
 276:  ! production.stackId. Stabilne ;
 277:  ! przed REQ=1 az do ACK=0, ;
 278:  ! osobny payload kazdego kanalu. ;
 279:  ! Kierunek: Robot do PLC. ;
 280:  IF ((R[95:CmdPrzeklLad]<0) OR (R[95:CmdPrzeklLad]>65535) OR ((R[95:CmdPrzeklLad] MOD 1)<>0)),JMP LBL[130] ;
 281:  ! R[121] - Payload zamrozony od ;
 282:  ! REQ do ACK=0. Identyfikator ;
 283:  ! stosu/pojemnika ;
 284:  ! nadany przez PLC, echo ;
 285:  ! production.stackId. Stabilne ;
 286:  ! przed REQ=1 az do ACK=0, ;
 287:  ! osobny payload kazdego kanalu. ;
 288:  ! Kierunek: Robot do PLC. ;
 289:  R[121:ACKPrzeklLad]=(R[95:CmdPrzeklLad]) ;
 290:  R[153:PrzeklStan]=(10) ;
 291:  R[154:PrzeklWynik]=(10) ;
 292:  LBL[130] ;
 293:  IF ((R[153:PrzeklStan]=10) AND F[547:RxPrzeklACK]),R[154:PrzeklWynik]=(20) ;
 294:  IF ((R[153:PrzeklStan]=10) AND F[547:RxPrzeklACK]),R[153:PrzeklStan]=(20) ;
 295:  IF ((R[153:PrzeklStan]=20) AND !F[547:RxPrzeklACK]),R[153:PrzeklStan]=(0) ;
 296:  ! F[695] - Bufor wyjscia po ;
 297:  ! walidacji. 1: nowe zdarzenie ;
 298:  ! spacerPlaced, ;
 299:  ! utrzymac do ACK, nastepne po ;
 300:  ! pelnym wyzerowaniu kanalu. ;
 301:  ! Kierunek: Robot do ;
 302:  ! PLC. ;
 303:  F[695:TxPrzeklReq]=((R[153:PrzeklStan]=10) AND F[745:SesjaWazna]) ;
 304:  ! Kanal productsPlaced ;
 305:  ! R[155] - Kanal: odlozenie ;
 306:  ! dobrych detali. Stan wymiany: ;
 307:  ! 0 bezczynna, 10 ;
 308:  ! REQ=1 czeka ACK=1, 20 REQ=0 ;
 309:  ! czeka ACK=0. ;
 310:  ! R[156] - Kanal: odlozenie ;
 311:  ! dobrych detali. Wynik: 0 brak, ;
 312:  ! 10 trwa, 20 sukces ;
 313:  ! (wymaga stanu 0), 30 ;
 314:  ! odrzucono, 40 blad wykonania, ;
 315:  ! 900 utrata sesji, 901 ;
 316:  ! brak pozwolenia, 903 zastane ;
 317:  ! ACK=1, 904 bledny payload. ;
 318:  IF (!F[745:SesjaWazna] AND (R[155:DobreStan]<>0)),R[156:DobreWynik]=(900) ;
 319:  IF (!F[745:SesjaWazna]),R[155:DobreStan]=(0) ;
 320:  ! F[629] - Lokalne zadanie lub ;
 321:  ! status aplikacji. 1: nowe ;
 322:  ! zdarzenie ;
 323:  ! productsPlaced, utrzymac do ;
 324:  ! ACK, nastepne po pelnym ;
 325:  ! wyzerowaniu kanalu. ;
 326:  ! Kierunek: Robot do PLC. ;
 327:  IF (!F[629:CmdDobreReq]),JMP LBL[140] ;
 328:  F[629:CmdDobreReq]=(OFF) ;
 329:  IF (R[155:DobreStan]<>0),R[141:BladLacza]=(905) ;
 330:  IF (R[155:DobreStan]<>0),JMP LBL[140] ;
 331:  R[156:DobreWynik]=(901) ;
 332:  IF (!F[752:KomendyDozw]),JMP LBL[140] ;
 333:  R[156:DobreWynik]=(903) ;
 334:  ! F[545] - Snapshot odebrany ;
 335:  ! przez PLC_RX. 1: zdarzenie ;
 336:  ! productsPlaced ;
 337:  ! zarejestrowane dokladnie raz w ;
 338:  ! biezacej sesji, 0: kanal wolny ;
 339:  ! po req=0. ;
 340:  ! Kierunek: PLC do robota. ;
 341:  IF (F[545:RxDobreACK]),JMP LBL[140] ;
 342:  R[156:DobreWynik]=(904) ;
 343:  ! R[89] - Lokalne zadanie lub ;
 344:  ! status aplikacji. Potwierdzona ;
 345:  ! liczba odlozonych ;
 346:  ! detali: UINT 1..65535, nie ;
 347:  ! wiecej niz nierozliczona ilosc ;
 348:  ! przypisanej ;
 349:  ! partii, niezalezna od obwodow ;
 350:  ! prozni. Nastawe stosowac tylko ;
 351:  ! przy wylaczonym ;
 352:  ! zleceniu i niepracujacej ;
 353:  ! stacji (DEC-18). Payload ;
 354:  ! stabilny przed REQ=1 az do ;
 355:  ! ACK=0. Kierunek: Robot do PLC. ;
 356:  IF ((R[89:CmdDobreSzt]<0) OR (R[89:CmdDobreSzt]>65535) OR ((R[89:CmdDobreSzt] MOD 1)<>0)),JMP LBL[140] ;
 357:  IF (R[89:CmdDobreSzt]<1),JMP LBL[140] ;
 358:  ! R[90] - Lokalne zadanie lub ;
 359:  ! status aplikacji. ;
 360:  ! Identyfikator rzeczywiscie ;
 361:  ! rozpoczetego wtrysku, wiaze ;
 362:  ! zdarzenie z rozliczeniem ;
 363:  ! detali. Stabilne przed ;
 364:  ! REQ=1 az do ACK=0, osobny ;
 365:  ! payload kazdego kanalu. ;
 366:  ! Kierunek: Robot do PLC. ;
 367:  IF ((R[90:CmdDobreCykl]<0) OR (R[90:CmdDobreCykl]>65535) OR ((R[90:CmdDobreCykl] MOD 1)<>0)),JMP LBL[140] ;
 368:  ! R[91] - Lokalne zadanie lub ;
 369:  ! status aplikacji. ;
 370:  ! Identyfikator stosu/pojemnika ;
 371:  ! nadany przez PLC, echo ;
 372:  ! production.stackId. Stabilne ;
 373:  ! przed REQ=1 az do ACK=0, ;
 374:  ! osobny payload kazdego kanalu. ;
 375:  ! Kierunek: Robot do PLC. ;
 376:  IF ((R[91:CmdDobreLad]<0) OR (R[91:CmdDobreLad]>65535) OR ((R[91:CmdDobreLad] MOD 1)<>0)),JMP LBL[140] ;
 377:  ! R[115] - Payload zamrozony od ;
 378:  ! REQ do ACK=0. Potwierdzona ;
