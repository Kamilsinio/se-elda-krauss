   9:  F[683]=(F[619] AND !F[618] AND F[752]) ;
  10:  IF (F[620] AND F[621]),R[141]=(907) ;
  11:  F[684]=(F[620] AND !F[621] AND F[752]) ;
  12:  F[685]=(F[621] AND !F[620] AND F[752]) ;
  13:  IF (F[622] AND F[623]),R[141]=(907) ;
