/PROG BG_PLC
/ATTR
OWNER = MNEDITOR;
COMMENT = "Watchdog PLC";
PROTECT = READ_WRITE;
DEFAULT_GROUP = *,*,*,*,*;
CONTROL_CODE = 00000000 00000000;
/MN
   1:  ! Watchdog i heartbeat PLC ;
   2:  ! Robot zada - PLC wykonuje ;
   3:  ! Festo i EUROMAP ;
   4:  ! R[129] - Biezacy czas ;
   5:  ! watchdogow [surowe ticki], ;
   6:  ! czestotliwosc do pomiaru. ;
   7:  ! R[142] - LIVE: czas ostatniego ;
   8:  ! BG_STATUS [ticki]. TEST: ;
   9:  ! syntetyczny zegar ;
  10:  ! testu. ;
  11:  R[129:CzasTeraz_t]=(R[142:CzasStatus_t]) ;
  12:  ! F[744] - Zegar nie cofnal sie, ;
  13:  ! OFF wymaga ponownego ;
  14:  ! uzgodnienia. ON opisany ;
  15:  ! warunek/zadanie, OFF brak. ;
  16:  ! R[130] - Poprzedni czas do ;
  17:  ! wykrycia cofniecia zegara. ;
  18:  F[744:ZegarOK]=(R[129:CzasTeraz_t]>=R[130:CzasPoprz_t]) ;
  19:  ! F[741] - Heartbeat PLC zmienia ;
  20:  ! sie w dopuszczalnym czasie. ON ;
  21:  ! opisany ;
  22:  ! warunek/zadanie, OFF brak. ;
  23:  IF (!F[744:ZegarOK]),F[741:HBPLCswiezy]=(OFF) ;
  24:  ! F[742] - PLC_SVC aktualizuje ;
  25:  ! licznik w dopuszczalnym ;
  26:  ! czasie. ON opisany ;
  27:  ! warunek/zadanie, OFF brak. ;
  28:  IF (!F[744:ZegarOK]),F[742:SVCswiezy]=(OFF) ;
  29:  ! R[134] - Czas ostatniego ;
  30:  ! zwiekszenia heartbeat robota ;
  31:  ! [ticki]. ;
  32:  IF (!F[744:ZegarOK]),R[134:HBczas_t]=(R[129:CzasTeraz_t]) ;
  33:  ! R[52] - Snapshot odebrany ;
  34:  ! przez PLC_RX. Licznik 0..65535 ;
  35:  ! modulo 65536, ;
  36:  ! cykliczny niezaleznie od WAIT ;
  37:  ! programu. Kierunek: PLC do ;
  38:  ! robota. ;
  39:  ! R[133] - Ostatni heartbeat PLC ;
  40:  ! 0..65535. ;
  41:  ! R[131] - Czas ostatniej zmiany ;
  42:  ! heartbeat PLC [ticki]. ;
  43:  IF (R[52:RxLaczHB]<>R[133:HBPLCpoprz]),R[131:PLCzmiana_t]=(R[129:CzasTeraz_t]) ;
  44:  IF (R[52:RxLaczHB]<>R[133:HBPLCpoprz]),F[741:HBPLCswiezy]=(ON) ;
  45:  R[133:HBPLCpoprz]=(R[52:RxLaczHB]) ;
  46:  ! R[127] - Licznik cykli ;
  47:  ! PLC_SCAN do wykrycia ;
  48:  ! zatrzymania PLC_SVC. ;
  49:  ! R[128] - Ostatnio widziany ;
  50:  ! licznik serwisu. ;
  51:  ! R[132] - Czas ostatniej zmiany ;
  52:  ! licznika serwisu [ticki]. ;
  53:  IF (R[127:CyklSerwisu]<>R[128:CyklSVCpop]),R[132:SVCzmiana_t]=(R[129:CzasTeraz_t]) ;
  54:  IF (R[127:CyklSerwisu]<>R[128:CyklSVCpop]),F[742:SVCswiezy]=(ON) ;
  55:  R[128:CyklSVCpop]=(R[127:CyklSerwisu]) ;
  56:  ! F[758] - BG_STATUS i BG_GUARD ;
  57:  ! maja aktualne znaczniki czasu. ;
  58:  ! ON opisany ;
  59:  ! warunek/zadanie, OFF brak. ;
  60:  F[758:BGswieze]=((R[129:CzasTeraz_t]>=R[142:CzasStatus_t]) AND (R[142:CzasStatus_t]>0)) ;
  61:  ! R[138] - Limit nieaktualnego ;
  62:  ! serwisu lub BG [ticki]. ;
  63:  F[758:BGswieze]=(F[758:BGswieze] AND (R[129:CzasTeraz_t]-R[142:CzasStatus_t]<R[138:SVCczasMax_t])) ;
  64:  ! R[146] - LIVE: czas ostatniego ;
  65:  ! BG_GUARD [ticki]. TEST: 1 ;
  66:  ! PASS, 900 FAIL, 0 ;
  67:  ! niewykonany. ;
  68:  F[758:BGswieze]=(F[758:BGswieze] AND (R[129:CzasTeraz_t]>=R[146:CzasGuard_t]) AND (R[146:CzasGuard_t]>0)) ;
  69:  F[758:BGswieze]=(F[758:BGswieze] AND (R[129:CzasTeraz_t]-R[146:CzasGuard_t]<R[138:SVCczasMax_t])) ;
  70:  ! F[743] - Wszystkie wymagane ;
  71:  ! warunki watchdogow spelnione, ;
  72:  ! OFF blokuje sesje. ;
  73:  ! ON opisany warunek/zadanie, ;
  74:  ! OFF brak. ;
  75:  ! F[738] - Odebrano rzeczywista ;
  76:  ! konfiguracje EIP, OFF brak ;
  77:  ! dopuszczenia lacza. ;
  78:  ! ON opisany warunek/zadanie, ;
  79:  ! OFF brak. ;
  80:  F[743:WatchdogOK]=(F[738:MapaOdebr]) ;
  81:  ! F[736] - Serwis ma pracowac, ;
  82:  ! OFF konczy serwis i uniewaznia ;
  83:  ! sesje. ON ;
  84:  ! opisany warunek/zadanie, OFF ;
  85:  ! brak. ;
  86:  F[743:WatchdogOK]=(F[743:WatchdogOK] AND F[736:SerwisON]) ;
  87:  F[743:WatchdogOK]=(F[743:WatchdogOK] AND F[744:ZegarOK]) ;
  88:  F[743:WatchdogOK]=(F[743:WatchdogOK] AND F[741:HBPLCswiezy]) ;
  89:  F[743:WatchdogOK]=(F[743:WatchdogOK] AND F[742:SVCswiezy]) ;
  90:  ! R[51] - Snapshot odebrany ;
  91:  ! przez PLC_RX. Wersja ;
  92:  ! kontraktu: 2, inna wartosc ;
  93:  ! blokuje uzbrojenie. Kierunek: ;
  94:  ! PLC do robota. ;
  95:  F[743:WatchdogOK]=(F[743:WatchdogOK] AND (R[51:RxLaczWers]=2)) ;
  96:  ! R[137] - Limit niezmiennego ;
  97:  ! heartbeat PLC [ticki]. ;
  98:  F[743:WatchdogOK]=(F[743:WatchdogOK] AND (R[129:CzasTeraz_t]-R[131:PLCzmiana_t]<R[137:PLCczasMax_t])) ;
  99:  F[743:WatchdogOK]=(F[743:WatchdogOK] AND (R[129:CzasTeraz_t]-R[132:SVCzmiana_t]<R[138:SVCczasMax_t])) ;
 100:  ! R[136] - Okres zwiekszania ;
 101:  ! heartbeat [surowe ticki]. ;
 102:  F[743:WatchdogOK]=(F[743:WatchdogOK] AND (R[136:HBokres_t]>0)) ;
 103:  F[743:WatchdogOK]=(F[743:WatchdogOK] AND (R[137:PLCczasMax_t]>R[136:HBokres_t])) ;
 104:  F[743:WatchdogOK]=(F[743:WatchdogOK] AND (R[138:SVCczasMax_t]>0)) ;
 105:  ! F[756] - Wybrany main wymaga ;
 106:  ! aktualnych BG, OFF sam serwis ;
 107:  ! komunikacji. ON ;
 108:  ! opisany warunek/zadanie, OFF ;
 109:  ! brak. ;
 110:  F[743:WatchdogOK]=(F[743:WatchdogOK] AND (!F[756:MainWymag] OR F[758:BGswieze])) ;
 111:  ! F[754] - Roboczy warunek ;
 112:  ! zwiekszenia heartbeat w tym ;
 113:  ! skanie. ON opisany ;
 114:  ! warunek/zadanie, OFF brak. ;
 115:  F[754:HBkrok]=(F[736:SerwisON] AND F[738:MapaOdebr] AND F[742:SVCswiezy] AND (R[129:CzasTeraz_t]-R[132:SVCzmiana_t]<R[138:SVCczasMax_t]) AND (R[129:CzasTeraz_t]-R[134:HBczas_t]>=R[136:HBokres_t])) ;
 116:  ! R[135] - Licznik heartbeat ;
 117:  ! robota 0..65535 modulo, BG_PLC ;
 118:  ! jest jedynym ;
 119:  ! pisarzem jego GO. ;
 120:  IF (F[754:HBkrok]),R[135:HBRobot]=((R[135:HBRobot]+1) MOD 65536) ;
 121:  IF (F[754:HBkrok]),R[134:HBczas_t]=(R[129:CzasTeraz_t]) ;
 122:  R[130:CzasPoprz_t]=(R[129:CzasTeraz_t]) ;
 123:  ! GO[2] - Licznik 0..65535 ;
 124:  ! modulo 65536, cykliczny ;
 125:  ! niezaleznie od WAIT ;
 126:  ! programu. Kierunek: Robot do ;
 127:  ! PLC. Transport EIP, fizyczne ;
 128:  ! przypisanie do ;
 129:  ! odbioru. ;
 130:  GO[2:LaczHB]=(0) ;
/POS
/END
