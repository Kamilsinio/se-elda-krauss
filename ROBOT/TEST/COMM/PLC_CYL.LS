  31:  ! procesu, OFF ;
  32:  ! blokada. ON opisany ;
  33:  ! warunek/zadanie, OFF brak. ;
  34:  F[678:TxV501Home]=(F[614:CmdV501Home] AND !F[615:CmdV501Work] AND F[752:KomendyDozw]) ;
  35:  ! F[679] - Bufor wyjscia po ;
  36:  ! walidacji. 1: zadanie pozycji ;
  37:  ! WORK, 0: brak tego ;
  38:  ! zadania. Para 00=brak nowego ;
