/PROG PLC_CYL
/ATTR
OWNER = MNEDITOR;
COMMENT = "Cele silownikow";
PROTECT = READ_WRITE;
DEFAULT_GROUP = *,*,*,*,*;
CONTROL_CODE = 00000000 00000000;
/MN
   1:  ! Zadania silownikow ;
   2:  ! Robot zada - PLC wykonuje ;
   3:  ! Festo i EUROMAP ;
   4:  ! F[614] - Lokalne zadanie lub ;
   5:  ! status aplikacji. 1: zadanie ;
   6:  ! pozycji HOME, 0: ;
   7:  ! brak tego zadania. Para ;
   8:  ! 00=brak nowego ruchu, ;
   9:  ! 11=odrzuc. Kierunek: Robot do ;
  10:  ! PLC. ;
  11:  ! F[615] - Lokalne zadanie lub ;
