/PROG RC_LINK
/ATTR
OWNER = MNEDITOR;
COMMENT = "EIP bez ruchu";
PROTECT = READ_WRITE;
DEFAULT_GROUP = *,*,*,*,*;
CONTROL_CODE = 00000000 00000000;
/MN
   1:  IF (!F[736] OR !F[743] OR ((F[751] OR F[759]) AND (R[126]=40))),CALL RC_DROP ;
   2:  IF (!F[736] OR !F[743]),JMP LBL[90] ;
   3:  IF ((R[126]=40) AND (F[567] OR (F[750] AND !F[565]))),CALL RC_DROP ;
   4:  F[748]=(F[567]) ;
   5:  IF (F[567]),F[749]=(ON) ;
   6:  IF ((R[126]=0) AND !F[566]),R[140]=(R[129]) ;
   7:  IF ((R[126]=0) AND !F[566]),R[126]=(10) ;
   8:  F[747]=(R[126]=10) ;
   9:  IF ((R[126]=10) AND F[566]),R[126]=(20) ;
  10:  F[747]=(R[126]=10) ;
  11:  IF ((R[126]=20) AND F[749] AND !F[567] AND !F[566]),R[126]=(30) ;
  12:  F[755]=(ON) ;
  13:  F[755]=(F[755] AND !F[541]) ;
  14:  F[755]=(F[755] AND !F[542]) ;
  15:  F[755]=(F[755] AND !F[540]) ;
  16:  F[755]=(F[755] AND !F[547]) ;
  17:  F[755]=(F[755] AND !F[545]) ;
  18:  F[755]=(F[755] AND !F[546]) ;
  19:  F[755]=(F[755] AND !F[544]) ;
  20:  F[755]=(F[755] AND !F[548]) ;
  21:  F[755]=(F[755] AND !F[543]) ;
  22:  F[755]=(F[755] AND !F[607]) ;
  23:  F[755]=(F[755] AND !F[578]) ;
  24:  F[755]=(F[755] AND !F[584]) ;
  25:  F[755]=(F[755] AND !F[590]) ;
  26:  F[755]=(F[755] AND !F[596]) ;
  27:  F[755]=(F[755] AND !F[602]) ;
  28:  IF ((R[126]=30) AND F[740] AND !F[573] AND !F[568] AND F[755] AND !F[576]),R[126]=(40) ;
  29:  F[740]=(OFF) ;
  30:  IF (((R[126]=10) OR (R[126]=20)) AND (R[129]-R[140]>R[139])),R[141]=(902) ;
  31:  IF (((R[126]=10) OR (R[126]=20)) AND (R[129]-R[140]>R[139])),CALL RC_DROP ;
  32:  F[746]=((R[126]=40) AND F[743] AND !F[751] AND !F[759]) ;
  33:  F[745]=(F[746] AND F[565] AND !F[567] AND !F[566]) ;
  34:  IF (F[745]),F[750]=(ON) ;
  35:  LBL[90] ;
  36:  IF (!F[745] OR F[568] OR F[573] OR F[759]),F[739]=(OFF) ;
/POS
/END
