/PROG PLC_TEST
/ATTR
OWNER = MNEDITOR;
COMMENT = "Test izolowany";
PROTECT = READ_WRITE;
DEFAULT_GROUP = *,*,*,*,*;
CONTROL_CODE = 00000000 00000000;
/MN
   1:  ! Izolowany test lacza ;
   2:  ! Robot zada - PLC wykonuje ;
   3:  ! Festo i EUROMAP ;
   4:  ! Zatrzymac SVC i BG przed ;
   5:  ! testem ;
   6:  CALL PLC_INIT ;
   7:  ! F[738] - Odebrano rzeczywista ;
   8:  ! konfiguracje EIP, OFF brak ;
   9:  ! dopuszczenia lacza. ;
  10:  ! ON opisany warunek/zadanie, ;
  11:  ! OFF brak. ;
  12:  F[738:MapaOdebr]=(ON) ;
  13:  ! F[736] - Serwis ma pracowac, ;
  14:  ! OFF konczy serwis i uniewaznia ;
  15:  ! sesje. ON ;
  16:  ! opisany warunek/zadanie, OFF ;
  17:  ! brak. ;
  18:  F[736:SerwisON]=(ON) ;
  19:  ! R[146] - LIVE: czas ostatniego ;
  20:  ! BG_GUARD [ticki]. TEST: 1 ;
  21:  ! PASS, 900 FAIL, 0 ;
  22:  ! niewykonany. ;
  23:  R[146:CzasGuard_t]=(0) ;
  24:  ! R[1] - Syntetyczne wejscie ;
  25:  ! tylko izolowanego TEST. Wersja ;
  26:  ! kontraktu: 2, inna ;
  27:  ! wartosc blokuje uzbrojenie. ;
  28:  ! Kierunek: PLC do robota. ;
  29:  R[1:MLaczWers]=(2) ;
  30:  ! F[826] - Syntetyczne wejscie ;
  31:  ! tylko izolowanego TEST. 1: ;
  32:  ! zadanie nowej ;
  33:  ! synchronizacji, 0: brak ;
  34:  ! zadania. Kierunek: PLC do ;
  35:  ! robota. ;
  36:  F[826:MLaczSyncReq]=(ON) ;
  37:  ! R[2] - Syntetyczne wejscie ;
  38:  ! tylko izolowanego TEST. ;
  39:  ! Licznik 0..65535 modulo ;
  40:  ! 65536, cykliczny niezaleznie ;
  41:  ! od WAIT programu. Kierunek: ;
  42:  ! PLC do robota. ;
  43:  R[2:MLaczHB]=(1) ;
  44:  ! R[142] - LIVE: czas ostatniego ;
  45:  ! BG_STATUS [ticki]. TEST: ;
  46:  ! syntetyczny zegar ;
  47:  ! testu. ;
  48:  R[142:CzasStatus_t]=(1) ;
  49:  CALL PLC_RX ;
  50:  CALL BG_PLC ;
  51:  CALL PLC_SCAN ;
  52:  R[2:MLaczHB]=(2) ;
  53:  R[142:CzasStatus_t]=(2) ;
  54:  CALL PLC_RX ;
  55:  CALL BG_PLC ;
  56:  CALL PLC_SCAN ;
  57:  ! F[825] - Syntetyczne wejscie ;
  58:  ! tylko izolowanego TEST. 1: ;
  59:  ! potwierdzenie ;
  60:  ! zadania synchronizacji ;
  61:  ! partnera, 0: brak ;
  62:  ! potwierdzenia. Kierunek: PLC ;
  63:  ! do ;
  64:  ! robota. ;
  65:  F[825:MLaczSyncACK]=(ON) ;
  66:  CALL PLC_SCAN ;
  67:  F[826:MLaczSyncReq]=(OFF) ;
  68:  F[825:MLaczSyncACK]=(OFF) ;
  69:  CALL PLC_SCAN ;
  70:  CALL PLC_REC ;
  71:  CALL PLC_SCAN ;
  72:  ! F[824] - Syntetyczne wejscie ;
  73:  ! tylko izolowanego TEST. 1: ;
  74:  ! lokalny interfejs ;
  75:  ! gotowy, 0: brak gotowosci, nie ;
  76:  ! jest to pozwolenie ruchu. ;
  77:  ! Kierunek: PLC do ;
  78:  ! robota. ;
  79:  F[824:MLaczGot]=(ON) ;
  80:  ! F[830] - Syntetyczne wejscie ;
  81:  ! tylko izolowanego TEST. 1: ;
  82:  ! mozna rozpoczac nowa ;
  83:  ! operacje produkcyjna, 0: nie ;
  84:  ! rozpoczynac kolejnej. ;
  85:  ! Kierunek: PLC do robota. ;
  86:  F[830:MProdNoweZez]=(ON) ;
  87:  ! F[739] - Main uzbroil proces, ;
  88:  ! OFF robot nie moze wydawac ;
  89:  ! komend ;
  90:  ! wykonawczych. ON opisany ;
  91:  ! warunek/zadanie, OFF brak. ;
  92:  F[739:ProcesUzbr]=(ON) ;
  93:  ! R[89] - Lokalne zadanie lub ;
  94:  ! status aplikacji. Potwierdzona ;
  95:  ! liczba odlozonych ;
  96:  ! detali: UINT 1..65535, nie ;
  97:  ! wiecej niz nierozliczona ilosc ;
  98:  ! przypisanej ;
  99:  ! partii, niezalezna od obwodow ;
 100:  ! prozni. Nastawe stosowac tylko ;
 101:  ! przy wylaczonym ;
 102:  ! zleceniu i niepracujacej ;
 103:  ! stacji (DEC-18). Payload ;
 104:  ! stabilny przed REQ=1 az do ;
 105:  ! ACK=0. Kierunek: Robot do PLC. ;
 106:  R[89:CmdDobreSzt]=(7) ;
 107:  ! R[90] - Lokalne zadanie lub ;
 108:  ! status aplikacji. ;
 109:  ! Identyfikator rzeczywiscie ;
 110:  ! rozpoczetego wtrysku, wiaze ;
 111:  ! zdarzenie z rozliczeniem ;
 112:  ! detali. Stabilne przed ;
 113:  ! REQ=1 az do ACK=0, osobny ;
 114:  ! payload kazdego kanalu. ;
 115:  ! Kierunek: Robot do PLC. ;
 116:  R[90:CmdDobreCykl]=(32768) ;
 117:  ! R[91] - Lokalne zadanie lub ;
 118:  ! status aplikacji. ;
 119:  ! Identyfikator stosu/pojemnika ;
 120:  ! nadany przez PLC, echo ;
 121:  ! production.stackId. Stabilne ;
 122:  ! przed REQ=1 az do ACK=0, ;
 123:  ! osobny payload kazdego kanalu. ;
 124:  ! Kierunek: Robot do PLC. ;
 125:  R[91:CmdDobreLad]=(65535) ;
 126:  ! F[629] - Lokalne zadanie lub ;
 127:  ! status aplikacji. 1: nowe ;
 128:  ! zdarzenie ;
 129:  ! productsPlaced, utrzymac do ;
 130:  ! ACK, nastepne po pelnym ;
 131:  ! wyzerowaniu kanalu. ;
 132:  ! Kierunek: Robot do PLC. ;
 133:  F[629:CmdDobreReq]=(ON) ;
 134:  CALL PLC_SCAN ;
 135:  ! R[155] - Kanal: odlozenie ;
 136:  ! dobrych detali. Stan wymiany: ;
 137:  ! 0 bezczynna, 10 ;
 138:  ! REQ=1 czeka ACK=1, 20 REQ=0 ;
 139:  ! czeka ACK=0. ;
 140:  ! F[753] - Odizolowany test ;
 141:  ! wykryl blad, OFF nie wykryl. ;
 142:  ! ON opisany ;
 143:  ! warunek/zadanie, OFF brak. ;
 144:  IF (R[155:DobreStan]<>10),F[753:TestBlad]=(ON) ;
 145:  R[89:CmdDobreSzt]=(99) ;
 146:  CALL PLC_SCAN ;
 147:  ! R[115] - Payload zamrozony od ;
 148:  ! REQ do ACK=0. Potwierdzona ;
 149:  ! liczba odlozonych ;
 150:  ! detali: UINT 1..65535, nie ;
 151:  ! wiecej niz nierozliczona ilosc ;
 152:  ! przypisanej ;
 153:  ! partii, niezalezna od obwodow ;
 154:  ! prozni. Nastawe stosowac tylko ;
 155:  ! przy wylaczonym ;
 156:  ! zleceniu i niepracujacej ;
 157:  ! stacji (DEC-18). Payload ;
 158:  ! stabilny przed REQ=1 az do ;
 159:  ! ACK=0. Kierunek: Robot do PLC. ;
 160:  IF (R[115:ACKDobreSzt]<>7),F[753:TestBlad]=(ON) ;
 161:  ! F[804] - Syntetyczne wejscie ;
 162:  ! tylko izolowanego TEST. 1: ;
 163:  ! zdarzenie ;
 164:  ! productsPlaced zarejestrowane ;
 165:  ! dokladnie raz w biezacej ;
 166:  ! sesji, 0: kanal wolny ;
 167:  ! po req=0. Kierunek: PLC do ;
 168:  ! robota. ;
 169:  F[804:MDobreACK]=(ON) ;
 170:  CALL PLC_SCAN ;
 171:  ! R[156] - Kanal: odlozenie ;
 172:  ! dobrych detali. Wynik: 0 brak, ;
 173:  ! 10 trwa, 20 sukces ;
 174:  ! (wymaga stanu 0), 30 ;
 175:  ! odrzucono, 40 blad wykonania, ;
 176:  ! 900 utrata sesji, 901 ;
 177:  ! brak pozwolenia, 903 zastane ;
 178:  ! ACK=1, 904 bledny payload. ;
 179:  IF (R[156:DobreWynik]<>20),F[753:TestBlad]=(ON) ;
 180:  F[804:MDobreACK]=(OFF) ;
 181:  CALL PLC_SCAN ;
 182:  IF (R[155:DobreStan]<>0),F[753:TestBlad]=(ON) ;
 183:  R[146:CzasGuard_t]=(1) ;
 184:  IF (F[753:TestBlad]),R[146:CzasGuard_t]=(900) ;
 185:  F[736:SerwisON]=(OFF) ;
 186:  F[738:MapaOdebr]=(OFF) ;
/POS
/END
