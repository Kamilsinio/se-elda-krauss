/PROG PLC_LINK
/ATTR
OWNER = MNEDITOR;
COMMENT = "Sesja i SYNC";
PROTECT = READ_WRITE;
DEFAULT_GROUP = *,*,*,*,*;
CONTROL_CODE = 00000000 00000000;
/MN
   1:  ! Synchronizacja i sesja ;
   2:  ! Robot zada - PLC wykonuje ;
   3:  ! Festo i EUROMAP ;
   4:  ! F[736] - Serwis ma pracowac, ;
   5:  ! OFF konczy serwis i uniewaznia ;
   6:  ! sesje. ON ;
   7:  ! opisany warunek/zadanie, OFF ;
   8:  ! brak. ;
   9:  ! F[743] - Wszystkie wymagane ;
  10:  ! warunki watchdogow spelnione, ;
  11:  ! OFF blokuje sesje. ;
  12:  ! ON opisany warunek/zadanie, ;
  13:  ! OFF brak. ;
  14:  ! F[751] - Zatrzasniety blad ;
  15:  ! protokolu, OFF brak takiego ;
  16:  ! bledu. ON opisany ;
  17:  ! warunek/zadanie, OFF brak. ;
  18:  ! F[759] - Zadano krytyczna ;
  19:  ! blokade i recovery, OFF brak ;
  20:  ! tego zadania. ON ;
  21:  ! opisany warunek/zadanie, OFF ;
  22:  ! brak. ;
  23:  ! R[126] - Stan: 0 rozbrojone, ;
  24:  ! 10 zadanie SYNC, 20 wygaszanie ;
  25:  ! ACK, 30 ;
  26:  ! recovery, 40 po jawnym ;
  27:  ! recovery, gotowosc sesji. ;
  28:  IF (!F[736:SerwisON] OR !F[743:WatchdogOK] OR ((F[751:BladProto] OR F[759:BlokadaBG]) AND (R[126:StanLacza]=40))),CALL PLC_LOST ;
  29:  IF (!F[736:SerwisON] OR !F[743:WatchdogOK]),JMP LBL[90] ;
  30:  ! F[567] - Snapshot odebrany ;
  31:  ! przez PLC_RX. 1: zadanie nowej ;
  32:  ! synchronizacji, 0: ;
  33:  ! brak zadania. Kierunek: PLC do ;
  34:  ! robota. ;
  35:  ! F[750] - Od resetu istniala ;
  36:  ! sesja, wykrywanie utraty ;
  37:  ! gotowosci partnera. ON ;
  38:  ! opisany warunek/zadanie, OFF ;
  39:  ! brak. ;
  40:  ! F[565] - Snapshot odebrany ;
  41:  ! przez PLC_RX. 1: lokalny ;
  42:  ! interfejs gotowy, 0: ;
  43:  ! brak gotowosci, nie jest to ;
  44:  ! pozwolenie ruchu. Kierunek: ;
  45:  ! PLC do robota. ;
  46:  IF ((R[126:StanLacza]=40) AND (F[567:RxLaczSyncReq] OR (F[750:SesjaByla] AND !F[565:RxLaczGot]))),CALL PLC_LOST ;
  47:  ! F[748] - Odpowiedz na zadanie ;
  48:  ! SYNC PLC: ON potwierdza, OFF ;
  49:  ! wygasza. ON ;
  50:  ! opisany warunek/zadanie, OFF ;
  51:  ! brak. ;
  52:  F[748:ACK_SYNC]=(F[567:RxLaczSyncReq]) ;
  53:  ! F[749] - W biezacej wymianie ;
  54:  ! odebrano zadanie SYNC PLC. ON ;
  55:  ! opisany ;
  56:  ! warunek/zadanie, OFF brak. ;
  57:  IF (F[567:RxLaczSyncReq]),F[749:SYNCPLCbyl]=(ON) ;
  58:  ! F[566] - Snapshot odebrany ;
  59:  ! przez PLC_RX. 1: potwierdzenie ;
  60:  ! zadania ;
  61:  ! synchronizacji partnera, 0: ;
  62:  ! brak potwierdzenia. Kierunek: ;
  63:  ! PLC do robota. ;
  64:  ! R[140] - Czas rozpoczecia ;
  65:  ! synchronizacji [ticki]. ;
  66:  ! R[129] - Biezacy czas ;
  67:  ! watchdogow [surowe ticki], ;
  68:  ! czestotliwosc do pomiaru. ;
  69:  IF ((R[126:StanLacza]=0) AND !F[566:RxLaczSyncACK]),R[140:SYNCod_t]=(R[129:CzasTeraz_t]) ;
  70:  IF ((R[126:StanLacza]=0) AND !F[566:RxLaczSyncACK]),R[126:StanLacza]=(10) ;
  71:  ! F[747] - Robot zada ;
  72:  ! synchronizacji, OFF zadanie ;
  73:  ! wygaszone. ON opisany ;
  74:  ! warunek/zadanie, OFF brak. ;
  75:  F[747:ZadSYNC]=(R[126:StanLacza]=10) ;
  76:  IF ((R[126:StanLacza]=10) AND F[566:RxLaczSyncACK]),R[126:StanLacza]=(20) ;
  77:  F[747:ZadSYNC]=(R[126:StanLacza]=10) ;
  78:  IF ((R[126:StanLacza]=20) AND F[749:SYNCPLCbyl] AND !F[567:RxLaczSyncReq] AND !F[566:RxLaczSyncACK]),R[126:StanLacza]=(30) ;
  79:  ! F[755] - Wszystkie kanaly ;
  80:  ! zdarzen i przedmuchow maja ;
  81:  ! ACK=0. ON opisany ;
  82:  ! warunek/zadanie, OFF brak. ;
  83:  F[755:ACK_wszyst0]=(ON) ;
  84:  ! F[541] - Snapshot odebrany ;
  85:  ! przez PLC_RX. 1: zdarzenie ;
  86:  ! blisterPicked ;
  87:  ! zarejestrowane dokladnie raz w ;
  88:  ! biezacej sesji, 0: kanal wolny ;
  89:  ! po req=0. ;
  90:  ! Kierunek: PLC do robota. ;
  91:  F[755:ACK_wszyst0]=(F[755:ACK_wszyst0] AND !F[541:RxPobrTaACK]) ;
  92:  ! F[542] - Snapshot odebrany ;
  93:  ! przez PLC_RX. 1: zdarzenie ;
  94:  ! blisterPlaced ;
  95:  ! zarejestrowane dokladnie raz w ;
  96:  ! biezacej sesji, 0: kanal wolny ;
  97:  ! po req=0. ;
  98:  ! Kierunek: PLC do robota. ;
  99:  F[755:ACK_wszyst0]=(F[755:ACK_wszyst0] AND !F[542:RxOdlTacACK]) ;
 100:  ! F[540] - Snapshot odebrany ;
 101:  ! przez PLC_RX. 1: ukonczenie ;
 102:  ! pojedynczego blistra ;
 103:  ! zarejestrowane raz. Kierunek: ;
 104:  ! PLC do robota. ;
 105:  F[755:ACK_wszyst0]=(F[755:ACK_wszyst0] AND !F[540:RxPelTacACK]) ;
 106:  ! F[547] - Snapshot odebrany ;
 107:  ! przez PLC_RX. 1: zdarzenie ;
 108:  ! spacerPlaced ;
 109:  ! zarejestrowane dokladnie raz w ;
 110:  ! biezacej sesji, 0: kanal wolny ;
 111:  ! po req=0. ;
 112:  ! Kierunek: PLC do robota. ;
 113:  F[755:ACK_wszyst0]=(F[755:ACK_wszyst0] AND !F[547:RxPrzeklACK]) ;
 114:  ! F[545] - Snapshot odebrany ;
 115:  ! przez PLC_RX. 1: zdarzenie ;
 116:  ! productsPlaced ;
 117:  ! zarejestrowane dokladnie raz w ;
 118:  ! biezacej sesji, 0: kanal wolny ;
 119:  ! po req=0. ;
 120:  ! Kierunek: PLC do robota. ;
 121:  F[755:ACK_wszyst0]=(F[755:ACK_wszyst0] AND !F[545:RxDobreACK]) ;
 122:  ! F[546] - Snapshot odebrany ;
 123:  ! przez PLC_RX. 1: zdarzenie ;
 124:  ! samplesPlaced ;
 125:  ! zarejestrowane dokladnie raz w ;
 126:  ! biezacej sesji, 0: kanal wolny ;
 127:  ! po req=0. ;
 128:  ! Kierunek: PLC do robota. ;
 129:  F[755:ACK_wszyst0]=(F[755:ACK_wszyst0] AND !F[546:RxProbkiACK]) ;
 130:  ! F[544] - Snapshot odebrany ;
 131:  ! przez PLC_RX. 1: zdarzenie ;
 132:  ! layerFinished ;
 133:  ! zarejestrowane dokladnie raz w ;
 134:  ! biezacej sesji, 0: kanal wolny ;
 135:  ! po req=0. ;
 136:  ! Kierunek: PLC do robota. ;
 137:  F[755:ACK_wszyst0]=(F[755:ACK_wszyst0] AND !F[544:RxWarstwACK]) ;
 138:  ! F[548] - Snapshot odebrany ;
 139:  ! przez PLC_RX. 1: zdarzenie ;
 140:  ! stackFinished ;
 141:  ! zarejestrowane dokladnie raz w ;
 142:  ! biezacej sesji, 0: kanal wolny ;
 143:  ! po req=0. ;
 144:  ! Kierunek: PLC do robota. ;
 145:  F[755:ACK_wszyst0]=(F[755:ACK_wszyst0] AND !F[548:RxPelLadACK]) ;
 146:  ! F[543] - Snapshot odebrany ;
 147:  ! przez PLC_RX. 1: zdarzenie ;
 148:  ! immPickupCompleted ;
 149:  ! zarejestrowane dokladnie raz w ;
 150:  ! biezacej sesji, 0: kanal wolny ;
 151:  ! po req=0. ;
 152:  ! Kierunek: PLC do robota. ;
 153:  F[755:ACK_wszyst0]=(F[755:ACK_wszyst0] AND !F[543:RxPobrIMACK]) ;
 154:  ! F[607] - Snapshot odebrany ;
 155:  ! przez PLC_RX. Odrzut ;
 156:  ! zarejestrowany raz dla ;
 157:  ! biezacego REQ, utrzymac ACK do ;
 158:  ! REQ=0. Kierunek: PLC do ;
 159:  ! robota. ;
 160:  F[755:ACK_wszyst0]=(F[755:ACK_wszyst0] AND !F[607:RxOdrzutACK]) ;
 161:  ! F[578] - Snapshot odebrany ;
 162:  ! przez PLC_RX. 1: terminalny ;
 163:  ! wynik przedmuchu ;
 164:  ! dostepny, trzymany do ;
 165:  ! blowReq=0. Kierunek: PLC do ;
 166:  ! robota. ;
 167:  F[755:ACK_wszyst0]=(F[755:ACK_wszyst0] AND !F[578:RxVac1DmACK]) ;
 168:  ! F[584] - Snapshot odebrany ;
 169:  ! przez PLC_RX. 1: terminalny ;
 170:  ! wynik przedmuchu ;
 171:  ! dostepny, trzymany do ;
 172:  ! blowReq=0. Kierunek: PLC do ;
 173:  ! robota. ;
 174:  F[755:ACK_wszyst0]=(F[755:ACK_wszyst0] AND !F[584:RxVac2DmACK]) ;
 175:  ! F[590] - Snapshot odebrany ;
 176:  ! przez PLC_RX. 1: terminalny ;
 177:  ! wynik przedmuchu ;
 178:  ! dostepny, trzymany do ;
 179:  ! blowReq=0. Kierunek: PLC do ;
 180:  ! robota. ;
 181:  F[755:ACK_wszyst0]=(F[755:ACK_wszyst0] AND !F[590:RxVac3DmACK]) ;
 182:  ! F[596] - Snapshot odebrany ;
 183:  ! przez PLC_RX. 1: terminalny ;
 184:  ! wynik przedmuchu ;
 185:  ! dostepny, trzymany do ;
 186:  ! blowReq=0. Kierunek: PLC do ;
 187:  ! robota. ;
 188:  F[755:ACK_wszyst0]=(F[755:ACK_wszyst0] AND !F[596:RxVac4DmACK]) ;
 189:  ! F[602] - Snapshot odebrany ;
 190:  ! przez PLC_RX. 1: terminalny ;
 191:  ! wynik przedmuchu ;
 192:  ! dostepny, trzymany do ;
 193:  ! blowReq=0. Kierunek: PLC do ;
 194:  ! robota. ;
 195:  F[755:ACK_wszyst0]=(F[755:ACK_wszyst0] AND !F[602:RxVac5DmACK]) ;
 196:  ! F[740] - Jednorazowe zadanie ;
 197:  ! jawnego recovery lacza, ;
 198:  ! konsumowane przez ;
 199:  ! PLC_LINK. ON opisany ;
 200:  ! warunek/zadanie, OFF brak. ;
 201:  ! F[573] - Snapshot odebrany ;
 202:  ! przez PLC_RX. 1: wymagane ;
 203:  ! uzgodnienie stanu, 0: ;
 204:  ! uzgodniony stan. Kierunek: PLC ;
 205:  ! do robota. ;
 206:  ! F[568] - Snapshot odebrany ;
 207:  ! przez PLC_RX. 1: blokada ;
 208:  ! krytyczna, 0: brak ;
 209:  ! zgloszonej blokady. Nie jest ;
 210:  ! sygnalem safety. Kierunek: PLC ;
 211:  ! do robota. ;
 212:  ! F[576] - Snapshot odebrany ;
 213:  ! przez PLC_RX. 1: jednorazowe ;
 214:  ! zadanie odlozenia ;
 215:  ! probek, 0: zwolnienie kanalu ;
 216:  ! po ACK. Kierunek: PLC do ;
 217:  ! robota. ;
 218:  IF ((R[126:StanLacza]=30) AND F[740:ZadRecLacza] AND !F[573:RxProdRecovery] AND !F[568:RxProdKrytBlok] AND F[755:ACK_wszyst0] AND !F[576:RxProbkiReq]),R[126:StanLacza]=(40) ;
 219:  F[740:ZadRecLacza]=(OFF) ;
 220:  ! R[139] - Limit synchronizacji ;
 221:  ! lacza [ticki]. ;
 222:  ! R[141] - Kod: 0 brak, 902 ;
 223:  ! timeout SYNC, 905 zajety ;
 224:  ! kanal, 906 bledny wynik ;
 225:  ! przedmuchu. ;
 226:  IF (((R[126:StanLacza]=10) OR (R[126:StanLacza]=20)) AND (R[129:CzasTeraz_t]-R[140:SYNCod_t]>R[139:SYNCmax_t])),R[141:BladLacza]=(902) ;
 227:  IF (((R[126:StanLacza]=10) OR (R[126:StanLacza]=20)) AND (R[129:CzasTeraz_t]-R[140:SYNCod_t]>R[139:SYNCmax_t])),CALL PLC_LOST ;
 228:  ! F[746] - Robot zakonczyl ;
 229:  ! recovery lacza i ma wazne ;
 230:  ! monitory. ON opisany ;
 231:  ! warunek/zadanie, OFF brak. ;
 232:  F[746:RobotGotow]=((R[126:StanLacza]=40) AND F[743:WatchdogOK] AND !F[751:BladProto] AND !F[759:BlokadaBG]) ;
 233:  ! F[745] - Obustronna ;
 234:  ! synchronizacja i gotowosc sa ;
 235:  ! aktualne, OFF brak waznych ;
 236:  ! komend. ON opisany ;
 237:  ! warunek/zadanie, OFF brak. ;
 238:  F[745:SesjaWazna]=(F[746:RobotGotow] AND F[565:RxLaczGot] AND !F[567:RxLaczSyncReq] AND !F[566:RxLaczSyncACK]) ;
 239:  IF (F[745:SesjaWazna]),F[750:SesjaByla]=(ON) ;
 240:  LBL[90] ;
 241:  ! F[739] - Main uzbroil proces, ;
 242:  ! OFF robot nie moze wydawac ;
 243:  ! komend ;
 244:  ! wykonawczych. ON opisany ;
 245:  ! warunek/zadanie, OFF brak. ;
 246:  IF (!F[745:SesjaWazna] OR F[568:RxProdKrytBlok] OR F[573:RxProdRecovery] OR F[759:BlokadaBG]),F[739:ProcesUzbr]=(OFF) ;
/POS
/END
