/PROG PLC_AREA
/ATTR
OWNER = MNEDITOR;
COMMENT = "Dostep obszarow";
PROTECT = READ_WRITE;
DEFAULT_GROUP = *,*,*,*,*;
CONTROL_CODE = 00000000 00000000;
/MN
   1:  ! Rezerwacje obszarow ;
   2:  ! Robot zada - PLC wykonuje ;
   3:  ! Festo i EUROMAP ;
   4:  ! F[672] - Bufor wyjscia po ;
   5:  ! walidacji. 1: robot zada ;
   6:  ! dostepu, 0: zwalnia ;
   7:  ! zadanie po opuszczeniu ;
   8:  ! obszaru. Kierunek: Robot do ;
   9:  ! PLC. ;
  10:  ! F[608] - Lokalne zadanie lub ;
  11:  ! status aplikacji. 1: robot ;
  12:  ! zada dostepu, 0: ;
  13:  ! zwalnia zadanie po opuszczeniu ;
  14:  ! obszaru. Kierunek: Robot do ;
  15:  ! PLC. ;
  16:  ! F[745] - Obustronna ;
  17:  ! synchronizacja i gotowosc sa ;
  18:  ! aktualne, OFF brak waznych ;
  19:  ! komend. ON opisany ;
  20:  ! warunek/zadanie, OFF brak. ;
  21:  F[672:TxWindWejReq]=(F[608:CmdWindWejReq] AND F[745:SesjaWazna]) ;
  22:  ! F[673] - Bufor wyjscia po ;
  23:  ! walidacji. 1: robot faktycznie ;
  24:  ! poza obszarem i nie ;
  25:  ! planuje wejscia bez nowego ;
  26:  ! przyznania, 0: brak ;
  27:  ! zwolnienia. Nie jest safety. ;
  28:  ! Kierunek: Robot do PLC. ;
  29:  ! F[609] - Lokalne zadanie lub ;
  30:  ! status aplikacji. 1: robot ;
  31:  ! faktycznie poza ;
  32:  ! obszarem i nie planuje wejscia ;
  33:  ! bez nowego przyznania, 0: brak ;
  34:  ! zwolnienia. ;
  35:  ! Nie jest safety. Kierunek: ;
  36:  ! Robot do PLC. ;
  37:  F[673:TxWindPoza]=(F[609:CmdWindPoza] AND F[745:SesjaWazna]) ;
  38:  ! F[674] - Bufor wyjscia po ;
  39:  ! walidacji. 1: robot zada ;
  40:  ! dostepu, 0: zwalnia ;
  41:  ! zadanie po opuszczeniu ;
  42:  ! obszaru. Kierunek: Robot do ;
  43:  ! PLC. ;
  44:  ! F[610] - Lokalne zadanie lub ;
  45:  ! status aplikacji. 1: robot ;
  46:  ! zada dostepu, 0: ;
  47:  ! zwalnia zadanie po opuszczeniu ;
  48:  ! obszaru. Kierunek: Robot do ;
  49:  ! PLC. ;
  50:  F[674:TxZrodWejReq]=(F[610:CmdZrodWejReq] AND F[745:SesjaWazna]) ;
  51:  ! F[675] - Bufor wyjscia po ;
  52:  ! walidacji. 1: robot faktycznie ;
  53:  ! poza obszarem i nie ;
  54:  ! planuje wejscia bez nowego ;
  55:  ! przyznania, 0: brak ;
  56:  ! zwolnienia. Nie jest safety. ;
  57:  ! Kierunek: Robot do PLC. ;
  58:  ! F[611] - Lokalne zadanie lub ;
  59:  ! status aplikacji. 1: robot ;
  60:  ! faktycznie poza ;
  61:  ! obszarem i nie planuje wejscia ;
  62:  ! bez nowego przyznania, 0: brak ;
  63:  ! zwolnienia. ;
  64:  ! Nie jest safety. Kierunek: ;
  65:  ! Robot do PLC. ;
  66:  F[675:TxZrodPoza]=(F[611:CmdZrodPoza] AND F[745:SesjaWazna]) ;
  67:  ! F[676] - Bufor wyjscia po ;
  68:  ! walidacji. 1: robot zada ;
  69:  ! dostepu, 0: zwalnia ;
  70:  ! zadanie po opuszczeniu ;
  71:  ! obszaru. Kierunek: Robot do ;
  72:  ! PLC. ;
  73:  ! F[612] - Lokalne zadanie lub ;
  74:  ! status aplikacji. 1: robot ;
  75:  ! zada dostepu, 0: ;
  76:  ! zwalnia zadanie po opuszczeniu ;
  77:  ! obszaru. Kierunek: Robot do ;
  78:  ! PLC. ;
  79:  F[676:TxMagWejReq]=(F[612:CmdMagWejReq] AND F[745:SesjaWazna]) ;
  80:  ! F[677] - Bufor wyjscia po ;
  81:  ! walidacji. 1: robot faktycznie ;
  82:  ! poza obszarem i nie ;
  83:  ! planuje wejscia bez nowego ;
  84:  ! przyznania, 0: brak ;
  85:  ! zwolnienia. Nie jest safety. ;
  86:  ! Kierunek: Robot do PLC. ;
  87:  ! F[613] - Lokalne zadanie lub ;
  88:  ! status aplikacji. 1: robot ;
  89:  ! faktycznie poza ;
  90:  ! obszarem i nie planuje wejscia ;
  91:  ! bez nowego przyznania, 0: brak ;
  92:  ! zwolnienia. ;
  93:  ! Nie jest safety. Kierunek: ;
  94:  ! Robot do PLC. ;
  95:  F[677:TxMagPoza]=(F[613:CmdMagPoza] AND F[745:SesjaWazna]) ;
/POS
/END
