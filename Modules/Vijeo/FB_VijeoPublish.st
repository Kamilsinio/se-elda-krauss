GVL_HMI.vijeo.elevatorSpeedActual.fastHz := Hmi.stationActual[2].fastHz;

(* Po Wczytaj aktualizuj tylko bufor wybrany przez sterownik. *)
IF ReloadedStation >= 1 AND ReloadedStation <= 3 THEN
    reloadedIndex := TO_INT(ReloadedStation);
    GVL_HMI.vijeo.stationEdit[reloadedIndex - 1].sensorStableMs := Hmi.stationEdit[reloadedIndex].sensorStableMs;
    GVL_HMI.vijeo.stationEdit[reloadedIndex - 1].stopDelayMs := Hmi.stationEdit[reloadedIndex].stopDelayMs;
    GVL_HMI.vijeo.stationEdit[reloadedIndex - 1].moveTimeoutMs := Hmi.stationEdit[reloadedIndex].moveTimeoutMs;
    GVL_HMI.vijeo.stationEdit[reloadedIndex - 1].actuatorTimeoutMs := Hmi.stationEdit[reloadedIndex].actuatorTimeoutMs;
    IF ReloadedStation = 2 THEN
        GVL_HMI.vijeo.elevatorSpeedEdit.slowHz := Hmi.stationEdit[2].slowHz;
        GVL_HMI.vijeo.elevatorSpeedEdit.fastHz := Hmi.stationEdit[2].fastHz;
    END_IF;
