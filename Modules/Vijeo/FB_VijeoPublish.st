    GVL_HMI.vijeo.storageEdit.sensorStableMs := Hmi.stationEdit[4].sensorStableMs;
    GVL_HMI.vijeo.storageEdit.actuatorTimeoutMs := Hmi.stationEdit[4].actuatorTimeoutMs;
