END_FOR;
GVL_HMI.vijeo.unloadCoils[0] := Io.appliedCoils[9];
GVL_HMI.vijeo.unloadCoils[1] := Io.appliedCoils[10];

FOR i := 1 TO 64 DO
    GVL_HMI.vijeo.alarms.entries[i - 1] := Io.alarms.entries[i];
END_FOR;
GVL_HMI.vijeo.alarms.critical := Io.alarms.critical;
GVL_HMI.vijeo.alarms.warning := Io.alarms.warning;
